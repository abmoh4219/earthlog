pitch":-88,"move":"flight"}],"pacing":[{"t":"2026-11-27T00:00:00Z","speed":1}],"beats":[{"t":"2026-11-27T00:00:00Z","text":"French far-left candidate Mélenchon demands ‘thorough overhaul’ of Germany ties, France 24 reports.","cites":["news:france24:ddc9a03fffd9"]},{"t":"2026-11-27T00:00:08Z","text":"The launch meeting of the Left Party was held on 29 November in Saint-Ouen, in the presence of Die Linke's co-chairman Oskar Lafontaine.","cites":["wiki:rev:1388264586:100"]},{"t":"2026-11-27T00:00:16Z","text":"Jean-Luc Antoine Pierre Mélenchon (born 19 August 1951) is a French left-wing politician who has been the de facto leader of La France Insoumise (LFI) since it was established in 2016.","cites":["wiki:rev:1388264586:0"]},{"t":"2026-11-27T00:00:24Z","text":"Jean-Luc Mélenchon was born on 19 August 1951 in Tangier.","cites":["wd:Q5829:P569","wd:Q5829:P19"]},{"t":"2026-11-27T00:00:32Z","text":"Educated at Lycée Regnault, Lycée Pierre-Corneille and Marie and Louis Pasteur University.","cites":["wd:Q5829:P69:Q3268901","wd:Q5829:P69:Q3268638","wd:Q5829:P69:Q829449"]},{"t":"2026-11-27T00:00:38Z","text":"Worked in Strasbourg, Brussels and Paris.","cites":["wd:Q5829:P937:Q6602","wd:Q5829:P937:Q239","wd:Q5829:P937:Q90"]},{"t":"2026-11-27T00:00:44Z","text":"One award on record: Grand Officer of the Order of May (1988).","cites":["wd:Q5829:P166:Q111537166"]},{"t":"2026-11-27T00:00:54Z","text":"28 November: Indian workers fill Germany's labor gaps but face hurdles and risks, DW reported.","cites":["news:dw:78ecce9504e7"]},{"t":"2026-11-27T00:01:01Z","text":"Lawmakers approve debt-laden 2027 budget, DW reports.","cites":["news:dw:c798e4fa7b92"]},{"t":"2026-11-27T00:01:08Z","text":"France seeks German man in Channel migrant boat probe, DW reports.","cites":["news:dw:841769bf9248"]},{"t":"2026-11-27T00:01:15Z","text":"The tiny BSW is a party in crisis, as it is set to hand the far-right AfD power in eastern Germany, DW reports.","cites":["news:dw:98b542aa0047"]},{"t":"2026-11-27T00:01:31Z","text":"France 24 headlined it: “French far-left candidate Mélenchon demands ‘thorough overhaul’ of Germany ties”","cites":["news:france24:ddc9a03fffd9"]},{"t":"2026-11-27T00:01:42Z","text":"Sources: France 24 and DW, Wikipedia articles, Wikimedia pageviews and Wikidata. Every caption links to the evidence it rests on.","cites":["wiki:rev:1388264586:100","views:en:Jean-Luc_Mélenchon:30d","wd:Q5829:P569"]}],"time":"story","spotlight":{"country":"DE","lon":9.68,"lat":50.96,"label":"Germany"},"chapters":[{"t":"2026-11-27T00:00:00Z","title":"What happened"},{"t":"2026-11-27T00:00:24Z","title":"Born"},{"t":"2026-11-27T00:00:32Z","title":"A life across the globe"},{"t":"2026-11-27T00:00:43Z","title":"Recognition"},{"t":"2026-11-27T00:00:53Z","title":"Lately in Germany"},{"t":"2026-11-27T00:01:21Z","title":"Connected"},{"t":"2026-11-27T00:01:30Z","title":"In the news"},{"t":"2026-11-27T00:01:41Z","title":"Sources"}],"panels":[{"id":"life","t":"2026-11-27T00:00:33Z","until":"2026-11-27T00:00:43Z","title":"A life on record","note":"As recorded in Wikidata (CC0). Organisations are placed at their home ground or headquarters.","kind":"facts","items":[{"label":"1951 born","text":"Tangier","cites":["wd:Q5829:P19"]},{"label":"educated at","text":"Lycée Regnault","cites":["wd:Q5829:P69:Q3268901"]},{"label":"educated at","text":"Lycée Pierre-Corneille","cites":["wd:Q5829:P69:Q3268638"]},{"label":"1969–72","text":"Marie and Louis Pasteur University","cites":["wd:Q5829:P69:Q829449"]},{"label":"worked in","text":"Strasbourg","cites":["wd:Q5829:P937:Q6602"]},{"label":"worked in","text":"Brussels","cites":["wd:Q5829:P937:Q239"]},{"label":"worked in","text":"Paris","cites":["wd:Q5829:P937:Q90"]}]},{"id":"recognition","t":"2026-11-27T00:00:44Z","until":"2026-11-27T00:00:53Z","title":"Recognition","note":"As recorded in Wikidata.","kind":"facts","items":[{"label":"1988","text":"Grand Officer of the Order of May","cites":["wd:Q5829:P166:Q111537166"]}]},{"id":"coverage","t":"2026-