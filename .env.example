# Copy to .env (gitignored). Keys are used ONLY by scripts/ on your machine,
# never by the website. Visitors never need any of these.

# Optional: Claude-written narration (`pnpm direct <event> --ai`). Haiku by default.
ANTHROPIC_API_KEY=

# Optional: NASA FIRMS fire / thermal-anomaly layer at bake time (free map key).
FIRMS_MAP_KEY=

# Optional: override the site URL (defaults to the value in src/config.ts).
# NEXT_PUBLIC_SITE_URL=https://earthlog.abdelah.dev
