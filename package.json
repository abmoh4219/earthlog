{
  "name": "earthlog",
  "version": "0.0.0",
  "private": true,
  "description": "The planet's black box: cinematic, evidence-cited replays of real world events on a 3D globe.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "cesium:assets": "node scripts/copy-cesium-assets.ts",
    "predev": "pnpm cesium:assets",
    "dev": "next dev",
    "build": "node scripts/copy-cesium-assets.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bake": "node scripts/bake.ts",
    "validate:scenes": "node scripts/validate-scenes.ts",
    "edition": "node scripts/edition.ts",
    "stories": "node scripts/stories.ts",
    "direct": "node scripts/direct.ts",
    "news": "node scripts/news.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "cesium": "^1.147.0",
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "mp4-muxer": "^5.2.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
