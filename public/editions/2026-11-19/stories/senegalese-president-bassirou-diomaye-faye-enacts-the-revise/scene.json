  "beats": [
    {
      "t": "2026-11-19T00:00:01Z",
      "text": "Senegalese president Bassirou Diomaye Faye has enacted the revised 2026 budget by decree after parliament rejected it, as he seeks to advance a proposed US$2.2 billion International Monetary Fund loan programme.",
      "cites": [
        "wiki:2026-11-19:12"
      ]
    },
    {
      "t": "2026-11-19T00:00:09Z",
      "text": "The loan programme is aimed at addressing the country's debt, and Senegal's developing economy is driven by mining, construction, tourism, fishing and agriculture.",
      "cites": [
        "wiki:2026-11-19:12",
        "wiki:rev:1378454253:0"
      ]
    },
    {
      "t": "2026-11-19T00:00:18Z",
      "text": "Inflation in Senegal fell to 1.5% in 2025, down from 9.7% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:SN"
      ]
    },
    {
      "t": "2026-11-19T00:00:26Z",
      "text": "The economy grew 6.7% in 2025, and unemployment stood at 2.7%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:SN",
        "wb:SL.UEM.TOTL.ZS:SN"
      ]
    },
    {
      "t": "2026-11-19T00:00:36Z",
      "text": "Across Sub-Saharan Africa, Senegal's 1.5% inflation compares with a median of 3.5%, while South Sudan recorded the highest rate at 91.4%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:sub-saharan-africa",
        "wb:FP.CPI.TOTL.ZG:SS"
      ]
    },
    {
      "t": "2026-11-19T00:00:50Z",
      "text": "The report was carried by AFP and published via France 24.",
      "cites": [
        "wiki:2026-11-19:12"
      ]
    },
    {
      "t": "2026-11-19T00:00:58Z",
