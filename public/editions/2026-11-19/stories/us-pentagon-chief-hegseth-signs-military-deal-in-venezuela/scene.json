  "beats": [
    {
      "t": "2026-11-19T00:00:01Z",
      "text": "Venezuela has signed a military deal with the US less than a year after Maduro's removal, according to BBC News.",
      "cites": [
        "news:bbc:d65a0674ce40"
      ]
    },
    {
      "t": "2026-11-19T00:00:08Z",
      "text": "On Veterans' Day, November 11, 2026, Hegseth and a group accompanying him posed for photographs in front of the Tomb of the Unknown Soldier, audibly chatting and laughing.",
      "cites": [
        "wiki:rev:1386539170:203"
      ]
    },
    {
      "t": "2026-11-19T00:00:15Z",
      "text": "Peter Brian Hegseth, born June 6, 1980, is an American politician, U.S. Army veteran, and former television personality who has served as the 29th United States secretary of defense since 2025.",
      "cites": [
        "wiki:rev:1386539170:0"
      ]
    },
    {
      "t": "2026-11-19T00:00:25Z",
      "text": "Pete Hegseth was born on 6 June 1980 in Minneapolis.",
      "cites": [
        "wd:Q7172014:P569",
        "wd:Q7172014:P19"
      ]
    },
    {
      "t": "2026-11-19T00:00:33Z",
      "text": "He was educated at Forest Lake Area High School, Princeton University and the John F. Kennedy School of Government.",
      "cites": [
        "wd:Q7172014:P69:Q5469002",
        "wd:Q7172014:P69:Q21578",
        "wd:Q7172014:P69:Q49127"
      ]
    },
    {
      "t": "2026-11-19T00:00:38Z",
      "text": "He later worked for Fox News, in Arlington County.",
      "cites": [
        "wd:Q7172014:P108:Q186068",
        "wd:Q7172014:P937:Q107126"
      ]
    },
    {
      "t": "2026-11-19T00:00:44Z",
      "text": "Records list 14 awards, among them the Bronze Star Medal and the Joint Service Commendation Medal.",
      "cites": [
        "wd:Q7172014:P166:Q928314",
        "wd:Q7172014:P166:Q15821622"
      ]
    },
    {
      "t": "2026-11-19T00:00:50Z",
      "text": "He is known for the books American Crusade and The War on Warriors.",
      "cites": [
        "wd:Q7172014:P800:Q131459708",
        "wd:Q7172014:P800:Q131926991"
      ]
    },
    {
      "t": "2026-11-19T00:01:07Z",
      "text": "Al Jazeera headlined its report, “Why is Pete Hegseth strengthening US military ties with Venezuela?”",
      "cites": [
        "news:aljazeera:12fd432b51bf"
      ]
    },
    {
      "t": "2026-11-19T00:01:14Z",
      "text": "BBC News headlined its report, “Venezuela signs military deal with US less than a year after Maduro's removal”.",
      "cites": [
        "news:bbc:d65a0674ce40"
      ]
    },
