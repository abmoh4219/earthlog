  "beats": [
    {
      "t": "2026-11-19T00:00:01Z",
      "text": "Haiti police say at least 34 suspected gang members were killed in a raid, according to Al Jazeera.",
      "cites": [
        "news:aljazeera:d93b1fe41da9"
      ]
    },
    {
      "t": "2026-11-19T00:00:09Z",
      "text": "France 24 also reported the story, describing it as a major anti-gang offensive.",
      "cites": [
        "news:france24:26a4355e6e18"
      ]
    },
    {
      "t": "2026-11-19T00:00:18Z",
      "text": "Inflation in Haiti fell to 28.6% in 2025, from 36.8% in 2023.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:HT"
      ]
    },
    {
      "t": "2026-11-19T00:00:26Z",
      "text": "The economy shrank by 2.7% in 2025, and unemployment stood at 14.9%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:HT",
        "wb:SL.UEM.TOTL.ZS:HT"
      ]
    },
    {
      "t": "2026-11-19T00:00:36Z",
      "text": "Across Latin America and the Caribbean, Haiti's 28.6% compares with a median of 3.8%, while Argentina is highest at 219.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:latin-america-caribbean"
      ]
    },
    {
      "t": "2026-11-19T00:00:50Z",
      "text": "On 12 November, Haitian and Salvadoran soldiers took control of the Stade Sylvio Cator in Port-au-Prince after two years of gang control.",
      "cites": [
        "wiki:2026-11-12:1"
      ]
    },
    {
      "t": "2026-11-19T00:00:57Z",
      "text": "On 17 November, hundreds of Haitians marched in cities across Haiti to show support for the deployment of Salvadoran troops against gang violence.",
      "cites": [
        "wiki:2026-11-17:20"
      ]
    },
    {
      "t": "2026-11-19T00:01:04Z",
      "text": "On 18 November, Salvadoran forces destroyed a house belonging to Jeff Larose, leader of the Taliban gang that operates in Canaan. The Gang Suppression Force says it was not involved.",
      "cites": [
        "wiki:2026-11-18:2"
      ]
    },
    {
      "t": "2026-11-19T00:01:12Z",
      "text": "Haiti, officially the Republic of Haiti, is a Caribbean country on the island of Hispaniola, east of Cuba and Jamaica and south of The Bahamas.",
      "cites": [
        "wiki:rev:1386270195:0"
      ]
    },
    {
      "t": "2026-11-19T00:01:23Z",
      "text": "Al Jazeera headlined the story: Haiti police say at least 34 suspected gang members killed in raid.",
      "cites": [
        "news:aljazeera:d93b1fe41da9"
      ]
    },
    {
      "t": "2026-11-19T00:01:30Z",
      "text": "France 24 headlined its version: Major anti-gang offensive in Haiti kills 34 suspected gang members.",
      "cites": [
        "news:france24:26a4355e6e18"
      ]
    },
    {
      "t": "2026-11-19T00:01:39Z",
      "text": "This explainer draws on two news outlets, Wikipedia articles from 12 and 17 November 2026 and the 2 related pages, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:rev:1386270195:0",
        "views:en:Haiti:30d",
        "wd:Q790:P571",
        "wiki:2026-11-12:1",
        "wiki:2026-11-17:20"
      ]
    }
  ],
