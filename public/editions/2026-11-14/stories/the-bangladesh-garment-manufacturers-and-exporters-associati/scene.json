  "beats": [
    {
      "t": "2026-11-14T00:00:01Z",
      "text": "The Bangladesh Garment Manufacturers and Exporters Association has threatened to indefinitely close unrest-affected factories without pay, under the Bangladesh Labour Act 2006.",
      "cites": [
        "wiki:2026-11-14:4"
      ]
    },
    {
      "t": "2026-11-14T00:00:08Z",
      "text": "On 12 November, after seven factories in Kaliakair Upazila declared holidays, workers blocked the Dhaka–Tangail highway in the Mouchak area, keeping their demands for the ৳30,000 minimum wage.",
      "cites": [
        "wiki:rev:1385814948:61"
      ]
    },
    {
      "t": "2026-11-14T00:00:15Z",
      "text": "The 2026 protests are labour demonstrations by ready-made garment workers in Bangladesh, demanding a rise in the sector's minimum monthly wage from ৳12,500 to ৳30,000.",
      "cites": [
        "wiki:rev:1385814948:0"
      ]
    },
    {
      "t": "2026-11-14T00:00:25Z",
      "text": "Inflation in Bangladesh eased to 8.8% in 2025, down from 10.5% in 2024.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:BD"
      ]
    },
    {
      "t": "2026-11-14T00:00:33Z",
      "text": "The economy grew 3.5% in 2025, and unemployment stood at 3.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:BD",
        "wb:SL.UEM.TOTL.ZS:BD"
      ]
    },
    {
      "t": "2026-11-14T00:00:43Z",
      "text": "Across South Asia, Bangladesh's 8.8% inflation compares with a median of 2.7%, and is the highest figure in the region.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:south-asia"
      ]
    },
    {
      "t": "2026-11-14T00:00:57Z",
      "text": "On 11 November, at least 50 garment factories shut down in Savar and Ashulia, while police used tear gas and stun grenades to disperse striking workers blocking roads.",
      "cites": [
        "wiki:2026-11-11:6"
      ]
    },
    {
      "t": "2026-11-14T00:01:04Z",
      "text": "On 12 November, over 200 garment factories shut down as workers blocked the Dhaka–Tangail Highway in Gazipur, and police fired stun grenades at the protesting workers.",
      "cites": [
        "wiki:2026-11-12:6"
      ]
    },
    {
      "t": "2026-11-14T00:01:13Z",
      "text": "The story was reported by AFP, via The Straits Times and The Business Standard.",
      "cites": [
        "wiki:2026-11-14:4"
      ]
    },
    {
      "t": "2026-11-14T00:01:21Z",
      "text": "Sources include Wikipedia current events for 2026 November 11, Wikipedia articles, Wikimedia pageviews, and Wikidata.",
      "cites": [
        "wiki:2026-11-11:6",
        "wiki:rev:1385814948:61",
        "views:en:2026_Bangladesh_garment_workers_protests:30d",
