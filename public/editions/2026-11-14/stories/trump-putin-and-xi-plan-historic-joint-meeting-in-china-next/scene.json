      ]
    },
    {
      "t": "2026-11-14T00:00:15Z",
      "text": "The White House is the official residence and workplace of the president of the United States.",
      "cites": [
        "wiki:rev:1385281895:0"
      ]
    },
    {
      "t": "2026-11-14T00:00:33Z",
      "text": "Wikidata lists the White House in the Northwest, and records its founding in 1800.",
