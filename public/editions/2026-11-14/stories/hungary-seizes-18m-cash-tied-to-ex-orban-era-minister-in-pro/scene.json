  "beats": [
    {
      "t": "2026-11-14T00:00:01Z",
      "text": "Hungary has seized $18m in cash tied to a former minister from the Orbán era, as part of a probe.",
      "cites": [
        "news:aljazeera:68fa57495838"
      ]
    },
    {
      "t": "2026-11-14T00:00:09Z",
      "text": "Coverage from DW and BBC News reports the same case, with DW describing millions in hidden cash and BBC News citing $20m.",
      "cites": [
        "news:dw:46c1c05194eb",
        "news:bbc:412d1643733c"
      ]
    },
    {
      "t": "2026-11-14T00:00:18Z",
      "text": "Inflation in Hungary fell to 4.4% in 2025, from 17.1% in 2023.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:HU"
      ]
    },
    {
      "t": "2026-11-14T00:00:26Z",
      "text": "The economy grew 0.5% in 2025, and unemployment stood at 4.5%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:HU",
        "wb:SL.UEM.TOTL.ZS:HU"
      ]
    },
    {
      "t": "2026-11-14T00:00:36Z",
      "text": "Across Europe and Central Asia, Hungary's 4.4% inflation compares with a median of 3.8%, while Turkey is highest at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-14T00:00:50Z",
      "text": "Hungary is a landlocked country in Central Europe.",
      "cites": [
        "wiki:rev:1385113512:0"
      ]
    },
    {
      "t": "2026-11-14T00:01:01Z",
      "text": "Al Jazeera headlined the story: “Hungary seizes $18m cash tied to ex-Orban-era minister in probe”.",
      "cites": [
        "news:aljazeera:68fa57495838"
      ]
    },
    {
      "t": "2026-11-14T00:01:07Z",
      "text": "DW headlined it: “Hungary: Millions in hidden cash found in Orban graft probe”.",
      "cites": [
        "news:dw:46c1c05194eb"
      ]
    },
    {
      "t": "2026-11-14T00:01:13Z",
      "text": "BBC News headlined it: “Hungarian authorities uncover $20m during probe of Orbán-era minister”.",
      "cites": [
        "news:bbc:412d1643733c"
      ]
    },
    {
      "t": "2026-11-14T00:01:22Z",
