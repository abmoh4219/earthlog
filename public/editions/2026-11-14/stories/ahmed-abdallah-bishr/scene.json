  "beats": [
    {
      "t": "2026-11-14T00:00:01Z",
      "text": "Ahmed Abdallah Bishr, general chief of staff for the Gathering of Sudan Liberation Forces (GSLF), has died of wounds he suffered a month earlier.",
      "cites": [
        "wiki:2026-11-14:1"
      ]
    },
    {
      "t": "2026-11-14T00:00:05Z",
      "text": "He was wounded in an assassination attack by drone strike against his home in Nyala.",
      "cites": [
        "wiki:2026-11-14:1"
      ]
    },
    {
      "t": "2026-11-14T00:00:11Z",
      "text": "The attack took place in Nyala, in South Darfur, Sudan.",
      "cites": [
        "wiki:2026-11-14:1"
      ]
    },
    {
      "t": "2026-11-14T00:00:19Z",
      "text": "South Darfur is also named in the reports of the event.",
      "cites": [
        "wiki:2026-11-14:1"
      ]
    },
    {
      "t": "2026-11-14T00:00:28Z",
      "text": "The story was reported by Sudan Tribune.",
      "cites": [
        "wiki:2026-11-14:1"
      ]
    },
    {
