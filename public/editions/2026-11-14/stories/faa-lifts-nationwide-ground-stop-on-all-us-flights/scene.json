    {
      "t": "2026-11-14T00:00:09Z",
      "text": "Donald John Trump, born June 14, 1946, is an American politician, media personality, and businessman who serves as the 47th president of the United States.",
      "cites": [
        "wiki:rev:1385806215:0"
      ]
    },
    {
      "t": "2026-11-14T00:00:18Z",
      "text": "Donald Trump was born on 14 June 1946 at Jamaica Hospital Medical Center.",
      "cites": [
        "wd:Q22686:P569",
        "wd:Q22686:P19"
      ]
    },
    {
      "t": "2026-11-14T00:00:26Z",
      "text": "He was educated at The Kew-Forest School, the University of Pennsylvania, New York Military Academy and 2 more institutions.",
      "cites": [
        "wd:Q22686:P69:Q7744153",
