  "beats": [
    {
      "t": "2026-11-22T00:00:01Z",
      "text": "Jackson died in Cincinnati on November 20, 2026, at the age of 75.",
      "cites": [
        "wiki:rev:1387268415:45"
      ]
    },
    {
      "t": "2026-11-22T00:00:08Z",
      "text": "He spent his entire National Football League (NFL) career as a linebacker for the Denver Broncos, from 1973 to 1986.",
      "cites": [
        "wiki:rev:1387268415:1"
      ]
    },
    {
      "t": "2026-11-22T00:00:15Z",
      "text": "Thomas Louie Jackson, also known as \"TJ\" or \"Tommy\", was born on April 4, 1951, and worked as an American football player and sports broadcaster and analyst.",
      "cites": [
        "wiki:rev:1387268415:0"
      ]
    },
    {
      "t": "2026-11-22T00:00:25Z",
      "text": "Jackson was born on 4 April 1951 in Cleveland.",
      "cites": [
        "wd:Q7816304:P569",
        "wd:Q7816304:P19"
      ]
    },
    {
      "t": "2026-11-22T00:00:33Z",
      "text": "He was educated at John Adams High School.",
      "cites": [
        "wd:Q7816304:P69:Q6218206"
      ]
    },
    {
      "t": "2026-11-22T00:00:43Z",
      "text": "Readers also turned to the article on John Madden, which drew 76,290 readers.",
      "cites": [
        "views:en:John_Madden:2026-11-22"
      ]
    },
    {
      "t": "2026-11-22T00:00:52Z",
