  "beats": [
    {
      "t": "2026-11-22T00:00:01Z",
      "text": "France 24 reports that Bahrain accuses Iran of striking an industrial site, as tankers were hit in the Strait of Hormuz.",
      "cites": [
        "news:france24:f69cfc8e9d39"
      ]
    },
    {
      "t": "2026-11-22T00:00:08Z",
      "text": "Bahrain reported that an Iranian strike caused a fire at a civilian industrial facility on 21 November, with no casualties.",
      "cites": [
        "wiki:rev:1387094305:438"
      ]
    },
    {
      "t": "2026-11-22T00:00:15Z",
      "text": "The United States and Israel have been at war with Iran and its regional allies since 28 February 2026, following the Twelve-Day War in June 2025.",
      "cites": [
        "wiki:rev:1387094305:0"
      ]
    },
    {
      "t": "2026-11-22T00:00:33Z",
      "text": "On 16 November, the Panamanian-flagged liquefied petroleum gas tanker MT Tara Gas was hit and set on fire in the Strait of Hormuz off Khasab, Oman.",
      "cites": [
        "wiki:week:1387094305:436"
      ]
    },
    {
      "t": "2026-11-22T00:00:42Z",
      "text": "On 17 November, the IRGC conducted a third drone attack on a US radar in Bahrain, retaliating for alleged US airspace violations and ending a two-month lull in strikes on Persian Gulf targets.",
      "cites": [
        "wiki:week:1387094305:438"
      ]
    },
    {
      "t": "2026-11-22T00:00:51Z",
      "text": "On 18 November, Kuwaiti air defenses intercepted drones, while Hung Cao told a Senate hearing on November 18, 2026 that the US had used expired Tomahawk missiles amid an ammunition shortage.",
      "cites": [
        "wiki:week:1387094305:441",
        "wiki:week:1387094305:506"
      ]
    },
    {
      "t": "2026-11-22T00:01:11Z",
      "text": "France 24 headlined it: “Bahrain accuses Iran of striking industrial site as tankers hit in Hormuz”",
      "cites": [
        "news:france24:f69cfc8e9d39"
      ]
    },
    {
      "t": "2026-11-22T00:01:17Z",
      "text": "The Guardian headlined it: “Briton swims length of strait of Hormuz to highlight environmental cost of war”",
      "cites": [
        "news:guardian:d72b3ea8eace"
      ]
    },
    {
      "t": "2026-11-22T00:01:23Z",
      "text": "Al Jazeera headlined it: “Iran war live: Tankers set ablaze in Hormuz as IRGC warns of unrest threat”",
      "cites": [
        "news:aljazeera:e7410a0ba3d6"
      ]
    },
    {
      "t": "2026-11-22T00:01:32Z",
      "text": "Sources include France 24, The Guardian and Al Jazeera, Wikipedia articles, Wikimedia pageviews and Wikidata, and every caption links to the evidence it rests on.",
      "cites": [
