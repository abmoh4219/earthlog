  "beats": [
    {
      "t": "2026-11-22T00:00:01Z",
      "text": "According to the report, several people were killed and at least 10 were injured when a Ukrainian naval drone struck the Russian corvette Merkury while it was docked at the port of Benghazi, Libya.",
      "cites": [
        "wiki:2026-11-22:2"
      ]
    },
    {
      "t": "2026-11-22T00:00:08Z",
      "text": "The ship was left mostly submerged after an explosion and fire while anchored in Benghazi on 22 November 2026.",
      "cites": [
        "wiki:rev:1387285107:1"
      ]
    },
    {
      "t": "2026-11-22T00:00:15Z",
      "text": "Before 2021, the corvette was known as Retivy (Ретивый).",
      "cites": [
        "wiki:rev:1387285107:0"
      ]
    },
    {
      "t": "2026-11-22T00:00:25Z",
      "text": "Benghazi, Libya, is where the reports place the ship.",
      "cites": [
        "wiki:2026-11-22:2"
      ]
    },
    {
      "t": "2026-11-22T00:00:33Z",
      "text": "On 22 November 2026, 61,753 people read the English Wikipedia article, while normally only a median of 17 read it per day.",
      "cites": [
        "views:en:Russian_corvette_Merkury:2026-11-22",
        "views:en:Russian_corvette_Merkury:prior"
      ]
    },
    {
      "t": "2026-11-22T00:00:40Z",
