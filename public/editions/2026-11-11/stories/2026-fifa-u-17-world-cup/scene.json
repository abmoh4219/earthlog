    {
      "t": "2026-11-11T00:00:01Z",
      "text": "The United States men's national under-17 soccer team has withdrawn from the upcoming FIFA U-17 World Cup in Qatar, citing safety concerns related to the Houthi–Saudi conflict.",
      "cites": [
        "wiki:2026-11-11:29"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "According to the article, the United States withdrew on 11 November 2026, citing security concerns.",
      "cites": [
        "wiki:rev:1385611092:22"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "The 2026 FIFA U-17 World Cup will be the 21st edition of the annual international men's youth football tournament for under-17 national teams of FIFA's member associations.",
      "cites": [
        "wiki:rev:1385611092:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:25Z",
      "text": "The report is attributed to AFP and ESPN.",
      "cites": [
        "wiki:2026-11-11:29"
      ]
    },
