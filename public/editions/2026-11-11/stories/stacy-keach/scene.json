  "beats": [
    {
      "t": "2026-11-11T00:00:01Z",
      "text": "Walter Stacy Keach Jr. was an American actor, born June 2, 1941, and he died November 10, 2026.",
      "cites": [
        "wiki:rev:1385535604:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "According to Wikipedia, Keach died from heart failure complicated by heart disease at his home in Magdalenka, Poland, at the age of 85.",
      "cites": [
        "wiki:rev:1385535604:117"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "He was the elder son of theatre director Stacy Keach Sr. and the brother of actor James Keach.",
      "cites": [
        "wiki:rev:1385535604:1"
      ]
    },
    {
      "t": "2026-11-11T00:00:25Z",
      "text": "Keach was born on 2 June 1941 in Savannah.",
      "cites": [
        "wd:Q315090:P569",
        "wd:Q315090:P19"
      ]
    },
    {
      "t": "2026-11-11T00:00:33Z",
      "text": "He was educated at Yale School of Drama, London Academy of Music and Dramatic Art, Yale University and 2 more.",
      "cites": [
        "wd:Q315090:P69:Q8047423",
        "wd:Q315090:P69:Q385471",
        "wd:Q315090:P69:Q49112",
        "wd:Q315090:P69:Q4008476",
        "wd:Q315090:P69:Q168756"
      ]
    },
    {
      "t": "2026-11-11T00:00:46Z",
      "text": "3 awards are on record for Keach, among them the Fulbright Scholarship and a star on the Hollywood Walk of Fame.",
      "cites": [
        "wd:Q315090:P166:Q253936",
        "wd:Q315090:P166:Q17985761"
      ]
    },
    {
      "t": "2026-11-11T00:00:56Z",
      "text": "Keach died on 10 November 2026 in Magdalenka, Masovian Voivodeship, aged 85.",
      "cites": [
        "wd:Q315090:P570",
        "wd:Q315090:P20",
        "wd:Q315090:P569"
      ]
    },
    {
      "t": "2026-11-11T00:01:04Z",
      "text": "Readers also turned to the article on James Keach, which drew 99,527 readers.",
      "cites": [
        "views:en:James_Keach:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:13Z",
      "text": "The English article drew 562,990 readers on 11 November 2026, about 331 times its usual level.",
      "cites": [
        "views:en:Stacy_Keach:2026-11-11",
        "views:en:Stacy_Keach:prior"
      ]
    },
    {
      "t": "2026-11-11T00:01:20Z",
      "text": "The article is available in 11 languages, and after English, German was the most read with 107,656 readers.",
      "cites": [
        "views:en:Stacy_Keach:2026-11-11",
        "views:de:Stacy_Keach:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:27Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:de:Stacy_Keach:2026-11-11",
        "views:fr:Stacy_Keach:2026-11-11",
        "views:pl:Stacy_Keach:2026-11-11",
        "views:es:Stacy_Keach:2026-11-11",
        "views:it:Stacy_Keach:2026-11-11",
        "views:ru:Кич,_Стейси:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:37Z",
      "text": "The sources are Wikipedia articles, Wikimedia pageviews and Wikidata, and every caption links to the evidence it rests on.",
      "cites": [
