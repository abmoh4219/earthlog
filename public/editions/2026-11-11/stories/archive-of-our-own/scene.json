  "beats": [
    {
      "t": "2026-11-11T00:00:01Z",
      "text": "Archive of Our Own, or AO3, is a nonprofit, open-source repository for fanfiction and other fanworks contributed by users.",
      "cites": [
        "wiki:rev:1385527575:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "As the article records, co-founder Novik said she felt a sense of \"resignation\" when the incident occurred.",
      "cites": [
        "wiki:rev:1385527575:24"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "The OTW also urged users to change passwords on other sites if they use the same passwords as AO3.",
      "cites": [
        "wiki:rev:1385527575:23"
      ]
    },
    {
      "t": "2026-11-11T00:00:25Z",
      "text": "Archive of Our Own is run by the Organization for Transformative Works, headquartered in Arlington County, United States.",
      "cites": [
        "wd:Q27764876:P137"
      ]
    },
    {
      "t": "2026-11-11T00:00:33Z",
      "text": "The archive was founded in 2008 and is owned by the Organization for Transformative Works.",
      "cites": [
        "wd:Q27764876:P571",
        "wd:Q27764876:P127"
      ]
    },
    {
      "t": "2026-11-11T00:00:43Z",
      "text": "7 Hacker News stories mentioned Archive of Our Own in the two weeks to 11 November 2026.",
      "cites": [
        "hn:2026-11-11:Q27764876"
      ]
    },
    {
      "t": "2026-11-11T00:00:52Z",
      "text": "English Wikipedia recorded 55,989 readers on 11 November 2026, about 37× the usual.",
      "cites": [
        "views:en:Archive_of_Our_Own:2026-11-11",
        "views:en:Archive_of_Our_Own:prior"
      ]
    },
    {
      "t": "2026-11-11T00:00:59Z",
      "text": "The article was read in 11 languages, and after English the most readers were on Russian Wikipedia, with 607.",
      "cites": [
        "views:en:Archive_of_Our_Own:2026-11-11",
        "views:ru:Archive_of_Our_Own:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:06Z",
      "text": "On a map, each language glows where it is mainly spoken, brighter for more readers, though a language is not a country.",
      "cites": [
        "views:ru:Archive_of_Our_Own:2026-11-11",
        "views:es:Archive_of_Our_Own:2026-11-11",
        "views:zh:AO3作品库:2026-11-11",
        "views:de:Archive_of_Our_Own:2026-11-11",
        "views:fr:Archive_of_Our_Own:2026-11-11",
        "views:pt:Archive_of_Our_Own:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:16Z",
      "text": "The sources are Wikipedia articles, Wikimedia pageviews, Wikidata and Hacker News, accessed through the Algolia search API.",
      "cites": [
        "wiki:rev:1385527575:23",
        "views:en:Archive_of_Our_Own:2026-11-11",
        "wd:Q27764876:P31",
        "hn:2026-11-11:Q27764876"
      ]
    },
    {
      "t": "2026-11-11T00:01:17Z",
      "text": "Each caption is tied to the evidence it rests on.",
      "cites": [
        "wiki:rev:1385527575:23",
        "views:en:Archive_of_Our_Own:2026-11-11"
      ]
    }
