  "beats": [
    {
      "t": "2026-11-11T00:00:01Z",
      "text": "Scott Winston Colom, born December 24, 1982, is an American politician, lawyer, and jurist who is the United States senator-elect from Mississippi.",
      "cites": [
        "wiki:rev:1385713347:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "After a week of counting affidavit ballots, the Associated Press and CNN projected Colom the winner over incumbent Republican Cindy Hyde-Smith.",
      "cites": [
        "wiki:2026-11-11:22"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "In October 2026, his campaign ran an ad mocking Hyde-Smith's comment dismissing concerns about rising beef prices, saying consumers \"have so many proteins to choose from\".",
      "cites": [
        "wiki:rev:1385713347:41"
      ]
    },
    {
      "t": "2026-11-11T00:00:25Z",
      "text": "Colom's birth date is recorded as 24 December 1983, in Columbus.",
      "cites": [
        "wd:Q115492489:P569",
        "wd:Q115492489:P19"
      ]
    },
    {
      "t": "2026-11-11T00:00:33Z",
      "text": "His education includes Millsaps College and the University of Wisconsin–Madison.",
      "cites": [
        "wd:Q115492489:P69:Q6860022",
        "wd:Q115492489:P69:Q838330"
      ]
    },
    {
      "t": "2026-11-11T00:00:43Z",
      "text": "The reports also name Mississippi and Columbus.",
      "cites": [
        "wiki:2026-11-11:22"
      ]
    },
    {
      "t": "2026-11-11T00:00:52Z",
      "text": "On 11 November 2026, the English Wikipedia article was read 80,972 times, about 125 times the usual daily rate of readers.",
      "cites": [
        "views:en:Scott_Colom:2026-11-11",
        "views:en:Scott_Colom:prior"
      ]
    },
    {
      "t": "2026-11-11T00:00:59Z",
      "text": "The article is read in 5 languages, and after English, the most readers came from French Wikipedia, with 464 readers.",
      "cites": [
        "views:en:Scott_Colom:2026-11-11",
        "views:fr:Scott_Colom:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:06Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, though a language is not the same as a country.",
      "cites": [
        "views:fr:Scott_Colom:2026-11-11",
        "views:es:Scott_Colom:2026-11-11",
        "views:he:סקוט_קולום:2026-11-11",
        "views:ko:스콧_콜럼:2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:16Z",
      "text": "The story was reported by AFP, AP and CNN.",
      "cites": [
        "wiki:2026-11-11:22"
      ]
    },
    {
      "t": "2026-11-11T00:01:24Z",
