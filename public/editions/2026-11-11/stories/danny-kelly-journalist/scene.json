  "beats": [
    {
      "t": "2026-11-11T00:00:01Z",
      "text": "On 11 November 2026, during the White & Jordan Show on talkSPORT, it was announced that Kelly had died the previous day, at St. James's Hospital in Dublin, aged 69.",
      "cites": [
        "wiki:rev:1385419391:27"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "He was the editor of the music weekly New Musical Express and of Q magazine.",
      "cites": [
        "wiki:rev:1385419391:1"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "Daniel Kelly, born 22 December 1956 and died 10 November 2026, was a British music journalist, sports presenter and internet publisher.",
      "cites": [
        "wiki:rev:1385419391:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:25Z",
      "text": "Wikidata records his birth on 23 December 1956 in the London Borough of Islington.",
      "cites": [
        "wd:Q5220508:P569",
        "wd:Q5220508:P19"
      ]
    },
    {
      "t": "2026-11-11T00:00:33Z",
      "text": "He worked for NME and for Q.",
      "cites": [
        "wd:Q5220508:P108:Q192632",
        "wd:Q5220508:P108:Q217629"
      ]
    },
    {
      "t": "2026-11-11T00:00:43Z",
      "text": "Wikidata lists his death on 10 November 2026 in Kilkenny, at the age of 69.",
      "cites": [
        "wd:Q5220508:P570",
        "wd:Q5220508:P20",
        "wd:Q5220508:P569"
      ]
    },
    {
      "t": "2026-11-11T00:01:00Z",
      "text": "On 11 November 2026, the English Wikipedia article was read by 64,926 readers.",
      "cites": [
        "views:en:Danny_Kelly_(journalist):2026-11-11"
      ]
    },
    {
      "t": "2026-11-11T00:01:05Z",
      "text": "In the weeks before, the article had a median of 40 readers a day.",
      "cites": [
        "views:en:Danny_Kelly_(journalist):prior"
      ]
    },
    {
      "t": "2026-11-11T00:01:12Z",
