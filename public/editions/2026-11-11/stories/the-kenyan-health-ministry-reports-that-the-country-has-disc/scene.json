  "beats": [
    {
      "t": "2026-11-11T00:00:01Z",
      "text": "According to the Kenyan health ministry, the country has discharged its last Ebola patient from a hospital in Nairobi after eleven contact cases were treated.",
      "cites": [
        "wiki:2026-11-11:11"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "The World Health Organization reported in October 2026 that mental health and psychosocial support had been built into the Ebola response in DRC, for both patients and survivors.",
      "cites": [
        "wiki:rev:1385663578:197"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "The 2026 Ebola epidemic is an outbreak of Ebola virus disease, mainly in the eastern Democratic Republic of the Congo and neighbouring countries.",
      "cites": [
        "wiki:rev:1385663578:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:25Z",
      "text": "The map shows Nairobi, Kenya, where the reports place the hospital.",
      "cites": [
        "wiki:2026-11-11:11"
      ]
    },
    {
      "t": "2026-11-11T00:00:33Z",
      "text": "The epidemic began on 15 May 2026, and its listed countries are the Democratic Republic of the Congo and Uganda.",
      "cites": [
        "wd:Q139821980:P580",
        "wd:Q139821980:P17"
      ]
    },
    {
      "t": "2026-11-11T00:00:43Z",
      "text": "The story is reported by DW and Al Jazeera.",
      "cites": [
        "wiki:2026-11-11:11",
        "wiki:2026-11-11:12"
      ]
    },
