  "beats": [
    {
      "t": "2026-11-11T00:00:01Z",
      "text": "On November 11, 2026, a three-story mixed-use building at 1321 Flatbush Avenue in Flatbush, a Brooklyn neighborhood, collapsed into an adjacent excavation site.",
      "cites": [
        "wiki:rev:1385718195:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:08Z",
      "text": "A 3-story apartment building collapsed near a construction site in Brooklyn, New York City, killing eight people and wounding 19 more.",
      "cites": [
        "wiki:2026-11-11:10"
      ]
    },
    {
      "t": "2026-11-11T00:00:15Z",
      "text": "The New York City Fire Department received the first 911 call reporting the collapse at 16:01 EST on November 11.",
      "cites": [
        "wiki:rev:1385718195:5"
      ]
    },
    {
      "t": "2026-11-11T00:00:30Z",
      "text": "According to the article, 8 people died and 18 were injured, one of them critically.",
      "cites": [
        "wiki:box:1385718195:fatalities",
        "wiki:box:1385718195:injuries"
      ]
    },
    {
      "t": "2026-11-11T00:00:41Z",
      "text": "On March 20, 2026, the DOB ordered demolition halted at the neighboring construction site after inspectors found inadequate overhead protection for adjacent properties.",
      "cites": [
        "wiki:investigation:1385718195:0"
      ]
    },
    {
      "t": "2026-11-11T00:00:48Z",
      "text": "When inspectors returned on April 23, they found demolition had resumed despite the stop-work order and issued another violation.",
      "cites": [
        "wiki:investigation:1385718195:1"
      ]
    },
    {
      "t": "2026-11-11T00:00:55Z",
      "text": "The DOB lifted the order on May 8 after conditions were corrected, and CBS News reported, based on court records, that the contractor had been sued \"at least 67 times since 2012.\"",
      "cites": [
        "wiki:investigation:1385718195:2"
      ]
    },
    {
      "t": "2026-11-11T00:01:03Z",
      "text": "The story is reported by AFP and Reuters.",
      "cites": [
        "wiki:2026-11-11:10"
      ]
    },
    {
      "t": "2026-11-11T00:01:11Z",
      "text": "The sources are Wikipedia, Current events, Wikipedia articles and Wikidata, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-11:10",
        "wiki:rev:1385718195:5",
        "wd:Q142131356:P31"
      ]
    }
  ],
