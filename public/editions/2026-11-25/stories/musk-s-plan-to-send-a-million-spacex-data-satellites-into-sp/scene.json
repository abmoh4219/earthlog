  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "According to Sky News, the US has authorised SpaceX to deploy one million satellites.",
      "cites": [
        "news:sky:b394be56452d"
      ]
    },
    {
      "t": "2026-11-25T00:00:08Z",
      "text": "On November 25, 2026, the Federal Communications Commission granted SpaceX's application in part to launch and operate Starmind as a constellation of up to one million satellites.",
      "cites": [
        "wiki:rev:1388160214:211"
      ]
    },
    {
      "t": "2026-11-25T00:00:15Z",
      "text": "Space Exploration Technologies Corp., known as SpaceX, is an American conglomerate working in aerospace manufacturing, space transportation, telecommunications, infrastructure and artificial intelligence services.",
      "cites": [
        "wiki:rev:1388160214:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:25Z",
      "text": "Wikidata records SpaceX as headquartered in Hawthorne, United States.",
      "cites": [
        "wd:Q193701:P159"
      ]
    },
    {
      "t": "2026-11-25T00:00:33Z",
      "text": "SpaceX was founded in 2002 by Elon Musk, who is also its chief executive.",
      "cites": [
        "wd:Q193701:P571",
        "wd:Q193701:P112",
        "wd:Q193701:P169"
      ]
    },
    {
      "t": "2026-11-25T00:00:43Z",
      "text": "Recorded revenue reached $10.4 billion in 2023 and $18.7 billion in 2025.",
      "cites": [
        "wd:Q193701:P2139:series"
      ]
    },
    {
      "t": "2026-11-25T00:00:50Z",
      "text": "Staff grew from 160 in 2005 to 22,000 in 2026.",
      "cites": [
        "wd:Q193701:P1128:series"
      ]
    },
    {
      "t": "2026-11-25T00:00:59Z",
      "text": "Wikidata lists X Corp., SpaceX Super Intelligence and Starbase among the companies it owns or has as subsidiaries.",
      "cites": [
        "wd:Q193701:P355:Q117617480",
        "wd:Q193701:P355:Q120599684",
        "wd:Q193701:P1830:Q16950811"
      ]
    },
    {
      "t": "2026-11-25T00:01:08Z",
      "text": "Hacker News carried 232 stories with SpaceX in the title in the 14 days to 25 November 2026.",
      "cites": [
        "hn:2026-11-25:Q193701"
      ]
    },
    {
      "t": "2026-11-25T00:01:26Z",
      "text": "Sky News headlined its report, US authorises SpaceX to deploy one million satellites to space.",
      "cites": [
        "news:sky:b394be56452d"
      ]
    },
    {
      "t": "2026-11-25T00:01:33Z",
      "text": "Al Jazeera headlined its report, US grants SpaceX approval for 1 million space data centres.",
      "cites": [
        "news:aljazeera:94b8395d382f"
      ]
    },
    {
      "t": "2026-11-25T00:01:42Z",
      "text": "The sources are Sky News, Al Jazeera, Wikipedia, Wikidata, Wikimedia pageviews and Hacker News, and each caption links to the evidence it rests on.",
