  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "According to reports, a Hamas security official, his wife, and two daughters were killed in an Israeli airstrike on the Al-Shati refugee camp near Gaza City.",
      "cites": [
        "wiki:2026-11-25:2"
      ]
    },
    {
      "t": "2026-11-25T00:00:08Z",
      "text": "A UN report from November 2026 accused Israel of war crimes and crimes against humanity in the occupied West Bank, including extermination, torture, and sexual assault.",
      "cites": [
        "wiki:rev:1388101458:405"
      ]
    },
    {
      "t": "2026-11-25T00:00:15Z",
      "text": "The Gaza war is an armed conflict in the Gaza Strip and Israel, part of the unresolved Israeli–Palestinian and Gaza–Israel conflicts.",
      "cites": [
        "wiki:rev:1388101458:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:25Z",
      "text": "On 19 November, Gaza's health ministry reported that two people were killed by recent Israeli attacks, and two others died of their wounds over the past day.",
      "cites": [
        "wiki:2026-11-19:7"
      ]
    },
    {
      "t": "2026-11-25T00:00:32Z",
      "text": "On 24 November, Israel claimed to have killed Hamas security official Naeem Abu Nahel in an airstrike in the Gaza Strip.",
      "cites": [
        "wiki:2026-11-24:2"
      ]
    },
    {
      "t": "2026-11-25T00:00:41Z",
      "text": "On the map, the reports place the Al-Shati refugee camp near Gaza City.",
      "cites": [
        "wiki:2026-11-25:2"
      ]
    },
    {
      "t": "2026-11-25T00:00:49Z",
      "text": "Levant is also named in the reports.",
      "cites": [
        "wiki:2026-11-25:2"
      ]
    },
    {
      "t": "2026-11-25T00:00:58Z",
      "text": "Al Jazeera and Al Jazeera 2 reported the story.",
      "cites": [
        "wiki:2026-11-25:2"
      ]
    },
    {
      "t": "2026-11-25T00:01:06Z",
      "text": "Al Jazeera headlined it: “Israeli strike kills Hamas official, his wife and children”.",
      "cites": [
        "news:aljazeera:fb1846ef00ab"
      ]
    },
    {
      "t": "2026-11-25T00:01:12Z",
      "text": "BBC News headlined it: “Israeli strike kills senior Hamas security official and family in Gaza City”.",
      "cites": [
        "news:bbc:c49453b02b83"
      ]
    },
    {
      "t": "2026-11-25T00:01:18Z",
      "text": "The Guardian headlined it: “Palestinian journalist killed by Israel in Gaza wins Rory Peck prize”.",
      "cites": [
        "news:guardian:2eb146ad21c1"
      ]
    },
    {
      "t": "2026-11-25T00:01:27Z",
