  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "Pakistani astronaut Muhammad Zeeshan Ali becomes the first Pakistani to reach orbit and the first foreign national to board China's Tiangong space station.",
      "cites": [
        "wiki:2026-11-25:20"
      ]
    },
    {
      "t": "2026-11-25T00:00:08Z",
      "text": "Shenzhou 24 launched aboard a Long March 2F/G rocket from the Jiuquan Satellite Launch Center on 25 November 2026, at 00:18:52 UTC (08:18:52 CST, local time at the launch site).",
      "cites": [
        "wiki:rev:1388129318:4"
      ]
    },
    {
      "t": "2026-11-25T00:00:15Z",
      "text": "The Shenzhou 24 spaceflight to the Tiangong space station is still in progress.",
      "cites": [
        "wiki:rev:1388129318:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:30Z",
      "text": "The mission is crew transport to the Tiangong space station, with Tang Hongbo and Wu Yi aboard.",
      "cites": [
        "wiki:box:1388129318:mission",
        "wiki:box:1388129318:crew"
      ]
    },
    {
      "t": "2026-11-25T00:00:38Z",
      "text": "The flight is listed as in progress, with 180 days planned.",
      "cites": [
        "wiki:box:1388129318:duration"
      ]
    },
    {
      "t": "2026-11-25T00:00:47Z",
      "text": "The story was reported by AFP and Reuters.",
      "cites": [
        "wiki:2026-11-25:20"
      ]
    },
    {
      "t": "2026-11-25T00:00:55Z",
      "text": "Al Jazeera headlined it: “Pakistani astronaut launches into space aboard Chinese rocket”.",
      "cites": [
        "news:aljazeera:ef94c4539b50"
      ]
    },
    {
      "t": "2026-11-25T00:01:01Z",
