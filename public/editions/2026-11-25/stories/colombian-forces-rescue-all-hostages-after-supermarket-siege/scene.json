  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "Al Jazeera reports that gunmen are holding dozens of people hostage in a supermarket in Colombia.",
      "cites": [
        "news:aljazeera:80e92d438b13"
      ]
    },
    {
      "t": "2026-11-25T00:00:09Z",
      "text": "The Guardian, France 24, DW and BBC News also reported on the event.",
      "cites": [
        "news:guardian:75a3a86ed42c",
        "news:france24:23f238675216",
        "news:dw:b961b0ea4c67",
        "news:bbc:f3370d38161d"
      ]
    },
    {
      "t": "2026-11-25T00:00:18Z",
      "text": "Inflation in Colombia was 5.1% in 2025, down from 11.7% in 2023.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:CO"
      ]
    },
    {
      "t": "2026-11-25T00:00:26Z",
      "text": "In 2025 the economy grew 2.6%, and unemployment stood at 8.3%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:CO",
        "wb:SL.UEM.TOTL.ZS:CO"
      ]
    },
    {
      "t": "2026-11-25T00:00:36Z",
      "text": "Across Latin America & Caribbean, Colombia’s 5.1% compares with a median of 3.8%, while the highest is Argentina at 219.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:latin-america-caribbean"
      ]
    },
    {
      "t": "2026-11-25T00:00:50Z",
      "text": "Colombia, officially the Republic of Colombia, is a country located in South America, with insular regions in North America.",
      "cites": [
        "wiki:rev:1386517347:0"
      ]
    },
    {
      "t": "2026-11-25T00:01:01Z",
      "text": "Al Jazeera headlined it: “Gunmen hold dozens hostage in Colombia supermarket”.",
      "cites": [
        "news:aljazeera:80e92d438b13"
      ]
    },
    {
      "t": "2026-11-25T00:01:07Z",
      "text": "The Guardian headlined it: “Colombia’s president arrives at scene of supermarket hostage siege in tourist city”.",
      "cites": [
        "news:guardian:75a3a86ed42c"
      ]
    },
    {
      "t": "2026-11-25T00:01:13Z",
      "text": "France 24 headlined it: “Colombia president says all hostages freed, one assailant killed after supermarket hostage siege”.",
      "cites": [
        "news:france24:23f238675216"
      ]
    },
    {
      "t": "2026-11-25T00:01:22Z",
      "text": "Sources include Al Jazeera, The Guardian, France 24, DW and BBC News, Wikipedia articles, Wikimedia pageviews, Wikidata and World Bank Open Data.",
      "cites": [
        "wiki:rev:1386517347:0",
        "views:en:Colombia:30d",
