  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "Andrew James Taylor (16 February 1961 – 23 November 2026) was an English guitarist, best known as a member of Duran Duran and the Power Station.",
      "cites": [
        "wiki:rev:1388187764:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:08Z",
      "text": "Taylor also recorded and performed as a solo artist.",
      "cites": [
        "wiki:rev:1388187764:1"
      ]
    },
    {
      "t": "2026-11-25T00:00:15Z",
      "text": "He worked as a guitarist, songwriter and record producer for artists including Robert Palmer, Rod Stewart, the Almighty, Love and Money, Mark Shaw, Then Jerico and Belinda Carlisle.",
      "cites": [
        "wiki:rev:1388187764:1"
      ]
    },
    {
      "t": "2026-11-25T00:00:25Z",
      "text": "Taylor was born on 16 February 1961 in Tynemouth.",
      "cites": [
        "wd:Q527834:P569",
        "wd:Q527834:P19"
      ]
    },
    {
      "t": "2026-11-25T00:00:33Z",
      "text": "He was educated at Marden High School.",
      "cites": [
        "wd:Q527834:P69:Q6758635"
      ]
    },
    {
      "t": "2026-11-25T00:00:43Z",
      "text": "Taylor died on 23 November 2026 in Ibiza, aged 65.",
      "cites": [
        "wd:Q527834:P570",
        "wd:Q527834:P20",
        "wd:Q527834:P569"
      ]
    },
    {
      "t": "2026-11-25T00:00:51Z",
      "text": "Readers also turned to Duran Duran, with 63,746 readers that day.",
      "cites": [
        "views:en:Duran_Duran:2026-11-25"
      ]
    },
    {
      "t": "2026-11-25T00:01:00Z",
      "text": "135,665 people read the English article on 25 November 2026, about 225 times the usual level.",
      "cites": [
        "views:en:Andy_Taylor_(guitarist):2026-11-25",
        "views:en:Andy_Taylor_(guitarist):prior"
      ]
    },
    {
      "t": "2026-11-25T00:01:07Z",
      "text": "The article was read in 9 languages, and after English, Italian had the most readers with 15,275.",
      "cites": [
        "views:en:Andy_Taylor_(guitarist):2026-11-25",
        "views:it:Andy_Taylor:2026-11-25"
      ]
    },
    {
      "t": "2026-11-25T00:01:14Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:it:Andy_Taylor:2026-11-25",
        "views:es:Andy_Taylor:2026-11-25",
        "views:de:Andy_Taylor_(Musiker):2026-11-25",
        "views:fr:Andy_Taylor:2026-11-25",
        "views:pt:Andy_Taylor:2026-11-25",
        "views:nl:Andy_Taylor_(gitarist):2026-11-25"
      ]
    },
    {
      "t": "2026-11-25T00:01:24Z",
      "text": "DW ran the headline “Duran Duran guitarist Andy Taylor dies at 65”.",
      "cites": [
        "news:dw:e1b7f742aed7"
      ]
    },
    {
      "t": "2026-11-25T00:01:30Z",
      "text": "The Guardian ran the headline “Andy Taylor, guitarist in Duran Duran, dies aged 65”.",
      "cites": [
        "news:guardian:779cda796145"
