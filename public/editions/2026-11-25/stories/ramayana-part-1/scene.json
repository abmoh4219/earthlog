        "views:de:Ramayana:_Rise_of_a_Legend:2026-11-25",
        "views:te:రామాయణం_(2026_సినిమా):2026-11-25",
        "views:th:รามายณะ:_ปฐมบทแห่งตำนาน:2026-11-25"
      ]
