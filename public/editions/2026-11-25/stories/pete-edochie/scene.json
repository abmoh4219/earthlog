  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "Pete Edochie died of prostate cancer on 25 November 2026, at the age of 79.",
      "cites": [
        "wiki:rev:1388035997:18"
      ]
    },
    {
      "t": "2026-11-25T00:00:08Z",
      "text": "He was married to Josephine Edochie.",
      "cites": [
        "wiki:rev:1388035997:14"
      ]
    },
    {
      "t": "2026-11-25T00:00:15Z",
      "text": "Chief Peter Uwadiegwu Ogugua Edochie MON, born 7 March 1947, was known as Pete Edochie and was a Nigerian actor.",
      "cites": [
        "wiki:rev:1388035997:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:25Z",
      "text": "Pete Edochie was born on 7 March 1947 in Enugu.",
      "cites": [
        "wd:Q7171945:P569",
        "wd:Q7171945:P19"
      ]
    },
    {
      "t": "2026-11-25T00:00:33Z",
      "text": "His record lists one award: the Africa Magic Viewers’ Choice Awards.",
      "cites": [
        "wd:Q7171945:P166:Q16825873"
      ]
    },
    {
      "t": "2026-11-25T00:00:48Z",
      "text": "On 25 November 2026, 61,123 people read his English Wikipedia article, about 556 times the usual.",
      "cites": [
        "views:en:Pete_Edochie:2026-11-25",
        "views:en:Pete_Edochie:prior"
      ]
    },
    {
      "t": "2026-11-25T00:00:55Z",
      "text": "The article is read in 5 languages, and after English, the most readers were in French, with 6,227.",
      "cites": [
        "views:en:Pete_Edochie:2026-11-25",
        "views:fr:Pete_Edochie:2026-11-25"
      ]
    },
    {
      "t": "2026-11-25T00:01:02Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:fr:Pete_Edochie:2026-11-25",
        "views:es:Pete_Edochie:2026-11-25",
        "views:de:Pete_Edochie:2026-11-25",
