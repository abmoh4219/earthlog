  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "The United States Army planned to detonate nearly 5 tons of degrading lead azide at the Iowa Army Ammunition Plant near Middletown, Iowa, citing the risk of spontaneous explosion.",
      "cites": [
        "wiki:2026-11-25:11"
      ]
    },
    {
      "t": "2026-11-25T00:00:08Z",
      "text": "The detonation was rescheduled to Wednesday, November 25, 2026.",
      "cites": [
        "wiki:rev:1388177974:97"
      ]
    },
    {
      "t": "2026-11-25T00:00:15Z",
      "text": "At 9:00 am CST (15:00 UTC) on November 25, 2026, the Army detonated approximately 9500 lb of lead azide stored at the plant near Middletown.",
      "cites": [
        "wiki:rev:1388177974:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:30Z",
      "text": "The event is dated 25 November 2026 and is located in Iowa.",
      "cites": [
        "wd:Q142278417:P585",
        "wd:Q142278417:P276"
      ]
    },
    {
      "t": "2026-11-25T00:00:40Z",
      "text": "Iowa is also named in the reports on the story.",
      "cites": [
        "wiki:2026-11-25:11"
      ]
    },
    {
      "t": "2026-11-25T00:00:49Z",
      "text": "The English Wikipedia article was tracked for daily readers over the period from 24 November 2026 to 25 November 2026.",
      "cites": [
        "views:en:Iowa_lead_azide_detonation:30d"
      ]
    },
    {
      "t": "2026-11-25T00:00:54Z",
      "text": "AFP and CNN reported the story.",
      "cites": [
        "wiki:2026-11-25:11"
      ]
    },
    {
      "t": "2026-11-25T00:01:02Z",
      "text": "NPR's headline read: “Army to detonate tons of lead azide after delays. And, Abrego Garcia leaves U.S.”",
      "cites": [
        "news:npr:7c35b68fa871"
      ]
    },
    {
      "t": "2026-11-25T00:01:08Z",
      "text": "Al Jazeera headlined the Army's claim: “US Army declares Iowa lead azide detonation ‘tremendously successful’”",
      "cites": [
