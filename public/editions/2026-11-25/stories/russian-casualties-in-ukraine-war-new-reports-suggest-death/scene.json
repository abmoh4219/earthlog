  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "The Guardian reports on the Russian army's secret death toll in a podcast.",
      "cites": [
        "news:guardian:f7be36771056"
      ]
    },
    {
      "t": "2026-11-25T00:00:09Z",
      "text": "France 24 also reports that the Kremlin declined to comment on reports of 700,000 Russian soldiers killed in the Ukraine war.",
      "cites": [
        "news:france24:97c7af478f38"
      ]
    },
    {
      "t": "2026-11-25T00:00:18Z",
      "text": "Inflation in Ukraine was 12.7% in 2025, down from 20.2% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:UA"
      ]
    },
    {
      "t": "2026-11-25T00:00:26Z",
      "text": "The economy grew 1.8% in 2025, and unemployment stood at 9.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:UA",
        "wb:SL.UEM.TOTL.ZS:UA"
      ]
    },
    {
      "t": "2026-11-25T00:00:36Z",
      "text": "Across Europe and Central Asia, Ukraine's 12.7% inflation compares with a median of 3.8%, while Turkey records the highest at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-25T00:00:50Z",
      "text": "On 18 November, Ukrainian forces struck the Crimean Bridge for the third time in four days, and Russian authorities closed it to all traffic.",
      "cites": [
        "wiki:2026-11-18:1"
      ]
    },
    {
      "t": "2026-11-25T00:00:59Z",
      "text": "On 22 November, according to Wikipedia's current events page, several people were killed and at least 10 injured when a Ukrainian naval drone attack struck the Russian corvette Merkury in the port of Benghazi, Libya.",
      "cites": [
        "wiki:2026-11-22:2"
      ]
    },
    {
      "t": "2026-11-25T00:01:08Z",
      "text": "Per Wikipedia, on 23 November Ukraine's drone attack hit the Perm and Novoshakhtinsk refineries, and on 24 November a Russian airstrike killed two and wounded 44 in a five-story Zaporizhzhia building.",
      "cites": [
        "wiki:2026-11-23:1",
        "wiki:2026-11-24:1"
      ]
    },
    {
      "t": "2026-11-25T00:01:18Z",
      "text": "Ukraine is the second-largest country in Europe after Russia, which borders it to the east and northeast.",
      "cites": [
        "wiki:rev:1386666930:0"
      ]
    },
    {
      "t": "2026-11-25T00:01:29Z",
      "text": "The Guardian headlined its report “The Russian army’s secret death toll – podcast.”",
      "cites": [
        "news:guardian:f7be36771056"
      ]
    },
    {
      "t": "2026-11-25T00:01:36Z",
      "text": "France 24 headlined its report “Kremlin declines comment on reports 700,000 Russian soldiers killed in Ukraine war.”",
      "cites": [
        "news:france24:97c7af478f38"
      ]
    },
    {
      "t": "2026-11-25T00:01:45Z",
      "text": "Sources: 2 outlets, Wikipedia articles, Wikimedia pageviews, Wikidata, and Wikipedia's current events portals for 2026 November 18 and 2026 November 22.",
      "cites": [
        "wiki:rev:1386666930:0",
        "views:en:Ukraine:30d",
        "wd:Q212:P571",
        "wiki:2026-11-18:1",
        "wiki:2026-11-22:2"
      ]
    }
  ],
