  "beats": [
    {
      "t": "2026-11-25T00:00:01Z",
      "text": "On 25 November, Bangladesh's Minimum Wage Board voted 4-2 to raise the monthly minimum wage for garment workers from ৳12,500 to ৳17,000.",
      "cites": [
        "wiki:rev:1388197123:91",
        "wiki:2026-11-25:4"
      ]
    },
    {
      "t": "2026-11-25T00:00:12Z",
      "text": "Labour unions rejected the decision, demanding at least ৳18,000, while demonstrations have sought a rise from ৳12,500 (US$100) to ৳30,000 (US$240).",
      "cites": [
        "wiki:2026-11-25:4",
        "wiki:rev:1388197123:0"
      ]
    },
    {
      "t": "2026-11-25T00:00:25Z",
      "text": "Inflation in Bangladesh fell to 8.8% in 2025, from 10.5% in 2024.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:BD"
      ]
    },
    {
      "t": "2026-11-25T00:00:33Z",
      "text": "The economy grew 3.5% in 2025, and unemployment stood at 3.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:BD",
        "wb:SL.UEM.TOTL.ZS:BD"
      ]
    },
    {
      "t": "2026-11-25T00:00:43Z",
      "text": "Across South Asia, Bangladesh's 8.8% inflation in 2025 is the highest, compared with a median of 2.7%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:south-asia"
      ]
    },
    {
      "t": "2026-11-25T00:00:57Z",
      "text": "The story was reported by AFP, The Daily Star and The Business Standard.",
      "cites": [
        "wiki:2026-11-25:4",
        "wiki:2026-11-25:5"
      ]
    },
    {
      "t": "2026-11-25T00:01:05Z",
      "text": "Al Jazeera headlined it: “Bangladesh garment workers protest over new wages.”",
      "cites": [
        "news:aljazeera:7dc0ec7bcbf5"
      ]
    },
    {
      "t": "2026-11-25T00:01:16Z",
      "text": "Sources include Wikipedia, Wikimedia pageviews, Wikidata and World Bank Open Data, and every caption links to the evidence it rests on.",
      "cites": [
