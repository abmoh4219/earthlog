  "beats": [
    {
      "t": "2026-11-10T00:00:01Z",
      "text": "According to the article, Captain Peter Pulcer played music over the ship's intercom day or night while passing the St. Clair and Detroit rivers, and gave Soo Locks spectators a running commentary.",
      "cites": [
        "wiki:rev:1385124621:5"
      ]
    },
    {
      "t": "2026-11-10T00:00:08Z",
      "text": "Northwestern Mutual wanted to name the ship after its president and chairman of the board, Edmund Fitzgerald, whose son was Edmund B. Fitzgerald.",
      "cites": [
        "wiki:rev:1385124621:33"
      ]
    },
    {
      "t": "2026-11-10T00:00:15Z",
      "text": "The SS Edmund Fitzgerald was an American Great Lakes freighter that sank in Lake Superior during a storm on November 10, 1975, with the loss of the entire crew of 29 men.",
      "cites": [
        "wiki:rev:1385124621:0"
      ]
    },
    {
      "t": "2026-11-10T00:00:34Z",
      "text": "On 10 November 2026, 163,598 people read the English article, about 54 times the usual level.",
      "cites": [
        "views:en:SS_Edmund_Fitzgerald:2026-11-10",
        "views:en:SS_Edmund_Fitzgerald:prior"
      ]
    },
    {
      "t": "2026-11-10T00:00:41Z",
      "text": "The article was read in 10 languages, and after English, German came first with 3,340 readers.",
      "cites": [
        "views:en:SS_Edmund_Fitzgerald:2026-11-10",
        "views:de:Edmund_Fitzgerald_(Schiff):2026-11-10"
      ]
    },
    {
      "t": "2026-11-10T00:00:48Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:de:Edmund_Fitzgerald_(Schiff):2026-11-10",
        "views:pl:SS_Edmund_Fitzgerald:2026-11-10",
