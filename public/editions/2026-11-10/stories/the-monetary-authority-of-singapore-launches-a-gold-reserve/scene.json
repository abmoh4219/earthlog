  "beats": [
    {
      "t": "2026-11-10T00:00:01Z",
      "text": "Singapore's Monetary Authority launched a gold reserve service for foreign central banks, international financial institutions and sovereign entities, and expanded tax exemptions for wholesale gold.",
      "cites": [
        "wiki:2026-11-10:6"
      ]
    },
    {
      "t": "2026-11-10T00:00:11Z",
      "text": "The decision came from the Monetary Authority of Singapore, which is headquartered in Singapore.",
      "cites": [
        "wd:Q2661296:P159",
        "wiki:2026-11-10:6"
      ]
    },
    {
      "t": "2026-11-10T00:00:19Z",
      "text": "Malaysia's inflation fell to 1.4% in 2025, from 3.4% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:MY"
      ]
    },
    {
      "t": "2026-11-10T00:00:27Z",
      "text": "The economy grew 5.2% in 2025, and unemployment stood at 3.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:MY",
        "wb:SL.UEM.TOTL.ZS:MY"
      ]
    },
    {
      "t": "2026-11-10T00:00:37Z",
      "text": "Across East Asia and Pacific, Malaysia's 1.4% inflation compares with a median of 2.1%, while Mongolia recorded the highest at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-10T00:00:51Z",
      "text": "The story was reported by AFP, via The Daily Star and Reuters.",
      "cites": [
        "wiki:2026-11-10:6"
      ]
    },
    {
      "t": "2026-11-10T00:00:59Z",
      "text": "Sources include Wikipedia's current events page, Wikidata, and World Bank Open Data (World Development Indicators).",
      "cites": [
        "wiki:2026-11-10:6",
        "wd:Q2661296:P159",
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
