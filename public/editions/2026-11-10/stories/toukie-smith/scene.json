  "beats": [
    {
      "t": "2026-11-10T00:00:01Z",
      "text": "Doris A. Smith, known professionally as Toukie Smith, was an American actress and model, born September 25, 1952.",
      "cites": [
        "wiki:rev:1385050196:0"
      ]
    },
    {
      "t": "2026-11-10T00:00:08Z",
      "text": "According to Wikipedia, Smith died from complications of multiple sclerosis at a hospital in New York on November 4, 2026, at the age of 74.",
      "cites": [
        "wiki:rev:1385050196:15"
      ]
    },
    {
      "t": "2026-11-10T00:00:15Z",
      "text": "She was best known for her role as Eva Rawley on the NBC sitcom 227 (1989–90).",
      "cites": [
        "wiki:rev:1385050196:1"
      ]
    },
    {
      "t": "2026-11-10T00:00:25Z",
      "text": "Toukie Smith was born on 25 September 1952 in Philadelphia.",
      "cites": [
        "wd:Q7828852:P569",
        "wd:Q7828852:P19"
      ]
    },
    {
      "t": "2026-11-10T00:00:33Z",
      "text": "Smith was educated at the Fashion Institute of Technology.",
      "cites": [
        "wd:Q7828852:P69:Q844999"
      ]
    },
    {
      "t": "2026-11-10T00:00:43Z",
      "text": "Toukie Smith died on 4 November 2026 in New York City, aged 74.",
      "cites": [
        "wd:Q7828852:P570",
        "wd:Q7828852:P20",
        "wd:Q7828852:P569"
      ]
    },
    {
      "t": "2026-11-10T00:01:00Z",
      "text": "On 10 November 2026, 73,111 people read about Toukie Smith, about 199 times the usual daily count.",
      "cites": [
