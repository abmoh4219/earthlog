  "beats": [
    {
      "t": "2026-11-10T00:00:01Z",
      "text": "The Guardian and ITV News identify comedian and author David Walliams as the subject of sexual misconduct allegations after the High Court of Justice rejected his bid to block publication.",
      "cites": [
        "wiki:2026-11-10:16"
      ]
    },
    {
      "t": "2026-11-10T00:00:08Z",
      "text": "On 10 November 2026, the two outlets published a joint investigation into allegations that Walliams had used his position in the media to pursue young women for sex.",
      "cites": [
        "wiki:rev:1385555061:187"
      ]
    },
    {
      "t": "2026-11-10T00:00:15Z",
      "text": "David Edward Williams, known professionally as David Walliams, was born on 20 August 1971 and is an English actor, comedian, writer and television personality; he denies the allegations.",
      "cites": [
        "wiki:rev:1385555061:0",
        "wiki:2026-11-10:16"
      ]
    },
    {
      "t": "2026-11-10T00:00:25Z",
      "text": "David Walliams was born on 20 August 1971 in Wimbledon.",
      "cites": [
        "wd:Q359665:P569",
        "wd:Q359665:P19"
      ]
    },
    {
      "t": "2026-11-10T00:00:33Z",
      "text": "He was educated at the University of Bristol, Reigate Grammar School and Manor Hall, Bristol.",
      "cites": [
        "wd:Q359665:P69:Q459506",
        "wd:Q359665:P69:Q7310077",
        "wd:Q359665:P69:Q6751333"
      ]
    },
    {
      "t": "2026-11-10T00:00:43Z",
      "text": "One award on record is Officer of the Order of the British Empire, received in 2017.",
      "cites": [
        "wd:Q359665:P166:Q10762848"
      ]
    },
    {
      "t": "2026-11-10T00:00:53Z",
      "text": "Readers also turned to the article on Lara Stone, which drew 139,117 readers.",
      "cites": [
        "views:en:Lara_Stone:2026-11-10"
      ]
    },
    {
      "t": "2026-11-10T00:01:02Z",
      "text": "On 10 November 2026, 512,804 people read the English article, about 220 times the usual daily figure.",
      "cites": [
        "views:en:David_Walliams:2026-11-10",
        "views:en:David_Walliams:prior"
      ]
    },
    {
      "t": "2026-11-10T00:01:09Z",
      "text": "The article was read in 11 languages, and after English the most readers were in German, with 7,983.",
      "cites": [
        "views:en:David_Walliams:2026-11-10",
        "views:de:David_Walliams:2026-11-10"
      ]
    },
    {
      "t": "2026-11-10T00:01:16Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:de:David_Walliams:2026-11-10",
        "views:fr:David_Walliams:2026-11-10",
        "views:es:David_Walliams:2026-11-10",
        "views:it:David_Walliams:2026-11-10",
        "views:pl:David_Walliams:2026-11-10",
        "views:pt:David_Walliams:2026-11-10"
      ]
    },
    {
      "t": "2026-11-10T00:01:26Z",
      "text": "The story was reported by CNN and RTÉ News.",
      "cites": [
        "wiki:2026-11-10:16"
      ]
    },
    {
      "t": "2026-11-10T00:01:34Z",
      "text": "Sources include Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and every caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-10:16",
        "wiki:rev:1385555061:187",
