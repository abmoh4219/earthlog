  "beats": [
    {
      "t": "2026-11-10T00:00:01Z",
      "text": "Grand Theft Auto VI is an upcoming action-adventure game developed and published by Rockstar Games.",
      "cites": [
        "wiki:rev:1385514244:0"
      ]
    },
    {
      "t": "2026-11-10T00:00:08Z",
      "text": "The game is planned for PlayStation 5 and Xbox Series X and Series S, with no Windows release scheduled as of October 2026.",
      "cites": [
        "wiki:rev:1385514244:144"
      ]
    },
    {
      "t": "2026-11-10T00:00:15Z",
      "text": "On November 6, the Miami nightclub E11even was rebranded as the in-game equivalent club Nine1Nine.",
      "cites": [
        "wiki:rev:1385514244:134"
      ]
    },
    {
      "t": "2026-11-10T00:00:25Z",
      "text": "The listed release date is 19 November 2026.",
      "cites": [
        "wiki:box:1385514244:released"
      ]
    },
    {
      "t": "2026-11-10T00:00:37Z",
      "text": "English Wikipedia recorded 64,375 readers of the article on 10 November 2026, about 5× the usual.",
      "cites": [
        "views:en:Grand_Theft_Auto_VI:2026-11-10",
        "views:en:Grand_Theft_Auto_VI:prior"
      ]
    },
    {
      "t": "2026-11-10T00:00:44Z",
      "text": "The article is read in 11 languages, and after English, Russian has the most readers, at 8,915.",
      "cites": [
        "views:ru:Grand_Theft_Auto_VI:2026-11-10",
        "views:en:Grand_Theft_Auto_VI:2026-11-10"
      ]
    },
    {
      "t": "2026-11-10T00:00:51Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, though a language is not a country.",
      "cites": [
        "views:ru:Grand_Theft_Auto_VI:2026-11-10",
