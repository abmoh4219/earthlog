    {
      "t": "2026-11-10T00:00:01Z",
      "text": "Venezuela's National Assembly unanimously approved an electricity law reform allowing private firms and joint ventures to invest in the sector, controlled by the government since 2007.",
      "cites": [
        "wiki:2026-11-10:5"
      ]
    },
    {
      "t": "2026-11-10T00:00:08Z",
      "text": "Venezuela has experienced a marked deficit in the generation of electrical energy.",
      "cites": [
        "wiki:rev:1385204838:0"
      ]
    },
    {
      "t": "2026-11-10T00:00:15Z",
      "text": "According to Wikipedia's article on the energy crisis, rationing would be accentuated in the Guiana Shield, eastern Venezuela, and the Central-Falcón zone.",
      "cites": [
        "wiki:rev:1385204838:67"
      ]
    },
    {
      "t": "2026-11-10T00:00:25Z",
      "text": "Consumer inflation in Venezuela stood at 254.9% in 2016.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:VE"
      ]
    },
    {
      "t": "2026-11-10T00:00:33Z",
      "text": "In 2025 the economy grew 1.6%, and unemployment stood at 5.3%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:VE",
        "wb:SL.UEM.TOTL.ZS:VE"
      ]
    },
    {
      "t": "2026-11-10T00:00:43Z",
      "text": "This story was reported by AFP via RFI.",
      "cites": [
        "wiki:2026-11-10:5"
      ]
    },
    {
      "t": "2026-11-10T00:00:51Z",
