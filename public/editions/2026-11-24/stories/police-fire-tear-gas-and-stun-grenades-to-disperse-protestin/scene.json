  "beats": [
    {
      "t": "2026-11-24T00:00:01Z",
      "text": "Police have fired tear gas and stun grenades to disperse garment workers protesting across Gazipur, Savar, and Ashulia, Bangladesh, where production has halted at 481 factories amid minimum wage disputes.",
      "cites": [
        "wiki:2026-11-24:3"
      ]
    },
    {
      "t": "2026-11-24T00:00:08Z",
      "text": "The protests began in August 2026, and escalated in late October and early November 2026 in the industrial areas of Ashulia, Gazipur and Dhaka.",
      "cites": [
        "wiki:rev:1387373623:1"
      ]
    },
    {
      "t": "2026-11-24T00:00:15Z",
      "text": "Ready-made garment workers have staged a series of labour demonstrations, demanding that the sector's minimum monthly wage rise from ৳12,500 (US$100) to ৳30,000 (US$240).",
      "cites": [
        "wiki:rev:1387373623:0"
      ]
    },
    {
      "t": "2026-11-24T00:00:25Z",
      "text": "Inflation in Bangladesh was 8.8% in 2025, down from 10.5% in 2024.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:BD"
      ]
    },
    {
      "t": "2026-11-24T00:00:33Z",
      "text": "The economy grew 3.5% in 2025, while unemployment stood at 3.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:BD",
        "wb:SL.UEM.TOTL.ZS:BD"
      ]
    },
    {
      "t": "2026-11-24T00:00:43Z",
      "text": "Across South Asia, Bangladesh's 8.8% inflation compares with a median of 2.7%, and Bangladesh has the highest figure in the region.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:south-asia"
      ]
    },
    {
      "t": "2026-11-24T00:00:57Z",
      "text": "The report was published by The Business Standard.",
      "cites": [
        "wiki:2026-11-24:3"
      ]
    },
    {
      "t": "2026-11-24T00:01:05Z",
      "text": "Sources include Wikipedia, Wikimedia pageviews, Wikidata and World Bank Open Data (World Development Indicators), and each caption links to the evidence it rests on.",
