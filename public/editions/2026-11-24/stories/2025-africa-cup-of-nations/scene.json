  "beats": [
    {
      "t": "2026-11-24T00:00:01Z",
      "text": "According to the Court of Arbitration for Sport, Senegal's 1–0 victory in the 2025 Africa Cup of Nations final was restored, reversing the Confederation of African Football's decision to overturn it.",
      "cites": [
        "wiki:2026-11-24:11"
      ]
    },
    {
      "t": "2026-11-24T00:00:08Z",
      "text": "On 24 November 2026, the Court of Arbitration for Sport ruled in favour of Senegal after their appeal, reinstating them as the winners of the tournament.",
      "cites": [
        "wiki:rev:1387635276:6"
      ]
    },
    {
      "t": "2026-11-24T00:00:15Z",
      "text": "The 2025 Africa Cup of Nations was the 35th edition of the tournament, a biennial football competition between the men's national teams of the Confederation of African Football.",
      "cites": [
        "wiki:rev:1387635276:0"
      ]
    },
    {
      "t": "2026-11-24T00:00:25Z",
      "text": "The story was reported by AP and The Guardian.",
      "cites": [
        "wiki:2026-11-24:11"
      ]
    },
    {
      "t": "2026-11-24T00:00:33Z",
      "text": "Sky News headlined the story, “Morocco 'astonished' at decision to restore Senegal as Africa Cup of Nations champions.”",
      "cites": [
        "news:sky:cffcdf4bfb25"
      ]
    },
    {
      "t": "2026-11-24T00:00:39Z",
      "text": "Al Jazeera headlined it, “Senegal reinstated as 2025 Africa Cup of Nations winners over Morocco.”",
      "cites": [
        "news:aljazeera:12816d6f81aa"
      ]
    },
    {
      "t": "2026-11-24T00:00:45Z",
      "text": "France 24 headlined it more briefly, “Senegal reinstated as 2025 Africa Cup of Nations winners.”",
      "cites": [
        "news:france24:c447fcadc019"
      ]
    },
    {
      "t": "2026-11-24T00:00:54Z",
      "text": "The sources for this explainer are Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
