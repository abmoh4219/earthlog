  "beats": [
    {
      "t": "2026-11-24T00:00:01Z",
      "text": "Pope Francis's diaries reveal a spiritual crisis, including accounts of seeing the 'Devil', DW reports.",
      "cites": [
        "news:dw:d366e3ee18f0"
      ]
    },
    {
      "t": "2026-11-24T00:00:08Z",
      "text": "He set himself apart from other popes in upholding the Church's departure from the Tridentine Mass, which had been only loosely enforced by both predecessors whose reigns came after the Second Vatican Council reforms.",
      "cites": [
        "wiki:rev:1387631397:521"
      ]
    },
    {
      "t": "2026-11-24T00:00:15Z",
      "text": "Pope Francis, born Jorge Mario Bergoglio on 17 December 1936, was head of the Catholic Church and sovereign of Vatican City from his election in 2013 until his death on 21 April 2025.",
      "cites": [
        "wiki:rev:1387631397:0"
      ]
    },
    {
      "t": "2026-11-24T00:00:25Z",
      "text": "Pope Francis was born on 17 December 1936 in Flores, Buenos Aires.",
      "cites": [
        "wd:Q450675:P569",
        "wd:Q450675:P19"
      ]
    },
    {
      "t": "2026-11-24T00:00:33Z",
      "text": "He was educated at several institutions, including the Facultades de Filosofía y Teología de San Miguel, the University of Buenos Aires, the Inmaculada Concepción Seminary and 2 more.",
      "cites": [
        "wd:Q450675:P69:Q16935366",
        "wd:Q450675:P69:Q194223",
        "wd:Q450675:P69:Q16911644",
        "wd:Q450675:P69:Q16827357",
        "wd:Q450675:P69:Q895645"
      ]
    },
    {
      "t": "2026-11-24T00:00:38Z",
      "text": "He worked in Buenos Aires, Rome and Vatican City.",
      "cites": [
        "wd:Q450675:P937:Q1486",
        "wd:Q450675:P937:Q220",
        "wd:Q450675:P937:Q237"
      ]
    },
    {
      "t": "2026-11-24T00:00:44Z",
      "text": "Wikidata lists 16 awards, among them Sexist Man Alive (2021) and Presidential Medal of Freedom (2025).",
      "cites": [
        "wd:Q450675:P166:Q207826",
        "wd:Q450675:P166:Q15279719"
      ]
    },
    {
      "t": "2026-11-24T00:00:50Z",
      "text": "Wikidata also lists Ad charisma tuendum as a notable work.",
      "cites": [
        "wd:Q450675:P800:Q113374942"
      ]
    },
    {
      "t": "2026-11-24T00:01:12Z",
      "text": "BBC News headlined its report, \"Pope Francis' diary reveals claims he saw the devil three times.\"",
      "cites": [
        "news:bbc:65d520904cb1"
      ]
    },
    {
      "t": "2026-11-24T00:01:19Z",
      "text": "DW headlined its report, \"Pope Francis diaries recount spiritual crisis, him seeing the 'Devil'.\"",
      "cites": [
        "news:dw:d366e3ee18f0"
      ]
    },
    {
      "t": "2026-11-24T00:01:28Z",
      "text": "This explainer draws on BBC News and DW reporting, Wikipedia articles, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
      "cites": [
