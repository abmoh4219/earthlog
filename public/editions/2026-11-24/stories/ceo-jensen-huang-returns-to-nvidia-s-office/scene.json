  "beats": [
    {
      "t": "2026-11-24T00:00:01Z",
      "text": "Al Jazeera reports that the US added Megaspeed to its trade blacklist as Nvidia’s Huang returned as CEO.",
      "cites": [
        "news:aljazeera:e4cdea36ea5e"
      ]
    },
    {
      "t": "2026-11-24T00:00:08Z",
      "text": "The Board of Directors reinstated Huang as CEO and president on November 23, 2026.",
      "cites": [
        "wiki:rev:1387598735:94"
      ]
    },
    {
      "t": "2026-11-24T00:00:15Z",
      "text": "Nvidia is an American multinational technology company headquartered in Santa Clara, California.",
      "cites": [
        "wiki:rev:1387598735:0"
      ]
    },
    {
      "t": "2026-11-24T00:00:25Z",
      "text": "Nvidia’s headquarters are in Santa Clara, in the United States.",
      "cites": [
        "wd:Q182477:P159"
      ]
    },
    {
      "t": "2026-11-24T00:00:33Z",
      "text": "Jensen Huang, Chris Malachowsky and Curtis Priem founded Nvidia in 1993, and Huang is its chief executive.",
      "cites": [
        "wd:Q182477:P571",
        "wd:Q182477:P112",
        "wd:Q182477:P169"
      ]
    },
    {
      "t": "2026-11-24T00:00:43Z",
      "text": "Revenue rose from $4.1 billion in 2007 to $215.9 billion in 2025.",
      "cites": [
        "wd:Q182477:P2139:series"
      ]
    },
    {
      "t": "2026-11-24T00:00:50Z",
      "text": "Staff grew from 11,528 in 2018 to 42,000 in 2026.",
      "cites": [
        "wd:Q182477:P1128:series"
      ]
    },
    {
      "t": "2026-11-24T00:00:59Z",
      "text": "Records list Nvidia Ltd., Icera and 3 others among the companies it owns.",
      "cites": [
        "wd:Q182477:P355:Q29000344",
        "wd:Q182477:P355:Q5985959",
        "wd:Q182477:P355:Q6817432",
        "wd:Q182477:P355:Q6813052",
        "wd:Q182477:P1830:Q392357"
      ]
    },
    {
      "t": "2026-11-24T00:01:08Z",
      "text": "In the 14 days to 24 November 2026, 220 Hacker News stories had Nvidia in the title.",
      "cites": [
        "hn:2026-11-24:Q182477"
      ]
    },
    {
      "t": "2026-11-24T00:01:26Z",
      "text": "Al Jazeera headlined its story “US adds Megaspeed to trade blacklist as Nvidia’s Huang returns as CEO”.",
      "cites": [
        "news:aljazeera:e4cdea36ea5e"
      ]
    },
    {
      "t": "2026-11-24T00:01:32Z",
      "text": "BBC News ran the headline “Cheers and applause as Jensen Huang returns to Nvidia office”.",
      "cites": [
        "news:bbc:b0b4c3a9109d"
      ]
    },
    {
      "t": "2026-11-24T00:01:38Z",
      "text": "The Guardian headlined its piece “US adds Megaspeed, AI firm at center of Nvidia scandal, to trade blacklist”.",
      "cites": [
        "news:guardian:2ef56a355d6b"
      ]
    },
    {
      "t": "2026-11-24T00:01:47Z",
      "text": "Sources include Al Jazeera, BBC News, The Guardian, France 24, DW, Wikipedia, Wikimedia pageviews, Wikidata and Hacker News via the Algolia search API.",
      "cites": [
        "wiki:rev:1387598735:94",
        "views:en:Nvidia:30d",
        "wd:Q182477:P571",
        "hn:2026-11-24:Q182477"
      ]
    },
    {
      "t": "2026-11-24T00:01:48Z",
      "text": "Every caption links to the evidence it rests on.",
      "cites": [
        "wiki:rev:1387598735:94"
      ]
