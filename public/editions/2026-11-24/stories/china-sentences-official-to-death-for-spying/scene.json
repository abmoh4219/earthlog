  "beats": [
    {
      "t": "2026-11-24T00:00:01Z",
      "text": "Sky News reports that China has sentenced an official to death for spying.",
      "cites": [
        "news:sky:1fededbc1c5f"
      ]
    },
    {
      "t": "2026-11-24T00:00:09Z",
      "text": "The story is also reported by The Guardian and DW.",
      "cites": [
        "news:guardian:fd3c944f0667",
        "news:dw:388878bff1dd"
      ]
    },
    {
      "t": "2026-11-24T00:00:18Z",
      "text": "Inflation in China was 0.1% in 2025, down from 2.4% in 2020.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:CN"
      ]
    },
    {
      "t": "2026-11-24T00:00:26Z",
      "text": "The economy grew 5.0% in 2025, and unemployment stood at 4.6%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:CN",
        "wb:SL.UEM.TOTL.ZS:CN"
      ]
    },
    {
      "t": "2026-11-24T00:00:36Z",
      "text": "Across East Asia & Pacific, China's 0.1% inflation compares with a median of 2.1%, while Mongolia has the highest at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-24T00:00:50Z",
      "text": "On 17 November, Canada and China agreed to further tariff reductions after talks between Canadian prime minister Mark Carney and Chinese leader Xi Jinping before the APEC summit in Shenzhen.",
      "cites": [
        "wiki:2026-11-17:9"
      ]
    },
    {
      "t": "2026-11-24T00:00:55Z",
      "text": "On 23 November, Nvidia reinstated Jensen Huang as president and chief executive officer.",
      "cites": [
        "wiki:2026-11-23:5"
      ]
    },
    {
      "t": "2026-11-24T00:01:00Z",
      "text": "He had resigned less than two weeks earlier, following revelations of an affair with Alice Huang, who is suspected by U.S. intelligence of spying for China.",
      "cites": [
        "wiki:2026-11-23:5"
      ]
    },
    {
      "t": "2026-11-24T00:01:06Z",
      "text": "China, officially the People's Republic of China (PRC), is a country in East Asia.",
      "cites": [
        "wiki:rev:1386921412:0"
      ]
    },
    {
      "t": "2026-11-24T00:01:17Z",
      "text": "The Guardian headlined it: “China sentences official to death for spying for foreign country”.",
      "cites": [
        "news:guardian:fd3c944f0667"
      ]
    },
    {
      "t": "2026-11-24T00:01:23Z",
      "text": "DW headlined it: “Chinese official gets death sentence in spy case, report says”.",
      "cites": [
        "news:dw:388878bff1dd"
      ]
    },
    {
      "t": "2026-11-24T00:01:29Z",
      "text": "Sky News headlined it: “China 'sentences official to death for spying'”.",
      "cites": [
        "news:sky:1fededbc1c5f"
      ]
    },
    {
      "t": "2026-11-24T00:01:38Z",
      "text": "Sources: 3 outlets, Wikipedia articles, Wikimedia pageviews, Wikidata, and Wikipedia current events for 2026 November 17 and 2026 November 23; each caption links to its evidence.",
      "cites": [
