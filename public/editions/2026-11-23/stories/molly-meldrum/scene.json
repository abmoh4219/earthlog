  "beats": [
    {
      "t": "2026-11-23T00:00:01Z",
      "text": "Molly Meldrum died at the Epworth Hospital in Richmond on the morning of 23 November 2026, at the age of 83.",
      "cites": [
        "wiki:rev:1387464009:223"
      ]
    },
    {
      "t": "2026-11-23T00:00:08Z",
      "text": "He became widely recognised for his Stetson hats, which he regularly wore in public from the 1980s, and which were commonly mistaken for Akubra hats.",
      "cites": [
        "wiki:rev:1387464009:2"
      ]
    },
    {
      "t": "2026-11-23T00:00:15Z",
      "text": "Ian Alexander \"Molly\" Meldrum, born 29 January 1943, was an Australian television presenter, music critic, journalist, record producer and musical businessman.",
      "cites": [
        "wiki:rev:1387464009:0"
      ]
    },
    {
      "t": "2026-11-23T00:00:25Z",
      "text": "Meldrum was born on 29 January 1943 in Orbost.",
      "cites": [
        "wd:Q6896637:P569",
        "wd:Q6896637:P19"
      ]
    },
    {
      "t": "2026-11-23T00:00:33Z",
      "text": "He worked for the Seven Network, the Australian Broadcasting Corporation and the Nine Network.",
      "cites": [
        "wd:Q6896637:P108:Q908659",
        "wd:Q6896637:P108:Q781365",
        "wd:Q6896637:P108:Q1432195"
      ]
    },
    {
      "t": "2026-11-23T00:00:43Z",
      "text": "His one award on record is Member of the Order of Australia, received in 1986.",
      "cites": [
        "wd:Q6896637:P166:Q9678710"
      ]
    },
    {
      "t": "2026-11-23T00:01:07Z",
      "text": "112,186 people read his Wikipedia article on 23 November 2026, about 837 times the usual daily count.",
      "cites": [
        "views:en:Molly_Meldrum:2026-11-23",
        "views:en:Molly_Meldrum:prior"
      ]
    },
    {
      "t": "2026-11-23T00:01:19Z",
