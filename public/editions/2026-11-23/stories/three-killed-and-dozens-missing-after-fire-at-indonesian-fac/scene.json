  "beats": [
    {
      "t": "2026-11-23T00:00:01Z",
      "text": "According to Al Jazeera, Indonesia confirmed 24 killed in a candy factory fire as the search continued.",
      "cites": [
        "news:aljazeera:d404bacc5dcd"
      ]
    },
    {
      "t": "2026-11-23T00:00:09Z",
      "text": "The Guardian and Sky News also reported the fire, with dozens still missing.",
      "cites": [
        "news:guardian:b1fdd3d9246a",
        "news:sky:3290979445b3"
      ]
    },
    {
      "t": "2026-11-23T00:00:18Z",
      "text": "Inflation in Indonesia fell to 1.9% in 2025, from 4.2% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:ID"
      ]
    },
    {
      "t": "2026-11-23T00:00:26Z",
      "text": "The economy grew 5.1% in 2025, and unemployment stood at 3.2%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:ID",
        "wb:SL.UEM.TOTL.ZS:ID"
      ]
    },
    {
      "t": "2026-11-23T00:00:36Z",
      "text": "In East Asia and Pacific, Indonesia's 1.9% inflation compares with a median of 2.1%, while Mongolia has the highest rate at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-23T00:00:50Z",
      "text": "On 21 November, Indonesia and the European Union signed trade and investment agreements that will lift 98.5% of tariffs on EU goods.",
      "cites": [
        "wiki:2026-11-21:10"
      ]
    },
    {
      "t": "2026-11-23T00:00:57Z",
      "text": "On 22 November, according to Wikipedia's current events log, a fire at a confectionery factory in Serang Regency, Banten, killed at least three people, left 36 others missing, and injured four.",
      "cites": [
        "wiki:2026-11-22:9"
      ]
    },
    {
      "t": "2026-11-23T00:01:06Z",
      "text": "Indonesia, officially the Republic of Indonesia, is a country in Southeast Asia and Oceania, lying between the Indian and Pacific oceans.",
      "cites": [
        "wiki:rev:1387335545:0"
      ]
    },
    {
      "t": "2026-11-23T00:01:17Z",
      "text": "Al Jazeera headlined its report “Indonesia confirms 24 killed in candy factory fire as search continues”.",
      "cites": [
        "news:aljazeera:d404bacc5dcd"
      ]
    },
    {
      "t": "2026-11-23T00:01:23Z",
      "text": "The Guardian's headline read “At least 24 killed and dozens missing in confectionery factory fire in Indonesia”.",
      "cites": [
        "news:guardian:b1fdd3d9246a"
      ]
    },
    {
      "t": "2026-11-23T00:01:29Z",
      "text": "Sky News ran the headline “Deadly fire at confectionery factory kills 24 as rescuers search for dozens still missing”.",
      "cites": [
        "news:sky:3290979445b3"
      ]
    },
    {
      "t": "2026-11-23T00:01:38Z",
      "text": "This story draws on 3 outlets, Wikipedia articles, Wikimedia pageviews, Wikidata, and Wikipedia current events pages for 21 and 22 November 2026.",
      "cites": [
        "wiki:rev:1387335545:0",
        "views:en:Indonesia:30d",
        "wd:Q252:P571",
        "wiki:2026-11-21:10",
        "wiki:2026-11-22:9"
      ]
    }
  ],
