  "beats": [
    {
      "t": "2026-11-23T00:00:01Z",
      "text": "FIFA confirmed Costa Rica, Jamaica, Mexico, and the United States as joint hosts of the 2031 Women's World Cup, while England, Northern Ireland, Scotland, and Wales will jointly host the 2035 tournament.",
      "cites": [
        "wiki:2026-11-23:14"
      ]
    },
    {
      "t": "2026-11-23T00:00:08Z",
      "text": "The announcement came on November 23, 2026, in Zurich, during the tenth extraordinary FIFA Congress.",
      "cites": [
        "wiki:rev:1387353461:15"
      ]
    },
    {
      "t": "2026-11-23T00:00:15Z",
      "text": "The bidding process is the procedure FIFA uses to select the hosts for the 2031 and 2035 Women's World Cups.",
      "cites": [
        "wiki:rev:1387353461:0"
      ]
    },
    {
      "t": "2026-11-23T00:00:25Z",
      "text": "The reports place the announcement at FIFA in Switzerland.",
      "cites": [
        "wiki:2026-11-23:14"
      ]
    },
    {
      "t": "2026-11-23T00:00:33Z",
      "text": "The Mexican Football Federation and the United States Soccer Federation are also named in the reports.",
      "cites": [
        "wiki:2026-11-23:14"
      ]
    },
    {
      "t": "2026-11-23T00:00:42Z",
      "text": "The story was reported by AFP.",
      "cites": [
        "wiki:2026-11-23:14"
      ]
    },
    {
      "t": "2026-11-23T00:00:50Z",
      "text": "DW headlined the story: “US and UK to host Women's World Cups in 2031 and 2035”.",
      "cites": [
        "news:dw:81630f151694"
      ]
    },
    {
      "t": "2026-11-23T00:01:01Z",
