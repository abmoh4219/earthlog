  "beats": [
    {
      "t": "2026-11-23T00:00:01Z",
      "text": "According to Al Jazeera, Zelenskyy says Ukraine was behind drone attacks on Russian ships near Libya.",
      "cites": [
        "news:aljazeera:6c375e03b3e6"
      ]
    },
    {
      "t": "2026-11-23T00:00:09Z",
      "text": "France 24, AllAfrica, DW, NPR, BBC News and The Guardian also reported the story, with The Guardian stating that Ukraine confirms it used naval drones to strike two Russian ships off Libya.",
      "cites": [
        "news:france24:3314f31f0d59",
        "news:allafrica:6c417e832b50",
        "news:dw:bfcd59f235fe",
        "news:npr:af520c61c8b0",
        "news:bbc:abd87581214c",
        "news:guardian:4b7fad258a93"
      ]
    },
    {
      "t": "2026-11-23T00:00:18Z",
      "text": "Inflation in Ukraine was 12.7% in 2025, down from 20.2% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:UA"
      ]
    },
    {
      "t": "2026-11-23T00:00:26Z",
      "text": "The economy grew 1.8% in 2025, and unemployment stood at 9.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:UA",
        "wb:SL.UEM.TOTL.ZS:UA"
      ]
    },
    {
      "t": "2026-11-23T00:00:36Z",
      "text": "Across Europe and Central Asia, Ukraine's 12.7% compares with a median of 3.8%, and Turkey has the highest rate at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-23T00:00:50Z",
      "text": "On 16 November, the Crimean Bridge was struck by a Ukrainian kamikaze drone, damaging the structure and prompting Russian authorities to close vehicle traffic.",
      "cites": [
        "wiki:2026-11-16:1"
      ]
    },
    {
      "t": "2026-11-23T00:01:00Z",
      "text": "On 22 November, according to Wikipedia's current events log, several people were killed and at least 10 injured when a Ukrainian naval drone struck the Russian corvette Merkury at Benghazi, Libya.",
      "cites": [
        "wiki:2026-11-22:2"
      ]
    },
    {
      "t": "2026-11-23T00:01:12Z",
      "text": "Ukraine is the second-largest country in Europe after Russia, which borders it to the east and northeast.",
      "cites": [
        "wiki:rev:1386666930:0"
      ]
    },
    {
      "t": "2026-11-23T00:01:23Z",
      "text": "France 24 headlined its report, 'Live: Zelensky confirms Ukraine's military struck Russian ships in Libyan waters.'",
      "cites": [
        "news:france24:3314f31f0d59"
      ]
    },
    {
      "t": "2026-11-23T00:01:29Z",
      "text": "AllAfrica's headline read, 'Libya: Suspected Drone Attack Hits Russian Warship in Benghazi.'",
      "cites": [
        "news:allafrica:6c417e832b50"
      ]
    },
    {
      "t": "2026-11-23T00:01:35Z",
      "text": "Al Jazeera's headline was, 'Zelenskyy says Ukraine behind drone attacks on Russian ships near Libya.'",
      "cites": [
        "news:aljazeera:6c375e03b3e6"
      ]
    },
    {
      "t": "2026-11-23T00:01:44Z",
      "text": "This explainer draws on 7 outlets, Wikipedia articles, Wikimedia pageviews and Wikidata, including the Portal:Current events pages for 16 and 18 November 2026.",
      "cites": [
        "wiki:rev:1386666930:0",
        "views:en:Ukraine:30d",
        "wd:Q212:P571",
        "wiki:2026-11-16:1",
        "wiki:2026-11-18:1"
      ]
    }
  ],
