  "beats": [
    {
      "t": "2026-11-23T00:00:01Z",
      "text": "Nvidia reinstated Jensen Huang as president and chief executive officer less than two weeks after he resigned following revelations of an affair with Alice Huang.",
      "cites": [
        "wiki:2026-11-23:5"
      ]
    },
    {
      "t": "2026-11-23T00:00:08Z",
      "text": "On November 23, 2026, Huang was reinstated as president and CEO of Nvidia, and U.S. intelligence suspects Alice Huang of spying for China.",
      "cites": [
        "wiki:rev:1387427318:99",
        "wiki:2026-11-23:5"
      ]
    },
    {
      "t": "2026-11-23T00:00:15Z",
      "text": "Huang is a Taiwanese and American electrical engineer and business executive, born February 17, 1963, and the co-founder, president, and CEO of Nvidia.",
      "cites": [
        "wiki:rev:1387427318:0"
      ]
    },
    {
      "t": "2026-11-23T00:00:25Z",
      "text": "Huang was born on 17 February 1963 in Taipei.",
      "cites": [
        "wd:Q305177:P569",
        "wd:Q305177:P19"
      ]
    },
    {
      "t": "2026-11-23T00:00:33Z",
      "text": "Huang was educated at Stanford University, Aloha High School, Oneida Baptist Institute and 2 more.",
      "cites": [
        "wd:Q305177:P69:Q41506",
        "wd:Q305177:P69:Q4734192",
        "wd:Q305177:P69:Q7093656",
        "wd:Q305177:P69:Q7375693",
        "wd:Q305177:P69:Q861888"
      ]
    },
    {
      "t": "2026-11-23T00:00:39Z",
      "text": "Records also show that he worked in Los Altos.",
      "cites": [
        "wd:Q305177:P937:Q864124"
      ]
    },
    {
      "t": "2026-11-23T00:00:47Z",
      "text": "6 awards are on record, among them the Queen Elizabeth Prize for Engineering (2025) and the National Medal of Science (2026).",
      "cites": [
        "wd:Q305177:P166:Q4273323",
        "wd:Q305177:P166:Q737051"
      ]
    },
    {
      "t": "2026-11-23T00:00:57Z",
      "text": "Taipei is also named in the reports.",
      "cites": [
        "wiki:2026-11-23:5"
      ]
    },
    {
      "t": "2026-11-23T00:01:06Z",
      "text": "English Wikipedia recorded 234,343 readers of the article on 23 November 2026, about 30 times the usual daily figure.",
      "cites": [
        "views:en:Jensen_Huang:2026-11-23",
        "views:en:Jensen_Huang:prior"
      ]
    },
    {
      "t": "2026-11-23T00:01:13Z",
      "text": "The article was read in 7 languages, and after English, the most readers were in Chinese, with 34,567.",
      "cites": [
        "views:en:Jensen_Huang:2026-11-23",
        "views:zh:黃仁勳:2026-11-23"
      ]
    },
    {
      "t": "2026-11-23T00:01:20Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:zh:黃仁勳:2026-11-23",
        "views:de:Jensen_Huang:2026-11-23",
        "views:ru:Хуанг,_Дженсен:2026-11-23",
        "views:it:Jen-Hsun_Huang:2026-11-23",
        "views:pl:Jen-Hsun_Huang:2026-11-23",
        "views:ar:جنسن_هوانغ:2026-11-23"
      ]
    },
    {
      "t": "2026-11-23T00:01:30Z",
      "text": "CBS reported the story.",
      "cites": [
        "wiki:2026-11-23:5"
      ]
    },
    {
      "t": "2026-11-23T00:01:38Z",
      "text": "Al Jazeera headlined it: “Jensen Huang returns as NVIDIA CEO after intelligence scandal”.",
      "cites": [
        "news:aljazeera:e57ea6981e19"
      ]
    },
    {
      "t": "2026-11-23T00:01:44Z",
      "text": "France 24 headlined it: “Nvidia reinstates Jensen Huang as CEO”.",
      "cites": [
        "news:france24:4ac1fe94ae48"
      ]
    },
    {
      "t": "2026-11-23T00:01:50Z",
      "text": "DW headlined it: “Nvidia reinstates former CEO Jensen Huang despite China espionage scandal”.",
      "cites": [
        "news:dw:88659c21678b"
      ]
    },
    {
      "t": "2026-11-23T00:01:59Z",
      "text": "Sources include Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-23:5",
        "wiki:rev:1387427318:99",
