    {
      "t": "2026-11-23T00:00:01Z",
      "text": "Al Jazeera reports that Belgium's airports are set to shut down due to an anti-austerity strike.",
      "cites": [
        "news:aljazeera:53eb861453d7"
      ]
    },
    {
      "t": "2026-11-23T00:00:09Z",
      "text": "France 24 also reports on the story, describing tens of thousands of people taking to the streets in anti-austerity protests.",
      "cites": [
        "news:france24:3ab99c226df7"
      ]
    },
    {
      "t": "2026-11-23T00:00:18Z",
      "text": "Inflation in Belgium fell to 2.5% in 2025, down from 9.6% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:BE"
      ]
    },
    {
      "t": "2026-11-23T00:00:26Z",
      "text": "The economy grew 1.0% in 2025, and unemployment stood at 5.9%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:BE",
        "wb:SL.UEM.TOTL.ZS:BE"
      ]
    },
    {
      "t": "2026-11-23T00:00:36Z",
      "text": "Across Europe and Central Asia, Belgium's 2.5% compares with a median of 3.8%, while the highest is Turkey at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-23T00:00:50Z",
      "text": "Belgium, officially the Kingdom of Belgium, is a country in Northwestern Europe.",
      "cites": [
        "wiki:rev:1386655855:0"
      ]
    },
    {
      "t": "2026-11-23T00:01:01Z",
