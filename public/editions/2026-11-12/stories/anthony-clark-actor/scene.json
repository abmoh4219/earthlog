  "beats": [
    {
      "t": "2026-11-12T00:00:01Z",
      "text": "According to the Wikipedia article, Clark died of complications from pneumonia on November 10, 2026, at the age of 62.",
      "cites": [
        "wiki:rev:1385674487:18"
      ]
    },
    {
      "t": "2026-11-12T00:00:08Z",
      "text": "At age 12, his family moved to a tobacco farm 20 miles south in Gladys, Virginia, where his stepfather lived.",
      "cites": [
        "wiki:rev:1385674487:3"
      ]
    },
    {
      "t": "2026-11-12T00:00:15Z",
      "text": "Anthony Duane Clark, born April 4, 1964, was an American actor, producer and comedian, best known for starring in the CBS sitcom Yes, Dear as Greg Warner.",
      "cites": [
        "wiki:rev:1385674487:0"
      ]
    },
    {
      "t": "2026-11-12T00:00:25Z",
      "text": "Anthony Clark was born on 4 April 1964 in Lynchburg.",
      "cites": [
        "wd:Q4772274:P569",
        "wd:Q4772274:P19"
      ]
    },
    {
      "t": "2026-11-12T00:00:33Z",
      "text": "He was educated at Emerson College and Brookville High School.",
      "cites": [
        "wd:Q4772274:P69:Q1335573",
        "wd:Q4772274:P69:Q4975206"
      ]
    },
    {
      "t": "2026-11-12T00:00:43Z",
      "text": "Wikidata lists Yes, Dear among the notable works of Anthony Clark.",
      "cites": [
        "wd:Q4772274:P800:Q738447"
      ]
    },
    {
      "t": "2026-11-12T00:00:48Z",
      "text": "On 12 November 2026, 61,246 readers also opened the English Wikipedia article on Yes, Dear.",
      "cites": [
        "views:en:Yes,_Dear:2026-11-12"
      ]
    },
    {
      "t": "2026-11-12T00:00:57Z",
      "text": "On 12 November 2026, 374,893 readers opened the English article, about 2,245× its usual daily count.",
      "cites": [
        "views:en:Anthony_Clark_(actor):2026-11-12",
        "views:en:Anthony_Clark_(actor):prior"
      ]
    },
    {
      "t": "2026-11-12T00:01:04Z",
      "text": "The article appears in 7 languages, and after English, the largest readership was in Polish, with 1,336 readers.",
      "cites": [
        "views:en:Anthony_Clark_(actor):2026-11-12",
        "views:pl:Anthony_Clark_(aktor):2026-11-12"
      ]
    },
    {
      "t": "2026-11-12T00:01:11Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, though a language is not a country.",
      "cites": [
