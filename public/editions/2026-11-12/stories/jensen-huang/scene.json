  "beats": [
    {
      "t": "2026-11-12T00:00:01Z",
      "text": "Jensen Huang resigned as chief executive officer and president of Nvidia and left the company's board, following reports of two extramarital affairs, one involving a suspected Chinese intelligence agent.",
      "cites": [
        "wiki:2026-11-12:5"
      ]
    },
    {
      "t": "2026-11-12T00:00:08Z",
      "text": "Huang resigned as president and CEO on November 12, and Colette Kress, the company's CFO and executive vice president, became interim CEO.",
      "cites": [
        "wiki:rev:1385920815:91"
      ]
    },
    {
      "t": "2026-11-12T00:00:15Z",
      "text": "Jen-Hsun \"Jensen\" Huang, born February 17, 1963, is a Taiwanese and American electrical engineer and businessman.",
      "cites": [
        "wiki:rev:1385920815:0"
      ]
    },
    {
      "t": "2026-11-12T00:00:25Z",
      "text": "Huang was born on 17 February 1963 in Taipei.",
      "cites": [
        "wd:Q305177:P569",
        "wd:Q305177:P19"
      ]
    },
    {
      "t": "2026-11-12T00:00:33Z",
      "text": "Records show he was educated at Stanford University, Aloha High School, Oneida Baptist Institute and 2 more institutions.",
      "cites": [
        "wd:Q305177:P69:Q41506",
        "wd:Q305177:P69:Q4734192",
        "wd:Q305177:P69:Q7093656",
        "wd:Q305177:P69:Q7375693",
        "wd:Q305177:P69:Q861888"
      ]
    },
    {
      "t": "2026-11-12T00:00:39Z",
      "text": "His record also lists work in Los Altos.",
      "cites": [
        "wd:Q305177:P937:Q864124"
      ]
    },
    {
      "t": "2026-11-12T00:00:47Z",
      "text": "Wikidata lists 6 awards, among them the Queen Elizabeth Prize for Engineering (2025) and the National Medal of Science (2026).",
      "cites": [
        "wd:Q305177:P166:Q4273323",
        "wd:Q305177:P166:Q737051"
      ]
    },
    {
      "t": "2026-11-12T00:00:57Z",
      "text": "Readers also turned to Colette Kress with 463,931 readers, Nvidia with 366,417, and Alice Huang (executive) with 160,121.",
      "cites": [
        "views:en:Colette_Kress:2026-11-12",
        "views:en:Nvidia:2026-11-12",
        "views:en:Alice_Huang_(executive):2026-11-12"
      ]
    },
    {
      "t": "2026-11-12T00:01:06Z",
      "text": "English Wikipedia recorded 1,072,168 readers of Jensen Huang on 12 November 2026, about 145 times the usual daily count.",
      "cites": [
        "views:en:Jensen_Huang:2026-11-12",
        "views:en:Jensen_Huang:prior"
      ]
    },
    {
      "t": "2026-11-12T00:01:13Z",
      "text": "The article was read in 10 languages, and after English, the most readers were in Japanese, with 149,925.",
      "cites": [
        "views:en:Jensen_Huang:2026-11-12",
        "views:ja:ジェンスン・フアン:2026-11-12"
      ]
    },
    {
      "t": "2026-11-12T00:01:20Z",
      "text": "Each language is shown where it is mainly spoken, brighter for more readers, and a language is not the same as a country.",
      "cites": [
        "views:ja:ジェンスン・フアン:2026-11-12",
        "views:zh:黃仁勳:2026-11-12",
        "views:ru:Хуанг,_Дженсен:2026-11-12",
        "views:fr:Jensen_Huang:2026-11-12",
        "views:de:Jensen_Huang:2026-11-12",
        "views:es:Jensen_Huang:2026-11-12"
      ]
    },
    {
      "t": "2026-11-12T00:01:30Z",
      "text": "The story was reported by AFP and Reuters.",
      "cites": [
        "wiki:2026-11-12:5"
      ]
    },
    {
      "t": "2026-11-12T00:01:38Z",
      "text": "Sources are Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
