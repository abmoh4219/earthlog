  "beats": [
    {
      "t": "2026-11-12T00:00:01Z",
      "text": "Hicks died from an acute illness on November 11, 2026, at the age of 64.",
      "cites": [
        "wiki:rev:1385907272:89"
      ]
    },
    {
      "t": "2026-11-12T00:00:08Z",
      "text": "He was a lead announcer for Golf on NBC from 2000, and the lead play-by-play announcer for Notre Dame Football on NBC from 2013 to 2016 and again from 2024, covering 16 Olympic Games.",
      "cites": [
        "wiki:rev:1385907272:1"
      ]
    },
    {
      "t": "2026-11-12T00:00:15Z",
      "text": "John Daniel Hicks, born June 2, 1962, was an American sportscaster who worked for NBC Sports from 1992 until his death.",
      "cites": [
        "wiki:rev:1385907272:0"
      ]
    },
    {
      "t": "2026-11-12T00:00:25Z",
      "text": "Dan Hicks was born on 2 June 1962 in Tucson.",
      "cites": [
        "wd:Q5213677:P569",
        "wd:Q5213677:P19"
      ]
    },
    {
      "t": "2026-11-12T00:00:33Z",
      "text": "He was educated at the University of Arizona.",
      "cites": [
        "wd:Q5213677:P69:Q503419"
      ]
    },
    {
      "t": "2026-11-12T00:00:43Z",
      "text": "Dan Hicks died on 11 November 2026 in Connecticut, aged 64.",
      "cites": [
        "wd:Q5213677:P570",
        "wd:Q5213677:P20",
        "wd:Q5213677:P569"
      ]
    },
    {
      "t": "2026-11-12T00:00:51Z",
      "text": "Readers also turned to the article on Hannah Storm, which drew 127,755 readers.",
      "cites": [
        "views:en:Hannah_Storm:2026-11-12"
      ]
    },
    {
      "t": "2026-11-12T00:01:00Z",
      "text": "On 12 November 2026, 157,094 people read his article, about 2,213 times the usual daily level.",
      "cites": [
