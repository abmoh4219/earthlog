    {
      "t": "2026-11-03T00:00:00Z",
      "text": "To avoid conflicts with the U.S. midterm elections, scheduled to be held on November 3, 2026, Dancing with the Stars moved the air date of this episode to Monday, one day earlier.",
      "cites": [
        "wiki:rev:1383768245:111"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "Cynthia Erivo served as the guest judge for Disney Night.",
      "cites": [
        "wiki:rev:1383768245:26"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Season thirty-five of Dancing with the Stars premiered on ABC and Disney+ on September 15, 2026, and is scheduled to conclude on November 24, 2026.",
      "cites": [
        "wiki:rev:1383768245:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "On ABC and Disney+, hosted by Alfonso Ribeiro and Julianne Hough, judged by Derek Hough, Carrie Ann Inaba and Bruno Tonioli.",
      "cites": [
        "wiki:box:1383768245:network",
        "wiki:box:1383768245:hosts",
        "wiki:box:1383768245:judges"
      ]
    },
    {
      "t": "2026-11-03T00:00:36Z",
      "text": "20 of the people credited have a birthplace on record; 14 were born in the United States.",
      "cites": [
        "wd:Q1189327:P19",
        "wd:Q15955943:P19",
        "wd:Q16200956:P19",
        "wd:Q16206289:P19",
        "wd:Q210120:P19",
