        "wd:Q4979416:P19",
        "wd:Q70163947:P19",
        "wd:Q81878423:P19",
        "wd:Q95682845:P19"
      ]
    },
    {
      "t": "2026-11-03T00:00:45Z",
      "text": "Born further afield: Sharna Burgess in Wagga Wagga, Australia, Gleb Savchenko in Moscow, Russia and Sasha Farber in Russia.",
      "cites": [
        "wd:Q16200956:P19",
        "wd:Q21285529:P19",
        "wd:Q23418652:P19"
      ]
    },
    {
      "t": "2026-11-03T00:00:54Z",
      "text": "Readers also turned to Jenna Dewan (64,103).",
      "cites": [
        "views:en:Jenna_Dewan:2026-11-03"
      ]
    },
