  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "A commercial vessel is hit by an unidentified object in the waters of Musandam Governorate, Oman, killing an Indian crew member, while 13 others are rescued.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "On November 2, alongside what the U.S. military described as \"defensive strikes\" in the Strait of Hormuz, multiple explosions were reported on Iran's Qeshm Island.",
      "cites": [
        "wiki:rev:1383733327:263"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Shipping traffic through the Strait of Hormuz, a major maritime choke point for world energy trade, has been largely blocked by Iran since 28 February 2026…",
      "cites": [
        "wiki:rev:1383733327:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "On the map: Musandam Governorate, Oman, where the reports place it.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "On 28 October, the Dutch Title Transfer Facility (TTF) front-month natural gas futures contract briefly reached €100 per megawatt-hour, approximately three times its pre-war level, according to Reuters.",
      "cites": [
        "wiki:week:1383733327:424"
      ]
    },
    {
      "t": "2026-11-03T00:00:41Z",
      "text": "The Nakilat-operated LNG carrier \"Al Mayeda\" was hit by \"unidentified objects\" in the Persian Gulf on the evening of 30 October 2026.",
      "cites": [
        "wiki:week:1383733327:264"
      ]
    },
    {
      "t": "2026-11-03T00:00:49Z",
      "text": "Figures as the article records them, each attributed there to its sources: casualties, 24 seafarers; 1 port worker; injured, 35+.",
      "cites": [
        "wiki:box:1383733327:casualties",
        "wiki:box:1383733327:injured"
      ]
    },
    {
      "t": "2026-11-03T00:01:00Z",
      "text": "Also named in the reports: Strait of Hormuz.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:01:09Z",
      "text": "Reported by Reuters.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    }
  ],
