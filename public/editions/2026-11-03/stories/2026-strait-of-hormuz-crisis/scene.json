  "beats": [
    {
      "t": "2026-11-03T00:00:01Z",
      "text": "A commercial vessel was hit by an unidentified object in the waters of Musandam Governorate, Oman, killing an Indian crew member, while 13 others were rescued.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "On November 2, the U.S. military described its actions in the Strait of Hormuz as \"defensive strikes\", and multiple explosions were reported on Iran's Qeshm Island.",
      "cites": [
        "wiki:rev:1383733327:263"
      ]
    },
    {
      "t": "2026-11-03T00:00:15Z",
      "text": "Shipping through the Strait of Hormuz, a major maritime choke point for world energy trade, has been largely blocked by Iran since 28 February 2026.",
      "cites": [
        "wiki:rev:1383733327:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:25Z",
      "text": "On 27 October, the Persian Gulf Strait Authority said that vessels belonging to South Korean shipping company Sinokor would face legal action beginning on 1 November.",
      "cites": [
        "wiki:2026-10-27:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "On 30 October, Oman rescued 25 crew members from a burning Panamanian-flagged oil tanker in the Strait of Hormuz.",
      "cites": [
        "wiki:2026-10-30:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:41Z",
      "text": "The reports place the incident in the waters of Musandam Governorate, Oman.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:49Z",
      "text": "On 28 October, the Dutch TTF front-month natural gas futures contract briefly reached €100 per megawatt-hour, about three times its pre-war level, according to Reuters.",
      "cites": [
        "wiki:week:1383733327:424"
      ]
    },
    {
      "t": "2026-11-03T00:00:57Z",
      "text": "On the evening of 30 October 2026, the Nakilat-operated LNG carrier \"Al Mayeda\" was hit by \"unidentified objects\" in the Persian Gulf.",
      "cites": [
        "wiki:week:1383733327:264"
      ]
    },
    {
      "t": "2026-11-03T00:01:06Z",
      "text": "As the article records, casualties total 24 seafarers and 1 port worker, and injured are listed as 35+.",
      "cites": [
        "wiki:box:1383733327:casualties",
        "wiki:box:1383733327:injured"
      ]
    },
    {
      "t": "2026-11-03T00:01:17Z",
      "text": "The reports also name the Strait of Hormuz.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:01:26Z",
      "text": "The reporting is credited to Reuters.",
      "cites": [
        "wiki:2026-11-03:1"
      ]
    },
    {
      "t": "2026-11-03T00:01:34Z",
      "text": "Sources include Wikipedia current events, including Portal:Current events/2026 October 27, article revisions, pageview data and Wikidata, and every caption links to its evidence.",
      "cites": [
