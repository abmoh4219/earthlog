  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "Simmons and a 2028 fifth-round draft pick were traded to the Chicago Bears on October 29 in exchange for the Bears' 2027 and 2028 first-round selections and a 2027 fourth rounder.",
      "cites": [
        "wiki:rev:1383733529:111"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "In his Bears debut, on Monday Night Football against the reigning champion Seattle Seahawks, Simmons recorded a sack, six tackles, and a pass deflection as Chicago won 34–17.",
      "cites": [
        "wiki:rev:1383733529:112"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Jeffery Bernard Simmons Jr. (born July 28, 1997) is an American professional football defensive tackle for the Chicago Bears of the National Football League (NFL).",
      "cites": [
        "wiki:rev:1383733529:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "Jeffery Simmons was born on 28 July 1997 in LaSalle Parish.",
      "cites": [
        "wd:Q45146310:P569",
        "wd:Q45146310:P19"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "Played for 2 clubs: from Mississippi State Bulldogs football to Chicago Bears.",
      "cites": [
        "wd:Q45146310:P54:Q6879318",
        "wd:Q45146310:P54:Q205033"
      ]
    },
    {
      "t": "2026-11-03T00:00:37Z",
      "text": "Educated at Noxubee County High School.",
      "cites": [
        "wd:Q45146310:P69:Q48977020"
      ]
    },
    {
      "t": "2026-11-03T00:00:51Z",
      "text": "111,232 people read about it on 3 November 2026: about 251× the usual.",
      "cites": [
        "views:en:Jeffery_Simmons:2026-11-03",
        "views:en:Jeffery_Simmons:prior"
