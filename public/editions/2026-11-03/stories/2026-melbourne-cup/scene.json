  "beats": [
    {
      "t": "2026-11-03T00:00:01Z",
      "text": "The 2026 Melbourne Cup, known commercially as the 2026 Lexus Melbourne Cup, was the 166th running of the Melbourne Cup, an Australian thoroughbred horse race.",
      "cites": [
        "wiki:rev:1383838055:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:12Z",
      "text": "The race was run over 3200 m on 3 November 2026 at Melbourne's Flemington Racecourse.",
      "cites": [
        "wiki:rev:1383838055:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:25Z",
      "text": "The 2026 Melbourne Cup took place at Flemington Racecourse in Melbourne, Australia.",
      "cites": [
        "wiki:box:1383838055:venue"
      ]
    },
    {
      "t": "2026-11-03T00:00:33Z",
      "text": "Point Of Law won, ridden by Ethan Brown and trained by Ciaron Maher.",
      "cites": [
        "wiki:box:1383838055:winner",
        "wiki:box:1383838055:jockey",
        "wiki:box:1383838055:trainer"
      ]
    },
    {
      "t": "2026-11-03T00:00:41Z",
      "text": "Attendance was 97,112.",
      "cites": [
        "wiki:box:1383838055:attendance"
      ]
    },
    {
      "t": "2026-11-03T00:00:50Z",
      "text": "Zahrann and Juja Kibo, also trained by Ciaron Maher, finished second and third.",
      "cites": [
        "wiki:2026-11-03:13"
      ]
    },
    {
      "t": "2026-11-03T00:00:59Z",
      "text": "This summary draws on a sports report of the race.",
      "cites": [
        "wiki:2026-11-03:13"
      ]
    },
