    {
      "t": "2026-11-03T00:00:00Z",
      "text": "In thoroughbred racing, Point Of Law, trained by Ciaron Maher, wins the 2026 Melbourne Cup at Flemington Racecourse in Victoria, Australia. Zahrann and Juja Kibo, also trained by Maher…",
      "cites": [
        "wiki:2026-11-03:13"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "The race, ran over 3200 m, was held on 3 November 2026 at Melbourne's Flemington Racecourse.",
      "cites": [
        "wiki:rev:1383732467:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "The 2026 Melbourne Cup, known commercially as the 2026 Lexus Melbourne Cup, was the 166th running of the Melbourne Cup, an Australian thoroughbred horse race.",
      "cites": [
        "wiki:rev:1383732467:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "2026 Melbourne Cup took place at Flemington Racecourse, Melbourne, Australia.",
      "cites": [
        "wiki:box:1383732467:venue"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "Point Of Law won, ridden by Ethan Brown and trained by Ciaron Maher.",
      "cites": [
        "wiki:box:1383732467:winner",
        "wiki:box:1383732467:jockey",
        "wiki:box:1383732467:trainer"
      ]
    },
    {
      "t": "2026-11-03T00:00:41Z",
      "text": "97,112 people were there.",
      "cites": [
        "wiki:box:1383732467:attendance"
      ]
    },
    {
      "t": "2026-11-03T00:00:49Z",
      "text": "Also named in the reports: Victoria.",
      "cites": [
        "wiki:2026-11-03:13"
      ]
    },
    {
      "t": "2026-11-03T00:00:58Z",
      "text": "Reported by AFP.",
      "cites": [
        "wiki:2026-11-03:13"
      ]
