  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "The Reserve Bank of Australia raises its benchmark interest rate by 0.25 percentage points to 4.85%, its highest level since 2008…",
      "cites": [
        "wiki:2026-11-03:4"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "On November 3, oil prices fell following an announcement by U.S. President Donald Trump that the United States would no longer provide billions of dollars in annual military support to Israel.",
      "cites": [
        "wiki:rev:1383586478:48"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "The 2026 Iran war fuel crisis is a worldwide fuel crisis caused by the war between Iran and the U.S.-Israel coalition.",
      "cites": [
        "wiki:rev:1383586478:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "The decision came from the Reserve Bank of Australia, in Sydney.",
      "cites": [
        "wd:Q1506724:P159",
        "wiki:2026-11-03:4"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "Inflation in Australia was 2.9% in 2025, down from 6.6% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:AU"
      ]
    },
    {
      "t": "2026-11-03T00:00:41Z",
      "text": "The economy grew 1.4% in 2025; unemployment stood at 4.1%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:AU",
        "wb:SL.UEM.TOTL.ZS:AU"
      ]
    },
    {
      "t": "2026-11-03T00:00:50Z",
      "text": "Across East Asia & Pacific, Australia's 2.9% compares with a median of 2.1%; the highest is Mongolia at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-03T00:01:04Z",
      "text": "Reported by AFP via France 24.",
      "cites": [
        "wiki:2026-11-03:4"
      ]
    }
  ],
