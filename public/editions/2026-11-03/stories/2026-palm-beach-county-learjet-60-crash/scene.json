  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "On November 1, 2026, a privately owned Learjet 60 business jet crashed in Palm Beach County, Florida, United States.",
      "cites": [
        "wiki:rev:1383777197:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "John I. Leonard Community High School, a public high school located near the crash site, was closed on November 2 as emergency crews and investigators continued operations in the vicinity.",
      "cites": [
        "wiki:rev:1383777197:27"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "During a second press briefing on November 3, Chapman confirmed that the elevator had separated prior to impact.",
      "cites": [
        "wiki:rev:1383777197:40"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "It set out from Austin–Bergstrom International Airport, bound for North Eleuthera Airport.",
      "cites": [
        "wiki:box:1383777197:origin",
        "wiki:box:1383777197:destination"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "It came down about 1,760 km from Austin–Bergstrom International Airport in a straight line, with about 370 km still to go.",
      "cites": [
        "wiki:box:1383777197:origin",
        "wiki:box:1383777197:destination",
        "wiki:box:1383777197:coordinates"
      ]
    },
    {
      "t": "2026-11-03T00:00:39Z",
      "text": "Palm Beach County: crashed en route, in-flight structural failure; under investigation.",
      "cites": [
        "wiki:box:1383777197:summary",
        "wiki:box:1383777197:coordinates"
      ]
    },
    {
      "t": "2026-11-03T00:00:48Z",
      "text": "The aircraft was a Learjet 60, built by Bombardier Aerospace; the type first flew in 1990, operated by Aurora Aviation (dba Upper Jets).",
      "cites": [
        "wiki:box:1383777197:aircraft",
        "wd:Q1267393:P176",
        "wd:Q1267393:P606",
        "wiki:box:1383777197:operator"
      ]
    },
    {
      "t": "2026-11-03T00:00:57Z",
      "text": "All 9 people on board died: 7 passengers and 2 crew, according to the article.",
      "cites": [
        "wiki:box:1383777197:occupants",
        "wiki:box:1383777197:fatalities",
        "wiki:box:1383777197:passengers",
        "wiki:box:1383777197:crew",
        "wiki:box:1383777197:survivors"
      ]
    },
    {
      "t": "2026-11-03T00:01:06Z",
      "text": "On the ground: 1 injured.",
      "cites": [
        "wiki:box:1383777197:ground-injuries"
      ]
    },
    {
      "t": "2026-11-03T00:01:14Z",
      "text": "The aircraft departed Austin–Bergstrom International Airport at 10:37 EST (15:37 UTC).",
      "cites": [
        "wiki:timeline:1383777197:0"
      ]
    },
    {
      "t": "2026-11-03T00:01:22Z",
      "text": "At 12:48 EST (17:48 UTC), the first officer radioed a \"mayday\" call to ATC, reporting a deteriorating situation.",
      "cites": [
        "wiki:timeline:1383777197:1"
      ]
    },
    {
      "t": "2026-11-03T00:01:30Z",
      "text": "The Palm Beach County Sheriff's Office closed Military Trail near the impact site to facilitate the emergency response and investigation.",
      "cites": [
        "wiki:investigation:1383777197:0"
      ]
    },
    {
      "t": "2026-11-03T00:01:37Z",
      "text": "Thunderstorms were affecting the Palm Beach area around the time of the crash, with visibility ranging from 2 to 10 mi and surface wind gusts of 20 to 30 mph.",
      "cites": [
        "wiki:investigation:1383777197:1"
      ]
    },
    {
      "t": "2026-11-03T00:01:45Z",
      "text": "According to recorded air traffic control communications, the crew reported light clear icing and moderate turbulence while flying at approximately 35,000 ft, with altitude fluctuations of up to 700 ft.",
      "cites": [
        "wiki:investigation:1383777197:2"
      ]
    },
    {
      "t": "2026-11-03T00:01:52Z",
      "text": "Readers also turned to Learjet 60 (121,648).",
      "cites": [
        "views:en:Learjet_60:2026-11-03"
      ]
    },
    {
      "t": "2026-11-03T00:02:01Z",
      "text": "132,447 people read the article on 3 November 2026. It hadn't existed weeks before.",
      "cites": [
        "views:en:2026_Palm_Beach_County_Learjet_60_crash:2026-11-03",
        "views:en:2026_Palm_Beach_County_Learjet_60_crash:prior"
      ]
    },
    {
      "t": "2026-11-03T00:02:10Z",
      "text": "Read in 10 languages; after English, most in German (9,654).",
      "cites": [
        "views:en:2026_Palm_Beach_County_Learjet_60_crash:2026-11-03",
        "views:de:Flugzeugabsturz_am_1._November_2026_in_Palm_Beach:2026-11-03"
      ]
    }
  ],
