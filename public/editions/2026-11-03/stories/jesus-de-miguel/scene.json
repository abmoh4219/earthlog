      ]
    },
    {
      "t": "2026-11-03T00:00:27Z",
      "text": "Jesús de Miguel Alameda died on 3 November 2026 in Hospital Universitario Nuestra Señora de Candelaria, aged 30.",
      "cites": [
        "wd:Q116992476:P570",
        "wd:Q116992476:P20",
        "wd:Q116992476:P569"
      ]
    },
    {
