  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "In association football, CD Tenerife striker Jesús de Miguel dies following an in-game collision with FC Andorra goalkeeper Jesús Owono the previous day.",
      "cites": [
        "wiki:2026-11-03:12"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "On 2 November 2026, de Miguel suffered a blunt cardiac injury in a collision with FC Andorra goalkeeper Jesús Owono which caused him to go into cardiac arrest.",
      "cites": [
        "wiki:rev:1383757320:26"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Jesús de Miguel Alameda (21 September 1996 – 3 November 2026) was a Spanish professional footballer who played as a striker.",
      "cites": [
        "wiki:rev:1383757320:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "Jesús de Miguel Alameda was born on 21 September 1996 in Madrid.",
      "cites": [
        "wd:Q116992476:P569",
        "wd:Q116992476:P19"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "Played for 8 clubs from 2015 to 2026: from CD Leganés B to C.D. Tenerife.",
      "cites": [
        "wd:Q116992476:P54:Q9196665",
        "wd:Q116992476:P54:Q9008987",
        "wd:Q116992476:P54:Q108708",
        "wd:Q116992476:P54:Q4651246",
        "wd:Q116992476:P54:Q840620",
        "wd:Q116992476:P54:Q20278773",
        "wd:Q116992476:P54:Q743557",
        "wd:Q116992476:P54:Q216661"
      ]
    },
    {
      "t": "2026-11-03T00:00:42Z",
      "text": "Jesús de Miguel Alameda died on 3 November 2026 in Hospital Universitario Nuestra Señora de Candelaria, aged 30.",
      "cites": [
        "wd:Q116992476:P570",
        "wd:Q116992476:P20",
        "wd:Q116992476:P569"
      ]
    },
    {
      "t": "2026-11-03T00:00:50Z",
      "text": "Readers also turned to Jesús Owono (297,789), CD Tenerife (70,752).",
      "cites": [
        "views:en:Jesús_Owono:2026-11-03",
        "views:en:CD_Tenerife:2026-11-03"
      ]
    },
    {
      "t": "2026-11-03T00:00:59Z",
      "text": "585,060 people read about it on 3 November 2026. In the weeks before, almost nobody did: a median of 4 a day.",
