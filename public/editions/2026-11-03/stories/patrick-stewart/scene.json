  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "Stewart died at his home in Los Angeles on 28 October 2026, aged 86.",
      "cites": [
        "wiki:rev:1383723113:237"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "With a career spanning over 60 years on stage and screen, he received numerous accolades, including three Laurence Olivier Awards and a Grammy Award, as well as nominations for a Tony Award…",
      "cites": [
        "wiki:rev:1383723113:1"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Sir Patrick Stewart (13 July 1940 – 28 October 2026) was an English actor.",
      "cites": [
        "wiki:rev:1383723113:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "Patrick Stewart was born on 13 July 1940 in Mirfield.",
      "cites": [
        "wd:Q16296:P569",
        "wd:Q16296:P19"
      ]
    },
    {
      "t": "2026-11-03T00:00:32Z",
      "text": "Educated at Bristol Old Vic Theatre School, Crowlees Junior and Infant School and The Mirfield Free Grammar.",
      "cites": [
        "wd:Q16296:P69:Q608723",
        "wd:Q16296:P69:Q5189254",
        "wd:Q16296:P69:Q7751661"
      ]
    },
    {
      "t": "2026-11-03T00:00:38Z",
      "text": "Worked with University of Oxford and University of Huddersfield.",
      "cites": [
        "wd:Q16296:P108:Q34433",
        "wd:Q16296:P108:Q3056815"
      ]
    },
    {
      "t": "2026-11-03T00:00:44Z",
      "text": "8 awards on record, including Laurence Olivier Award for Best Actor in a Supporting Role (2009) and honorary doctorate of the Vrije Universiteit Brussel (2015).",
      "cites": [
        "wd:Q16296:P166:Q6500772",
        "wd:Q16296:P166:Q55139818"
      ]
    },
    {
      "t": "2026-11-03T00:00:51Z",
      "text": "Known for X-Men and Star Trek: The Next Generation.",
      "cites": [
        "wd:Q16296:P800:Q2006869",
        "wd:Q16296:P800:Q16290"
      ]
    },
    {
      "t": "2026-11-03T00:00:58Z",
      "text": "Patrick Stewart died on 28 October 2026 in Los Angeles, aged 86.",
      "cites": [
        "wd:Q16296:P570",
        "wd:Q16296:P20",
        "wd:Q16296:P569"
      ]
    },
    {
      "t": "2026-11-03T00:01:15Z",
      "text": "82,458 people read about it on 3 November 2026: about 21× the usual.",
      "cites": [
        "views:en:Patrick_Stewart:2026-11-03",
        "views:en:Patrick_Stewart:prior"
      ]
    }
