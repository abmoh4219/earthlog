  "beats": [
    {
      "t": "2026-11-03T00:00:01Z",
      "text": "According to the report, unidentified attackers ambushed a police convoy near Gidan-Giye village in Zamfara State, Nigeria, killing at least five police officers.",
      "cites": [
        "wiki:2026-11-03:2"
      ]
    },
    {
      "t": "2026-11-03T00:00:09Z",
      "text": "As the article records, the most impacted states are in Nigeria's Middle Belt, including Benue, Taraba and Plateau.",
      "cites": [
        "wiki:rev:1383141847:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:18Z",
      "text": "The reports place the ambush in Zamfara State, Nigeria.",
      "cites": [
        "wiki:2026-11-03:2"
      ]
    },
    {
      "t": "2026-11-03T00:00:26Z",
      "text": "The article lists three sides: Christians, Adara, Berom, Jukun, Tiv and Tarok farmers; Muslims, Fulani and Hausa herders; and the Nigerian Armed Forces with the Nigeria Police Force.",
      "cites": [
        "wiki:box:1383141847:side-1",
        "wiki:box:1383141847:side-2",
        "wiki:box:1383141847:side-3"
      ]
    },
    {
      "t": "2026-11-03T00:00:33Z",
      "text": "As the article records, the status is ongoing.",
      "cites": [
        "wiki:box:1383141847:status"
      ]
    },
    {
      "t": "2026-11-03T00:00:40Z",
      "text": "According to the article, casualties attributed to side 1 are 4,877–28,551 civilians killed, and casualties attributed to side 2 are 10,519 civilians killed.",
      "cites": [
        "wiki:box:1383141847:casualties-side-1-",
        "wiki:box:1383141847:casualties-side-2-"
      ]
    },
    {
      "t": "2026-11-03T00:00:49Z",
      "text": "The reports also name Nigeria.",
      "cites": [
        "wiki:2026-11-03:2"
      ]
    },
    {
      "t": "2026-11-03T00:00:58Z",
      "text": "The story is reported by Reuters.",
      "cites": [
        "wiki:2026-11-03:2"
      ]
    },
    {
      "t": "2026-11-03T00:01:06Z",
