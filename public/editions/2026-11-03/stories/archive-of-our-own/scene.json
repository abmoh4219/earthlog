  "beats": [
    {
      "t": "2026-11-03T00:00:01Z",
      "text": "On 29 October 2026, following a security incident, the site went down for maintenance first announced to last twelve hours.",
      "cites": [
        "wiki:rev:1383453548:21"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "The work was later extended to two to four weeks, and Rebecca Tushnet, representing AO3, assured users that no data was lost.",
      "cites": [
        "wiki:rev:1383453548:21",
        "wiki:rev:1383453548:22"
      ]
    },
    {
      "t": "2026-11-03T00:00:15Z",
      "text": "Archive of Our Own, or AO3, is a nonprofit, open-source repository for fanfiction and other fanworks contributed by users.",
      "cites": [
        "wiki:rev:1383453548:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:25Z",
      "text": "Archive of Our Own is run by the Organization for Transformative Works, based in Arlington County, United States.",
      "cites": [
        "wd:Q27764876:P137"
      ]
    },
    {
      "t": "2026-11-03T00:00:33Z",
      "text": "The site was founded in 2008 and is owned by the Organization for Transformative Works.",
      "cites": [
        "wd:Q27764876:P571",
        "wd:Q27764876:P127"
      ]
    },
    {
      "t": "2026-11-03T00:00:43Z",
      "text": "Over the two weeks to 3 November 2026, 6 Hacker News stories mentioned Archive of Our Own.",
      "cites": [
        "hn:2026-11-03:Q27764876"
      ]
    },
    {
      "t": "2026-11-03T00:00:52Z",
      "text": "On 3 November 2026, 85,012 people read the English article, about 60× the usual.",
      "cites": [
        "views:en:Archive_of_Our_Own:2026-11-03",
        "views:en:Archive_of_Our_Own:prior"
      ]
    },
    {
      "t": "2026-11-03T00:00:58Z",
      "text": "The article is read in 11 languages, and after English, German is the most read, with 762 readers.",
      "cites": [
        "views:en:Archive_of_Our_Own:2026-11-03",
        "views:de:Archive_of_Our_Own:2026-11-03"
      ]
    },
    {
      "t": "2026-11-03T00:01:04Z",
      "text": "On the globe, each language glows where it is mainly spoken, brighter for more readers; a language is not a country.",
      "cites": [
        "views:de:Archive_of_Our_Own:2026-11-03",
        "views:fr:Archive_of_Our_Own:2026-11-03",
