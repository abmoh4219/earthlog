  "beats": [
    {
      "t": "2026-11-03T00:00:00Z",
      "text": "On 3 November, special media screening took place across Mumbai.",
      "cites": [
        "wiki:rev:1383775061:108"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "The film crossed a further milestone on 3 November.",
      "cites": [
        "wiki:rev:1383775061:155"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Ramayana: Part 1 is a 2026 Indian Hindi-language epic mythological film directed by Nitesh Tiwari, who co-wrote the screenplay with Shridhar Raghavan.",
      "cites": [
        "wiki:rev:1383775061:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "Ramayana: Part 1 stars Ranbir Kapoor, Yash, Sai Pallavi and Sunny Deol among others; with music by Hans Zimmer and A. R. Rahman.",
      "cites": [
        "wiki:box:1383775061:starring",
        "wiki:box:1383775061:music"
      ]
    },
    {
      "t": "2026-11-03T00:00:33Z",
      "text": "Released: 27 October 2026 (Academy Museum), 5 November 2026 (worldwide).",
      "cites": [
        "wiki:box:1383775061:released"
      ]
    },
    {
      "t": "2026-11-03T00:00:42Z",
      "text": "On 30 April, the second schedule commenced in Mumbai.",
      "cites": [
        "wiki:film:1383775061:6"
      ]
    },
    {
      "t": "2026-11-03T00:00:52Z",
      "text": "The article places the filming in Film City, Ayodhya and Mumbai.",
      "cites": [
        "wiki:film:1383775061:1",
        "wiki:film:1383775061:2",
        "wiki:film:1383775061:6"
      ]
    },
    {
      "t": "2026-11-03T00:01:01Z",
      "text": "6 of the people credited have a birthplace on record; 5 were born in India.",
      "cites": [
        "wd:Q108560:P19",
        "wd:Q16908467:P19",
        "wd:Q20081051:P19",
