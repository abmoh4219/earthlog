    {
      "t": "2026-11-03T00:00:00Z",
      "text": "The United States holds midterm elections for 435 members and five non-voting delegates of the House of Representatives, 35 members of the Senate (including special elections in Florida and Ohio)…",
      "cites": [
        "wiki:2026-11-03:10"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "The war with Iran became a subject of Democratic campaigning ahead of the November 3 midterm elections.",
      "cites": [
        "wiki:rev:1383770772:163"
      ]
    },
    {
      "t": "2026-11-03T00:00:16Z",
      "text": "Elections were held in the United States on November 3, 2026.",
      "cites": [
        "wiki:rev:1383770772:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:24Z",
      "text": "35 Senate races this year: Democrats won 20, Republicans 13, 2 not yet called.",
      "cites": [
        "elex:2026-united-states-senate-elections:the-senate-table"
      ]
    },
    {
      "t": "2026-11-03T00:00:31Z",
      "text": "Democratic gains: Iowa, North Carolina, Kansas, Maine, Ohio, South Carolina and Texas.",
      "cites": [
        "elex:2026-united-states-senate-elections:senate-ia",
        "elex:2026-united-states-senate-elections:senate-nc",
        "elex:2026-united-states-senate-elections:senate-ks",
        "elex:2026-united-states-senate-elections:senate-me",
        "elex:2026-united-states-senate-elections:senate-oh-special",
        "elex:2026-united-states-senate-elections:senate-sc",
        "elex:2026-united-states-senate-elections:senate-tx"
      ]
    },
    {
      "t": "2026-11-03T00:00:38Z",
      "text": "36 governor's races this year: Democrats won 21, Republicans 12, 3 not yet called.",
      "cites": [
        "elex:2026-united-states-gubernatorial-elections:governors-table"
      ]
    },
    {
      "t": "2026-11-03T00:00:45Z",
      "text": "Democratic gains: Georgia, Iowa, Nevada, Ohio and Texas.",
      "cites": [
        "elex:2026-united-states-gubernatorial-elections:governors-ga",
        "elex:2026-united-states-gubernatorial-elections:governors-ia",
        "elex:2026-united-states-gubernatorial-elections:governors-nv",
        "elex:2026-united-states-gubernatorial-elections:governors-oh",
        "elex:2026-united-states-gubernatorial-elections:governors-tx"
      ]
    },
    {
      "t": "2026-11-03T00:00:52Z",
      "text": "The House: Democrats 231 seats, Republicans 139, 65 still to be called. 218 make a majority.",
      "cites": [
        "elex:2026-united-states-house-of-representatives-elections:house-infobox"
      ]
    },
    {
      "t": "2026-11-03T00:00:59Z",
      "text": "On the map: 30 districts changed party; 97 not yet called in the race tables.",
      "cites": [
        "elex:2026-united-states-house-of-representatives-elections:house-table"
      ]
    },
    {
      "t": "2026-11-03T00:01:06Z",
      "text": "Readers also turned to United States midterm election (244,478), James Talarico (105,766), 2026 United States Senate elections (90,787).",
      "cites": [
        "views:en:United_States_midterm_election:2026-11-03",
        "views:en:James_Talarico:2026-11-03",
        "views:en:2026_United_States_Senate_elections:2026-11-03"
      ]
    },
    {
      "t": "2026-11-03T00:01:15Z",
      "text": "455,194 people read about it on 3 November 2026: about 18× the usual.",
      "cites": [
        "views:en:2026_United_States_elections:2026-11-03",
        "views:en:2026_United_States_elections:prior"
      ]
    },
    {
      "t": "2026-11-03T00:01:26Z",
      "text": "Reported by The Guardian and Reuters.",
      "cites": [
        "wiki:2026-11-03:10",
        "wiki:2026-11-03:11"
      ]
    }
