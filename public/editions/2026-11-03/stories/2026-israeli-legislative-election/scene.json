  "beats": [
    {
      "t": "2026-11-03T00:00:01Z",
      "text": "Israel held legislative elections on 27 October 2026 to choose the 120 members of the 26th Knesset and decide the governing coalition that will succeed the 37th government, led by Prime Minister Benjamin Netanyahu.",
      "cites": [
        "wiki:rev:1383792096:0"
      ]
    },
    {
      "t": "2026-11-03T00:00:08Z",
      "text": "On 2 November, Democrats leader Yair Golan announced that his party would also recommend Eisenkot.",
      "cites": [
        "wiki:rev:1383792096:107"
      ]
    },
    {
      "t": "2026-11-03T00:00:15Z",
      "text": "On 1 November, President Isaac Herzog announced that he would invite party leaders from 4 November to begin consultations on who should get the first chance to form a government.",
      "cites": [
        "wiki:rev:1383792096:105"
      ]
    },
    {
      "t": "2026-11-03T00:00:25Z",
      "text": "Likud, led by Benjamin Netanyahu, won the most seats with 27, well short of the 61 needed for a majority.",
      "cites": [
        "elex:2026-israeli-legislative-election:party1",
        "elex:2026-israeli-legislative-election:summary"
      ]
    },
    {
      "t": "2026-11-03T00:00:31Z",
      "text": "Turnout was 77.97%.",
      "cites": [
        "elex:2026-israeli-legislative-election:summary"
      ]
    },
    {
      "t": "2026-11-03T00:00:39Z",
      "text": "On 3 November 2026, the English article was read by 60,786 people, about 6 times its usual daily readership.",
      "cites": [
        "views:en:2026_Israeli_legislative_election:2026-11-03",
        "views:en:2026_Israeli_legislative_election:prior"
      ]
    },
    {
      "t": "2026-11-03T00:00:45Z",
      "text": "The article was read in 11 languages, and after English, the most readers were in French, with 3,789.",
      "cites": [
        "views:en:2026_Israeli_legislative_election:2026-11-03",
        "views:fr:Élections_législatives_israéliennes_de_2026:2026-11-03"
      ]
    }
  ],
