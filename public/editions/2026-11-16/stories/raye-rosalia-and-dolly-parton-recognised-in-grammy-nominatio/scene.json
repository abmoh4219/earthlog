    {
      "t": "2026-11-16T00:00:01Z",
      "text": "Raye, Rosalía and Dolly Parton were recognised in Grammy nominations, according to BBC News.",
      "cites": [
        "news:bbc:ff72e800a1d8"
      ]
    },
    {
      "t": "2026-11-16T00:00:09Z",
      "text": "The Grammy Awards, often called the Grammys, are presented by the Recording Academy of the United States to recognize outstanding achievements in music.",
      "cites": [
        "wiki:rev:1383488200:0"
      ]
    },
    {
      "t": "2026-11-16T00:00:18Z",
      "text": "The show has aired on NBC from 1959 to 1970, on ABC in 1971, 1972 and 2027, and on CBS from 1973 to 2026, and it is hosted by The Recording Academy.",
      "cites": [
        "wiki:box:1383488200:network",
        "wiki:box:1383488200:hosts"
      ]
    },
    {
      "t": "2026-11-16T00:00:30Z",
      "text": "BBC News headlined its report “Raye, Rosalía and Dolly Parton recognised in Grammy nominations”.",
      "cites": [
        "news:bbc:ff72e800a1d8"
      ]
    },
    {
      "t": "2026-11-16T00:00:37Z",
      "text": "DW headlined its report “Grammy Awards: Raye and Rosalia lead nominations”.",
      "cites": [
        "news:dw:04fc79c7dd7d"
