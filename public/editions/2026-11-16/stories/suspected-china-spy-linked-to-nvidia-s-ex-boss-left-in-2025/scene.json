  "beats": [
    {
      "t": "2026-11-16T00:00:01Z",
      "text": "BBC News reports that a suspected China spy linked to Nvidia's former boss left in 2025, according to Megaspeed.",
      "cites": [
        "news:bbc:5ec261feee59"
      ]
    },
    {
      "t": "2026-11-16T00:00:08Z",
      "text": "In October 2026, Meta expressed intent for further use of Nvidia hardware for its Muse agent, and plans to incorporate almost all of Nvidia's planned upcoming enterprise products.",
      "cites": [
        "wiki:rev:1386037839:227"
      ]
    },
    {
      "t": "2026-11-16T00:00:15Z",
      "text": "Nvidia Corporation is an American multinational technology company headquartered in Santa Clara, California.",
      "cites": [
        "wiki:rev:1386037839:0"
      ]
    },
    {
      "t": "2026-11-16T00:00:25Z",
      "text": "Nvidia is headquartered in Santa Clara, United States.",
      "cites": [
        "wd:Q182477:P159"
      ]
    },
    {
      "t": "2026-11-16T00:00:33Z",
      "text": "Founded in 1993 by Jensen Huang, Chris Malachowsky and Curtis Priem, the company is led by Colette Kress.",
      "cites": [
        "wd:Q182477:P571",
        "wd:Q182477:P112",
        "wd:Q182477:P169"
      ]
    },
    {
      "t": "2026-11-16T00:00:43Z",
      "text": "Recorded revenue rose from $4.1 billion in 2007 to $215.9 billion in 2025.",
      "cites": [
        "wd:Q182477:P2139:series"
      ]
    },
    {
      "t": "2026-11-16T00:00:50Z",
      "text": "Staff grew from 11,528 in 2018 to 42,000 in 2026.",
      "cites": [
        "wd:Q182477:P1128:series"
      ]
    },
    {
      "t": "2026-11-16T00:00:59Z",
      "text": "On record, Nvidia's subsidiaries and owned companies include Nvidia Ltd., Icera and 3 others.",
      "cites": [
        "wd:Q182477:P355:Q29000344",
        "wd:Q182477:P355:Q5985959",
        "wd:Q182477:P355:Q6817432",
        "wd:Q182477:P355:Q6813052",
        "wd:Q182477:P1830:Q392357"
      ]
    },
    {
      "t": "2026-11-16T00:01:08Z",
      "text": "Hacker News carried 230 stories with Nvidia in the title in the two weeks to 16 November 2026.",
      "cites": [
        "hn:2026-11-16:Q182477"
      ]
    },
    {
      "t": "2026-11-16T00:01:26Z",
      "text": "The Guardian headlined its report: “Megaspeed, the company linked to the downfall of Nvidia boss, says it’s a ‘legitimate and lawful business’”.",
      "cites": [
        "news:guardian:e8223816b55a"
      ]
    },
    {
      "t": "2026-11-16T00:01:32Z",
      "text": "BBC News headlined its report: “Suspected China spy linked to Nvidia's ex-boss left in 2025, Megaspeed says”.",
      "cites": [
        "news:bbc:5ec261feee59"
      ]
    },
    {
      "t": "2026-11-16T00:01:38Z",
      "text": "Al Jazeera headlined its report: “Megaspeed, firm at centre of Nvidia scandal, says Alice Huang left in 2025”.",
      "cites": [
        "news:aljazeera:92de303be865"
      ]
    },
    {
      "t": "2026-11-16T00:01:47Z",
      "text": "Sources include The Guardian, BBC News and Al Jazeera, Wikipedia, Wikidata and Hacker News, and every caption links to the evidence it rests on.",
      "cites": [
