  "beats": [
    {
      "t": "2026-11-16T00:00:01Z",
      "text": "An Australian MP who lost her legs in an alleged attack is speaking after leaving hospital, as Sky News reports.",
      "cites": [
        "news:sky:dd1701c3a94a"
      ]
    },
    {
      "t": "2026-11-16T00:00:09Z",
      "text": "BBC News also reports on her leaving hospital after the alleged car attack.",
      "cites": [
        "news:bbc:98f8478c07b7"
      ]
    },
    {
      "t": "2026-11-16T00:00:18Z",
      "text": "Inflation in Australia fell to 2.9% in 2025, from 6.6% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:AU"
      ]
    },
    {
      "t": "2026-11-16T00:00:26Z",
      "text": "The economy grew 1.4% in 2025, and unemployment stood at 4.1%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:AU",
        "wb:SL.UEM.TOTL.ZS:AU"
      ]
    },
    {
      "t": "2026-11-16T00:00:36Z",
      "text": "Across East Asia and the Pacific, Australia's 2.9% compares with a median of 2.1%, while the highest is Mongolia at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-16T00:00:50Z",
      "text": "Australia, officially the Commonwealth of Australia, is a country comprising the mainland of the Australian continent, the island of Tasmania and numerous smaller islands.",
      "cites": [
        "wiki:rev:1386101406:0"
      ]
    },
    {
      "t": "2026-11-16T00:01:01Z",
      "text": "BBC News headlined it: “Australian MP 'full of gratitude' upon leaving hospital after alleged car attack”.",
      "cites": [
        "news:bbc:98f8478c07b7"
      ]
    },
