  "beats": [
    {
      "t": "2026-11-16T00:00:01Z",
      "text": "British actor Robert Pattinson has been named as the new James Bond, according to Al Jazeera.",
      "cites": [
        "news:aljazeera:cc5bdfab36e8"
      ]
    },
    {
      "t": "2026-11-16T00:00:08Z",
      "text": "In November 2026 he was announced as the next actor to play Bond, succeeding Daniel Craig, whose final appearance in the role was in the 2021 film No Time to Die.",
      "cites": [
        "wiki:rev:1386156147:172"
      ]
    },
    {
      "t": "2026-11-16T00:00:15Z",
      "text": "Robert Douglas Thomas Pattinson, born 13 May 1986, is an English actor and producer.",
      "cites": [
        "wiki:rev:1386156147:0"
      ]
    },
    {
      "t": "2026-11-16T00:00:25Z",
      "text": "Robert Pattinson was born on 13 May 1986 in London.",
      "cites": [
        "wd:Q36767:P569",
        "wd:Q36767:P19"
      ]
    },
    {
      "t": "2026-11-16T00:00:33Z",
      "text": "He was educated at The Harrodian School and Tower House School.",
      "cites": [
        "wd:Q36767:P69:Q7738938",
        "wd:Q36767:P69:Q7829703"
      ]
    },
    {
      "t": "2026-11-16T00:00:43Z",
      "text": "9 awards are on record, among them the MTV Movie Award for Best Male Performance (2011) and the MTV Movie Award for Best Kiss (2012).",
      "cites": [
        "wd:Q36767:P166:Q257235",
        "wd:Q36767:P166:Q4220901"
      ]
    },
    {
      "t": "2026-11-16T00:01:02Z",
      "text": "DW headlined its report, \"British actor Robert Pattinson confirmed as new James Bond.\"",
      "cites": [
        "news:dw:55e18f26535e"
      ]
    },
    {
      "t": "2026-11-16T00:01:08Z",
      "text": "France 24 headlined its report, \"Robert Pattinson named as new James Bond.\"",
      "cites": [
        "news:france24:2aad54206da2"
      ]
    },
    {
      "t": "2026-11-16T00:01:14Z",
      "text": "BBC News headlined its piece, \"When will we see Robert Pattinson as Bond in cinemas?\"",
      "cites": [
        "news:bbc:4b6cc1e3f95b"
      ]
    },
