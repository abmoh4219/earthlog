  "beats": [
    {
      "t": "2026-11-16T00:00:01Z",
      "text": "US authorities are moving to further curb China's access to Nvidia chips, according to Sky News.",
      "cites": [
        "news:sky:fce31fdfe774"
      ]
    },
    {
      "t": "2026-11-16T00:00:08Z",
      "text": "Meta expressed intent in October 2026 to further use Nvidia hardware for developing its Muse agent, and to incorporate almost all of Nvidia's planned upcoming enterprise products.",
      "cites": [
        "wiki:rev:1386037839:227"
      ]
    },
    {
      "t": "2026-11-16T00:00:15Z",
      "text": "Nvidia Corporation is an American multinational technology company headquartered in Santa Clara, California.",
      "cites": [
        "wiki:rev:1386037839:0"
      ]
    },
    {
      "t": "2026-11-16T00:00:25Z",
      "text": "Nvidia is headquartered in Santa Clara, United States.",
      "cites": [
        "wd:Q182477:P159"
      ]
    },
    {
      "t": "2026-11-16T00:00:33Z",
      "text": "Nvidia was founded in 1993 by Jensen Huang, Chris Malachowsky and Curtis Priem, and is led by Colette Kress.",
      "cites": [
        "wd:Q182477:P571",
        "wd:Q182477:P112",
        "wd:Q182477:P169"
      ]
    },
    {
      "t": "2026-11-16T00:00:43Z",
      "text": "Recorded revenue rose from $4.1 billion in 2007 to $215.9 billion in 2025.",
      "cites": [
        "wd:Q182477:P2139:series"
      ]
    },
    {
      "t": "2026-11-16T00:00:50Z",
      "text": "Staff grew from 11,528 in 2018 to 42,000 in 2026.",
      "cites": [
        "wd:Q182477:P1128:series"
      ]
    },
    {
      "t": "2026-11-16T00:00:59Z",
      "text": "On record, the company's subsidiaries include Nvidia Ltd., Icera and 3 others.",
      "cites": [
        "wd:Q182477:P355:Q29000344",
        "wd:Q182477:P355:Q5985959",
        "wd:Q182477:P355:Q6817432",
        "wd:Q182477:P355:Q6813052",
        "wd:Q182477:P1830:Q392357"
      ]
    },
    {
      "t": "2026-11-16T00:01:08Z",
      "text": "Hacker News recorded 230 stories mentioning Nvidia in the two weeks to 16 November 2026.",
      "cites": [
        "hn:2026-11-16:Q182477"
      ]
    },
    {
      "t": "2026-11-16T00:01:26Z",
      "text": "Sky News headlined its report “US to further curb China's access to Nvidia chips”.",
      "cites": [
        "news:sky:fce31fdfe774"
      ]
    },
    {
      "t": "2026-11-16T00:01:33Z",
      "text": "DW headlined its report “Nvidia scandal: China's chips dilemma, US rivalry shape AI race”.",
      "cites": [
        "news:dw:39b6798086ba"
      ]
    },
    {
      "t": "2026-11-16T00:01:42Z",
      "text": "This explainer draws on Sky News and DW reporting, Wikipedia, Wikidata and Hacker News, and each caption links to the evidence it rests on.",
      "cites": [
