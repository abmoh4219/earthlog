  "beats": [
    {
      "t": "2026-11-16T00:00:01Z",
      "text": "France's Philippe Diallo is set to challenge Infantino for the FIFA presidency, according to DW.",
      "cites": [
        "news:dw:6fe08ae5c0bf"
      ]
    },
    {
      "t": "2026-11-16T00:00:09Z",
      "text": "Giovanni Vincenzo \"Gianni\" Infantino, born 23 March 1970, is a Swiss football administrator who has served as president of FIFA since 2016.",
      "cites": [
        "wiki:rev:1384695862:0"
      ]
    },
    {
      "t": "2026-11-16T00:00:18Z",
      "text": "Gianni Infantino was born on 23 March 1970 in Brig-Glis.",
      "cites": [
        "wd:Q124138:P569",
        "wd:Q124138:P19"
      ]
    },
    {
      "t": "2026-11-16T00:00:26Z",
      "text": "He was educated at the University of Fribourg and the University of Neuchâtel.",
      "cites": [
        "wd:Q124138:P69:Q36188",
        "wd:Q124138:P69:Q541548"
      ]
    },
    {
      "t": "2026-11-16T00:00:30Z",
      "text": "He worked for the Union of European Football Associations and later for FIFA.",
      "cites": [
        "wd:Q124138:P108:Q35572",
        "wd:Q124138:P108:Q253414"
      ]
    },
    {
      "t": "2026-11-16T00:00:36Z",
      "text": "Wikidata records 11 awards, among them the Presidential Medal of Merit (2025) and the Medal of Friendship (2026).",
      "cites": [
        "wd:Q124138:P166:Q25342379",
        "wd:Q124138:P166:Q3885162"
      ]
    },
    {
      "t": "2026-11-16T00:00:55Z",
      "text": "Sky News headlined it: “FIFA president Gianni Infantino faces challenge from French football chief”.",
      "cites": [
        "news:sky:77df0b0c2405"
      ]
    },
    {
      "t": "2026-11-16T00:01:01Z",
      "text": "Al Jazeera headlined it: “UEFA backs France’s Philippe Diallo to challenge Infantino in FIFA election”.",
      "cites": [
        "news:aljazeera:3ea308e836a0"
      ]
    },
    {
      "t": "2026-11-16T00:01:07Z",
      "text": "DW headlined it: “France's Philippe Diallo to challenge Infantino for FIFA presidency”.",
      "cites": [
        "news:dw:6fe08ae5c0bf"
      ]
    },
