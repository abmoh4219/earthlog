    {
      "t": "2026-11-04T00:00:00Z",
      "text": "The Bangladeshi garment industry wage board agrees to increase minimum wages following five days of worker protests and clashes with police.",
      "cites": [
        "wiki:2026-11-04:1"
      ]
    },
    {
      "t": "2026-11-04T00:00:10Z",
      "text": "Inflation in Bangladesh was 8.8% in 2025, down from 10.5% in 2024.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:BD"
      ]
    },
    {
      "t": "2026-11-04T00:00:19Z",
      "text": "The economy grew 3.5% in 2025; unemployment stood at 3.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:BD",
        "wb:SL.UEM.TOTL.ZS:BD"
      ]
    },
    {
      "t": "2026-11-04T00:00:28Z",
      "text": "Across South Asia, Bangladesh's 8.8% compares with a median of 2.7%; the highest is Bangladesh at 8.8%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:south-asia"
      ]
    },
