  "beats": [
    {
      "t": "2026-11-04T00:00:01Z",
      "text": "NASA's Neil Gehrels Swift Observatory, a space telescope used to study gamma-ray bursts, is re-entering Earth's atmosphere over Sumatra, ending a mission of nearly 22 years.",
      "cites": [
        "wiki:2026-11-04:5"
      ]
    },
    {
      "t": "2026-11-04T00:00:05Z",
      "text": "Separately, the Singaporean parliament amends the Transboundary Haze Pollution Act of 2014, introducing arrest powers and permitting trials in absentia.",
      "cites": [
        "wiki:2026-11-04:5"
      ]
    },
    {
      "t": "2026-11-04T00:00:11Z",
      "text": "The re-entry is reported over Sumatra, in Indonesia.",
      "cites": [
        "wiki:2026-11-04:5"
      ]
    },
    {
      "t": "2026-11-04T00:00:19Z",
      "text": "Singapore is also named in the reports.",
      "cites": [
        "wiki:2026-11-04:5"
      ]
    },
    {
      "t": "2026-11-04T00:00:28Z",
      "text": "The story was reported by AFP.",
      "cites": [
        "wiki:2026-11-04:5"
      ]
    },
    {
      "t": "2026-11-04T00:00:36Z",
      "text": "This explainer draws on Wikipedia and Current events, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-04:5"
      ]
    }
