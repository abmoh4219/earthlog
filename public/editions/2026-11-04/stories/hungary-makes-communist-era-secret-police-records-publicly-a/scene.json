    {
      "t": "2026-11-04T00:00:01Z",
      "text": "According to the reports, a fire and explosion at a Panasonic subsidiary's factory in Hsinchu County, Taiwan, killed two employees and injured five others.",
      "cites": [
        "wiki:2026-11-04:4"
      ]
    },
    {
      "t": "2026-11-04T00:00:05Z",
      "text": "Hungary makes Communist-era secret police records publicly accessible through a database containing approximately 60,000 names linked to former state security services.",
      "cites": [
        "wiki:2026-11-04:4"
      ]
    },
    {
      "t": "2026-11-04T00:00:11Z",
      "text": "The reports place this story in Hungary.",
      "cites": [
        "wiki:2026-11-04:4"
      ]
    },
    {
      "t": "2026-11-04T00:00:19Z",
      "text": "Panasonic and Hsinchu County are also named in the reports.",
      "cites": [
        "wiki:2026-11-04:4"
      ]
    },
    {
      "t": "2026-11-04T00:00:28Z",
      "text": "The story is reported by Reuters.",
      "cites": [
        "wiki:2026-11-04:4"
      ]
    },
