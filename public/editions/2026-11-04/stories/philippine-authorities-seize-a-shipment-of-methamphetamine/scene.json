  "beats": [
    {
      "t": "2026-11-04T00:00:01Z",
      "text": "Philippine authorities seized a shipment of methamphetamine at the Manila International Container Port, and its origin is traced to Laos.",
      "cites": [
        "wiki:2026-11-04:3"
      ]
    },
    {
      "t": "2026-11-04T00:00:05Z",
      "text": "The shipment arrived six days after local police in Laos found similar contraband, supposed to be brought to the Philippines, on October 1.",
      "cites": [
        "wiki:2026-11-04:3"
      ]
    },
    {
      "t": "2026-11-04T00:00:11Z",
      "text": "The seizure is placed at the Port of Manila in the Philippines, as the reports describe it.",
      "cites": [
        "wiki:2026-11-04:3"
      ]
    },
    {
      "t": "2026-11-04T00:00:19Z",
      "text": "The reports also name Malasiqui, Pangasinan.",
      "cites": [
        "wiki:2026-11-04:3"
      ]
    },
    {
      "t": "2026-11-04T00:00:28Z",
      "text": "The Philippine Star reported the story.",
      "cites": [
        "wiki:2026-11-04:3"
      ]
    },
    {
      "t": "2026-11-04T00:00:36Z",
