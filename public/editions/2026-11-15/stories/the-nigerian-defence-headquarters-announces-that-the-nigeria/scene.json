  "beats": [
    {
      "t": "2026-11-15T00:00:01Z",
      "text": "The Nigerian Defence Headquarters announces that the Nigerian Army killed eight terrorists and arrested 22 additional terrorists, logistical personnel and their families, in raids between November 6 and 12.",
      "cites": [
        "wiki:2026-11-15:3"
      ]
    },
    {
      "t": "2026-11-15T00:00:09Z",
      "text": "Religious violence in Nigeria refers to Christian–Muslim strife in Nigeria tracing back to 1953.",
      "cites": [
        "wiki:rev:1385396737:0"
      ]
    },
    {
      "t": "2026-11-15T00:00:18Z",
      "text": "The reports place the announcement with the Nigerian Defence Headquarters in Nigeria.",
      "cites": [
        "wiki:2026-11-15:3"
      ]
    },
    {
      "t": "2026-11-15T00:00:26Z",
      "text": "The article lists Christians, including Adara, Atyap, Berom, Jukun, Tiv and Tarok farmers, and Biafran separatists, as one side.",
      "cites": [
        "wiki:box:1385396737:side-1"
      ]
    },
    {
      "t": "2026-11-15T00:00:31Z",
      "text": "Muslims, including Fulani and Hausa herders and Boko Haram, are listed as another side, and the Nigerian Armed Forces and Nigeria Police Force as a third.",
      "cites": [
        "wiki:box:1385396737:side-2",
        "wiki:box:1385396737:side-3"
      ]
    },
    {
      "t": "2026-11-15T00:00:36Z",
      "text": "Wikipedia lists the conflict as ongoing.",
      "cites": [
        "wiki:box:1385396737:status"
      ]
    },
    {
      "t": "2026-11-15T00:00:43Z",
      "text": "Also named in the reports are Adamawa State, Bauchi State and Yobe State.",
      "cites": [
        "wiki:2026-11-15:3"
      ]
    },
    {
      "t": "2026-11-15T00:00:52Z",
      "text": "The report is from The Vanguard.",
      "cites": [
        "wiki:2026-11-15:3"
      ]
    },
    {
      "t": "2026-11-15T00:01:00Z",
      "text": "This explainer draws on Wikipedia, Wikipedia pageview data and Wikidata, and every caption links to the evidence it rests on.",
      "cites": [
