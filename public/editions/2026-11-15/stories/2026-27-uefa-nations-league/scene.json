  "beats": [
    {
      "t": "2026-11-15T00:00:01Z",
      "text": "In association football, England beat Spain 3–2 in the group stage of UEFA Nations League A, ending Spain's 43-match unbeaten streak, the longest by a national team.",
      "cites": [
        "wiki:2026-11-15:21"
      ]
    },
    {
      "t": "2026-11-15T00:00:08Z",
      "text": "The competition runs from September to November 2026 for the league phase, March 2027 for the League A quarter-finals and play-offs, and June 2027 for the Nations League Finals.",
      "cites": [
        "wiki:rev:1385905886:1"
      ]
    },
    {
      "t": "2026-11-15T00:00:15Z",
      "text": "The 2026–27 UEFA Nations League is the fifth season of the competition, an international association football competition for the men's national teams of UEFA's member associations.",
      "cites": [
        "wiki:rev:1385905886:0"
      ]
    },
    {
      "t": "2026-11-15T00:00:25Z",
      "text": "Readers also turned to the English article on the UEFA Nations League, which drew 64,739 readers on 15 November 2026.",
      "cites": [
        "views:en:UEFA_Nations_League:2026-11-15"
      ]
    },
    {
      "t": "2026-11-15T00:00:34Z",
      "text": "On 15 November 2026, 79,669 people read the English article about the season, about 22 times the usual daily figure.",
      "cites": [
        "views:en:2026–27_UEFA_Nations_League:2026-11-15",
        "views:en:2026–27_UEFA_Nations_League:prior"
      ]
    },
    {
      "t": "2026-11-15T00:00:41Z",
      "text": "The article was read in 11 languages, and after English, French was the most read, with 18,332 readers.",
      "cites": [
        "views:en:2026–27_UEFA_Nations_League:2026-11-15",
        "views:fr:Ligue_des_nations_de_l'UEFA_2026-2027:2026-11-15"
      ]
    },
    {
      "t": "2026-11-15T00:00:48Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:fr:Ligue_des_nations_de_l'UEFA_2026-2027:2026-11-15",
        "views:it:UEFA_Nations_League_2026-2027:2026-11-15",
        "views:es:Liga_de_Naciones_de_la_UEFA_2026-27:2026-11-15",
        "views:de:UEFA_Nations_League_2026/27:2026-11-15",
        "views:pl:Liga_Narodów_UEFA_(2026/2027):2026-11-15",
        "views:ru:Лига_наций_УЕФА_2026/2027:2026-11-15"
      ]
    },
    {
      "t": "2026-11-15T00:00:58Z",
      "text": "The report on the match was filed by AP.",
      "cites": [
        "wiki:2026-11-15:21"
      ]
    },
    {
      "t": "2026-11-15T00:01:06Z",
      "text": "Al Jazeera headlined its coverage, “Spain vs England live: UEFA Nations League.”",
      "cites": [
        "news:aljazeera:dc59968902c5"
      ]
    },
