  "beats": [
    {
      "t": "2026-11-15T00:00:01Z",
      "text": "Zelenskyy has urged the removal of Starshield limits on Ukraine, according to DW.",
      "cites": [
        "news:dw:505b8186cf0a"
      ]
    },
    {
      "t": "2026-11-15T00:00:08Z",
      "text": "As well as visiting Ukrainian troops on the frontlines, Zelenskyy has often met world leaders, urging the international community to support Ukraine's resistance and its efforts to end Russia's war.",
      "cites": [
        "wiki:rev:1385471664:2"
      ]
    },
    {
      "t": "2026-11-15T00:00:15Z",
      "text": "Volodymyr Oleksandrovych Zelenskyy, born 25 January 1978, is a Ukrainian politician and former entertainer who has served as the sixth president of Ukraine since 2019.",
      "cites": [
        "wiki:rev:1385471664:0"
      ]
    },
    {
      "t": "2026-11-15T00:00:25Z",
      "text": "Volodymyr Zelenskyy was born on 25 January 1978 in Kryvyi Rih.",
      "cites": [
        "wd:Q3874799:P569",
        "wd:Q3874799:P19"
      ]
    },
    {
      "t": "2026-11-15T00:00:33Z",
      "text": "He was educated at Kryvyi Rih Lyceum 95 and Kryvyi Rih Institute of Economics.",
      "cites": [
        "wd:Q3874799:P69:Q134446124",
        "wd:Q3874799:P69:Q12114704"
      ]
    },
    {
      "t": "2026-11-15T00:00:37Z",
      "text": "He worked for Kvartal 95, Inter, 1+1 and the Office of the President of Ukraine, in Kryvyi Rih and Kyiv.",
      "cites": [
        "wd:Q3874799:P108:Q4444575",
        "wd:Q3874799:P108:Q2914786",
        "wd:Q3874799:P108:Q161257",
        "wd:Q3874799:P108:Q5764175",
        "wd:Q3874799:P937:Q157137",
        "wd:Q3874799:P937:Q1899"
      ]
    },
    {
      "t": "2026-11-15T00:00:43Z",
      "text": "Wikidata lists 35 awards on record, among them The Cross of Good Neighbourliness and Order of the Republic, both from 2026.",
      "cites": [
        "wd:Q3874799:P166:Q4375456"
      ]
    },
    {
      "t": "2026-11-15T00:00:49Z",
      "text": "He is known for Servant of the People.",
      "cites": [
        "wd:Q3874799:P800:Q21546165"
      ]
    },
    {
      "t": "2026-11-15T00:01:06Z",
      "text": "Al Jazeera headlined its report “Starshield restrictions help Russia’s energy attacks on Ukraine: Zelenskyy”.",
      "cites": [
        "news:aljazeera:d16b98a3f374"
      ]
    },
    {
      "t": "2026-11-15T00:01:13Z",
      "text": "DW headlined its report “Zelenskyy urges removal of Starshield limits on Ukraine”.",
      "cites": [
        "news:dw:505b8186cf0a"
      ]
    },
    {
