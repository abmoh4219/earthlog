    {
      "t": "2026-11-15T00:00:01Z",
      "text": "Yemen's Houthis are advancing on Aden, while government forces retreat to defend their capital, according to France 24.",
      "cites": [
        "news:france24:21793fe41f25"
      ]
    },
    {
      "t": "2026-11-15T00:00:08Z",
      "text": "The Wall Street Journal reported in October 2026 that the Houthis have relied on Chinese equipment and parts to build a version of the Kheibar Shekan ballistic missile.",
      "cites": [
        "wiki:rev:1384523612:292"
      ]
    },
    {
      "t": "2026-11-15T00:00:15Z",
      "text": "The Houthis, officially Ansar Allah or Ansarullah, are a Zaydi revivalist and Shia Islamist political and paramilitary organization that emerged from Yemen in the 1990s.",
      "cites": [
        "wiki:rev:1384523612:0"
      ]
    },
    {
      "t": "2026-11-15T00:00:25Z",
      "text": "The Houthis are headquartered in Saada, Yemen.",
      "cites": [
        "wd:Q3042087:P159"
      ]
    },
    {
      "t": "2026-11-15T00:00:33Z",
      "text": "The organization was founded in 2000 by Hussein al-Houthi.",
      "cites": [
        "wd:Q3042087:P571",
        "wd:Q3042087:P112"
      ]
    },
    {
      "t": "2026-11-15T00:00:52Z",
      "text": "Al Jazeera headlined its report “Yemeni government forces redeploy from Bab al-Mandeb to defend Aden.”",
      "cites": [
        "news:aljazeera:8d45b4ebac30"
      ]
    },
    {
      "t": "2026-11-15T00:00:58Z",
      "text": "France 24 headlined its report “Yemen's Houthis advance on Aden as government forces retreat to defend their capital.”",
      "cites": [
        "news:france24:21793fe41f25"
      ]
    },
    {
      "t": "2026-11-15T00:01:04Z",
      "text": "DW headlined its report “Yemen: Anti-Houthi forces pull back as rebels advance.”",
      "cites": [
        "news:dw:bce2a6257bd5"
      ]
    },
    {
      "t": "2026-11-15T00:01:13Z",
