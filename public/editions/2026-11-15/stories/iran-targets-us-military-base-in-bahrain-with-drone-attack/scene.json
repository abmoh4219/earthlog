      ]
    },
    {
      "t": "2026-11-15T00:00:08Z",
      "text": "BBC News reports that Iran has targeted a US military base in Bahrain with a drone attack.",
      "cites": [
        "news:bbc:985f21bc1fc2"
      ]
    },
    {
      "t": "2026-11-15T00:00:15Z",
      "text": "Houda Nonoo, a former Bahraini ambassador to America, is Jewish.",
      "cites": [
        "wiki:rev:1385859397:485"
      ]
    },
    {
      "t": "2026-11-15T00:00:25Z",
      "text": "On 13 November, Iran said it had destroyed an early-warning radar in Bahrain, as retaliation for a United States strike on telecommunication infrastructure on Sirik.",
      "cites": [
        "wiki:2026-11-13:1"
      ]
    },
    {
      "t": "2026-11-15T00:00:32Z",
      "text": "On 14 November, the Iranian military attacked an American military facility in Bahrain with drones and missiles, one of the largest attacks on the country in months.",
      "cites": [
        "wiki:2026-11-14:2"
      ]
    },
    {
      "t": "2026-11-15T00:00:49Z",
      "text": "Al Jazeera headlined its report, “Iran war live: Bahrain targeted as Gulf nations warned against US support.”",
      "cites": [
        "news:aljazeera:0b7f22cc7e17"
      ]
    },
    {
      "t": "2026-11-15T00:00:55Z",
      "text": "BBC News headlined its story, “Iran targets US military base in Bahrain with drone attack.”",
      "cites": [
        "news:bbc:985f21bc1fc2"
      ]
    },
    {
      "t": "2026-11-15T00:01:01Z",
