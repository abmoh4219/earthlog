    {
      "t": "2026-11-21T00:00:01Z",
      "text": "Al Jazeera reports that Brazil's Jair Bolsonaro is in intensive care with a bowel obstruction.",
      "cites": [
        "news:aljazeera:a1e3a5a13b65"
      ]
    },
    {
      "t": "2026-11-21T00:00:08Z",
      "text": "On November 24, the Supreme Federal Court unanimously voted to keep Bolsonaro in police custody.",
      "cites": [
        "wiki:rev:1386713962:259"
      ]
    },
    {
      "t": "2026-11-21T00:00:15Z",
      "text": "Jair Messias Bolsonaro, born 21 March 1955, is a Brazilian politician and former military officer who served as the 38th president of Brazil from 2019 to 2023.",
      "cites": [
        "wiki:rev:1386713962:0"
      ]
    },
    {
      "t": "2026-11-21T00:00:25Z",
      "text": "Jair Bolsonaro was born on 21 March 1955 in Glicério.",
      "cites": [
        "wd:Q10304982:P569",
        "wd:Q10304982:P19"
      ]
    },
    {
      "t": "2026-11-21T00:00:33Z",
      "text": "He was educated at Academia Militar das Agulhas Negras.",
      "cites": [
        "wd:Q10304982:P69:Q2865871"
      ]
    },
    {
      "t": "2026-11-21T00:00:38Z",
      "text": "He has worked in Brasília and Rio de Janeiro.",
      "cites": [
        "wd:Q10304982:P937:Q2844",
        "wd:Q10304982:P937:Q8678"
      ]
    },
    {
      "t": "2026-11-21T00:00:44Z",
      "text": "6 awards on record, among them the Ig Nobel Prize (2020) and Person of the Year in Organized Crime and Corruption (Ironic denominación, not a real award) (2020).",
      "cites": [
        "wd:Q10304982:P166:Q184253",
        "wd:Q10304982:P166:Q104595803"
      ]
    },
    {
      "t": "2026-11-21T00:01:03Z",
      "text": "DW headlined the story: “Brazil ex-President Jair Bolsonaro taken to hospital over abdominal pain”.",
      "cites": [
        "news:dw:e735cc923d74"
      ]
    },
