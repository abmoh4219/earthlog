  "beats": [
    {
      "t": "2026-11-21T00:00:01Z",
      "text": "Saudi Arabia intercepts three missiles fired at Riyadh by the Houthis.",
      "cites": [
        "wiki:2026-11-21:2"
      ]
    },
    {
      "t": "2026-11-21T00:00:08Z",
      "text": "In October 2026, the United Arab Emirates (UAE) decided to rejoin the Yemen conflict by starting to pay some government forces battling the Houthi group, which is aligned with Iran.",
      "cites": [
        "wiki:rev:1385850085:225"
      ]
    },
    {
      "t": "2026-11-21T00:00:15Z",
      "text": "The Houthi–Saudi conflict is an ongoing armed conflict involving Saudi and Houthi forces in Yemen and along the Saudi–Yemeni border, including parts of Asir, Jazan, and Najran.",
      "cites": [
        "wiki:rev:1385850085:0"
      ]
    },
    {
      "t": "2026-11-21T00:00:25Z",
      "text": "On 19 November, the Houthis fired missiles at King Abdullah Financial District in Riyadh, damaging the Public Investment Fund Tower and other buildings but causing no injuries.",
      "cites": [
        "wiki:2026-11-19:4"
      ]
    },
    {
      "t": "2026-11-21T00:00:32Z",
      "text": "On 20 November, the Saudi-led coalition launched airstrikes on Hodeidah, Yemen, targeting weapons smuggling used by the Houthis, and on targets in the Sanaa, Saada, and Taiz governorates.",
      "cites": [
        "wiki:2026-11-20:2"
      ]
    },
    {
      "t": "2026-11-21T00:00:41Z",
      "text": "The map shows Riyadh, Saudi Arabia, where the reports place the missile attack.",
      "cites": [
        "wiki:2026-11-21:2"
      ]
    },
    {
      "t": "2026-11-21T00:00:49Z",
      "text": "According to Wikipedia's casualty summary, drawn from its sources, thousands of Yemeni civilians were killed and wounded, and 500+ Saudi civilians were killed.",
      "cites": [
        "wiki:box:1385850085:casualties"
      ]
    },
    {
      "t": "2026-11-21T00:01:06Z",
      "text": "Najran Province is also named in the reports.",
      "cites": [
        "wiki:2026-11-21:2"
      ]
    },
    {
      "t": "2026-11-21T00:01:15Z",
      "text": "The report comes from Al Jazeera.",
      "cites": [
        "wiki:2026-11-21:2"
      ]
    },
    {
      "t": "2026-11-21T00:01:23Z",
      "text": "Al Jazeera headlined it: “Saudi-led coalition intercepts three Houthi missiles headed for Riyadh.”",
      "cites": [
        "news:aljazeera:cb465bd8566b"
      ]
    },
    {
      "t": "2026-11-21T00:01:30Z",
      "text": "France 24 headlined it: “Houthis launch strikes on Saudi Arabia.”",
      "cites": [
        "news:france24:258e24a13d6a"
      ]
    },
    {
      "t": "2026-11-21T00:01:39Z",
