  "beats": [
    {
      "t": "2026-11-21T00:00:01Z",
      "text": "The European Space Agency announces that the BepiColombo spacecraft has inserted itself into orbit around Mercury.",
      "cites": [
        "wiki:2026-11-21:11"
      ]
    },
    {
      "t": "2026-11-21T00:00:08Z",
      "text": "Exploration began with the Mariner 10 flybys in 1974 and 1975, continued with the MESSENGER orbiter from 2011 to 2015, and is set to advance with BepiColombo, which is scheduled to enter orbit in November 2026.",
      "cites": [
        "wiki:rev:1386453192:1"
      ]
    },
    {
      "t": "2026-11-21T00:00:15Z",
      "text": "As the article records, the exploration of Mercury has been limited, making it the least explored of the inner planets.",
      "cites": [
        "wiki:rev:1386453192:0"
      ]
    },
    {
      "t": "2026-11-21T00:00:25Z",
      "text": "The reports place the event in France, at the European Space Agency.",
      "cites": [
        "wiki:2026-11-21:11"
      ]
    },
    {
      "t": "2026-11-21T00:00:33Z",
      "text": "The report comes from AP.",
      "cites": [
        "wiki:2026-11-21:11"
      ]
    },
    {
      "t": "2026-11-21T00:00:41Z",
      "text": "This explainer draws on Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
      "cites": [
