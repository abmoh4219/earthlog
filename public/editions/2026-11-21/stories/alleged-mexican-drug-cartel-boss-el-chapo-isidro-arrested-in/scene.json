  "beats": [
    {
      "t": "2026-11-21T00:00:01Z",
      "text": "The Guardian reports that Mexican special forces arrested an alleged drug cartel boss, ‘El Chapo Isidro’, in a raid.",
      "cites": [
        "news:guardian:2681b8486e62"
      ]
    },
    {
      "t": "2026-11-21T00:00:06Z",
      "text": "Al Jazeera, Sky News, France 24, NPR and DW also reported the arrest.",
      "cites": [
        "news:aljazeera:1b6e22f84ea9",
        "news:sky:b0b444264324",
        "news:france24:4de2de04ed1f",
        "news:npr:5b76dfe3de30",
        "news:dw:0adb20796144"
      ]
    },
    {
      "t": "2026-11-21T00:00:11Z",
      "text": "According to NPR, the firefight in northern Mexico left 11 dead.",
      "cites": [
        "news:npr:5b76dfe3de30"
      ]
    },
    {
      "t": "2026-11-21T00:00:18Z",
      "text": "Inflation in Mexico fell to 3.8% in 2025, from 7.9% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:MX"
      ]
    },
    {
      "t": "2026-11-21T00:00:26Z",
      "text": "Economic growth was 0.6% in 2025, and unemployment stood at 2.7%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:MX",
        "wb:SL.UEM.TOTL.ZS:MX"
      ]
    },
    {
      "t": "2026-11-21T00:00:36Z",
      "text": "Among Latin America and Caribbean countries, Mexico's 3.8% inflation matches the regional median of 3.8%, while Argentina's 219.9% is the highest.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:latin-america-caribbean"
      ]
    },
    {
      "t": "2026-11-21T00:00:50Z",
      "text": "On 16 November, Five gunmen were killed after a shootout between criminal organizations in Chignahuapan, Puebla, Mexico.",
      "cites": [
        "wiki:2026-11-16:6"
      ]
    },
    {
      "t": "2026-11-21T00:00:57Z",
      "text": "On 17 November, the Pan American Health Organization revoked the measles elimination statuses of Bolivia, Mexico, and the United States.",
      "cites": [
        "wiki:2026-11-17:12"
      ]
    },
    {
      "t": "2026-11-21T00:01:06Z",
      "text": "Mexico, officially the United Mexican States, is a country in North America.",
      "cites": [
        "wiki:rev:1386663480:0"
      ]
    },
    {
      "t": "2026-11-21T00:01:17Z",
      "text": "Al Jazeera headlined its report “Mexico captures FBI-wanted cartel boss in military raid”.",
      "cites": [
        "news:aljazeera:1b6e22f84ea9"
      ]
    },
    {
      "t": "2026-11-21T00:01:23Z",
      "text": "Sky News headlined its report “At least 11 dead after suspected cartel leader 'El Chapo Isidro' captured in Mexico”.",
      "cites": [
        "news:sky:b0b444264324"
      ]
    },
    {
      "t": "2026-11-21T00:01:29Z",
      "text": "France 24 headlined its report “Mexico captures drug cartel boss ‘El Chapo Isidro’ after deadly firefight”.",
      "cites": [
        "news:france24:4de2de04ed1f"
      ]
    },
    {
      "t": "2026-11-21T00:01:38Z",
      "text": "This story draws on 6 outlets, Wikipedia articles, Wikimedia pageview counts, Wikidata, and Wikipedia's current events portal pages for 2026 November 16 and 2026 November 17.",
      "cites": [
        "wiki:rev:1386663480:0",
        "views:en:Mexico:30d",
        "wd:Q96:P571",
        "wiki:2026-11-16:6",
        "wiki:2026-11-17:12"
      ]
    },
    {
      "t": "2026-11-21T00:01:39Z",
      "text": "Each caption cites the evidence it rests on.",
      "cites": [
