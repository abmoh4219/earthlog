  "beats": [
    {
      "t": "2026-11-21T00:00:01Z",
      "text": "According to DW, Russia struck Zelenskyy's hometown, killing 2 people.",
      "cites": [
        "news:dw:1c5b88d83c35"
      ]
    },
    {
      "t": "2026-11-21T00:00:09Z",
      "text": "Volodymyr Oleksandrovych Zelenskyy, born 25 January 1978, is a Ukrainian politician and former entertainer who has served as the sixth president of Ukraine since 2019.",
      "cites": [
        "wiki:rev:1386461486:0"
      ]
    },
    {
      "t": "2026-11-21T00:00:18Z",
      "text": "Volodymyr Zelenskyy was born on 25 January 1978 in Kryvyi Rih.",
      "cites": [
        "wd:Q3874799:P569",
        "wd:Q3874799:P19"
      ]
    },
    {
      "t": "2026-11-21T00:00:26Z",
      "text": "He was educated at Kryvyi Rih Lyceum 95 and the Kryvyi Rih Institute of Economics.",
      "cites": [
        "wd:Q3874799:P69:Q134446124",
        "wd:Q3874799:P69:Q12114704"
      ]
    },
    {
      "t": "2026-11-21T00:00:30Z",
      "text": "He worked for Kvartal 95, Inter, 1+1 and the Office of the President of Ukraine, in Kryvyi Rih and Kyiv.",
      "cites": [
        "wd:Q3874799:P108:Q4444575",
        "wd:Q3874799:P108:Q2914786",
        "wd:Q3874799:P108:Q161257",
        "wd:Q3874799:P108:Q5764175",
        "wd:Q3874799:P937:Q157137",
        "wd:Q3874799:P937:Q1899"
      ]
    },
    {
      "t": "2026-11-21T00:00:36Z",
      "text": "Wikidata lists 35 awards, among them The Cross of Good Neighbourliness and the Order of the Republic, both from 2026.",
      "cites": [
        "wd:Q3874799:P166:Q4375456"
      ]
    },
    {
      "t": "2026-11-21T00:00:42Z",
      "text": "He is known for the television series Servant of the People.",
      "cites": [
        "wd:Q3874799:P800:Q21546165"
      ]
    },
    {
      "t": "2026-11-21T00:00:59Z",
      "text": "DW headlined the story: “Russia strikes Zelenskyy's hometown, killing 2”.",
      "cites": [
        "news:dw:1c5b88d83c35"
      ]
    },
    {
      "t": "2026-11-21T00:01:06Z",
      "text": "Al Jazeera headlined its report: “Russian strike kills two, wounds 60, in Zelenskyy’s hometown”.",
