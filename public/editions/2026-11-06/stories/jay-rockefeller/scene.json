  "beats": [
    {
      "t": "2026-11-06T00:00:01Z",
      "text": "Jay Rockefeller died at his home in Washington, D.C., on November 6, 2026, at the age of 89.",
      "cites": [
        "wiki:rev:1384244769:127"
      ]
    },
    {
      "t": "2026-11-06T00:00:08Z",
      "text": "Born June 18, 1937, Jay Rockefeller was an American politician who served as a United States senator from West Virginia from 1985 to 2015 and earlier as its governor from 1977 to 1985.",
      "cites": [
        "wiki:rev:1384244769:0"
      ]
    },
    {
      "t": "2026-11-06T00:00:15Z",
      "text": "He was a member of the Democratic Party.",
      "cites": [
        "wiki:rev:1384244769:1"
      ]
    },
    {
      "t": "2026-11-06T00:00:25Z",
      "text": "Jay Rockefeller was born on 18 June 1937 in Manhattan.",
      "cites": [
        "wd:Q285102:P569",
        "wd:Q285102:P19"
      ]
    },
    {
      "t": "2026-11-06T00:00:33Z",
      "text": "He was educated at Harvard College, Phillips Exeter Academy, St. Albans School and 3 more.",
      "cites": [
        "wd:Q285102:P69:Q49123",
        "wd:Q285102:P69:Q1426464",
        "wd:Q285102:P69:Q7586750",
        "wd:Q285102:P69:Q3017750",
        "wd:Q285102:P69:Q49112",
        "wd:Q285102:P69:Q1141728"
      ]
    },
    {
      "t": "2026-11-06T00:00:40Z",
      "text": "He worked for AmeriCorps VISTA and in Washington, D.C.",
      "cites": [
        "wd:Q285102:P108:Q4742476",
        "wd:Q285102:P937:Q61"
      ]
    },
    {
      "t": "2026-11-06T00:00:49Z",
      "text": "Wikidata records 1 award, the Grand Cordon of the Order of the Rising Sun, received in 2013.",
      "cites": [
        "wd:Q285102:P166:Q55339171"
      ]
    },
    {
      "t": "2026-11-06T00:00:59Z",
      "text": "He died in Washington, D.C., on 6 November 2026, at the age of 89.",
      "cites": [
        "wd:Q285102:P570",
        "wd:Q285102:P20",
        "wd:Q285102:P569"
      ]
    },
    {
      "t": "2026-11-06T00:01:16Z",
      "text": "English Wikipedia recorded 71,552 readers of the article on 6 November 2026, about 156× the usual.",
      "cites": [
        "views:en:Jay_Rockefeller:2026-11-06",
        "views:en:Jay_Rockefeller:prior"
      ]
    },
    {
      "t": "2026-11-06T00:01:23Z",
      "text": "The article was read in 11 languages, and after English the most readers were in Russian, with 4,073.",
      "cites": [
        "views:en:Jay_Rockefeller:2026-11-06",
        "views:ru:Рокфеллер,_Джон_Дэвисон_IV:2026-11-06"
      ]
    },
    {
      "t": "2026-11-06T00:01:30Z",
