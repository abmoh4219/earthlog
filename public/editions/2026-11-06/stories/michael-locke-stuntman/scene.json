    {
      "t": "2026-11-06T00:00:01Z",
      "text": "Michael Richard Locke, known as Pancho, was a Welsh professional stuntman and skateboarder who lived from 13 March 1979 to November 2026.",
      "cites": [
        "wiki:rev:1384234232:0"
      ]
    },
    {
      "t": "2026-11-06T00:00:12Z",
      "text": "He was best known for MTV UK's Dirty Sanchez, and he starred in the 2006 film Dirty Sanchez: The Movie.",
      "cites": [
        "wiki:rev:1384234232:1",
        "wiki:rev:1384234232:2"
      ]
    },
    {
      "t": "2026-11-06T00:00:25Z",
      "text": "Michael Locke was born on 13 March 1979 in Port Talbot.",
      "cites": [
        "wd:Q5962128:P569",
        "wd:Q5962128:P19"
      ]
    },
    {
      "t": "2026-11-06T00:00:42Z",
