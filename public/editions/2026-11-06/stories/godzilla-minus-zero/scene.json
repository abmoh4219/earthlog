  "beats": [
    {
      "t": "2026-11-06T00:00:01Z",
      "text": "Godzilla Minus Zero is a 2026 Japanese epic kaiju film written, directed, and with visual effects by Takashi Yamazaki.",
      "cites": [
        "wiki:rev:1384239405:0"
      ]
    },
    {
      "t": "2026-11-06T00:00:08Z",
      "text": "The film was released in Japan on November 3, 2026, and in North America on November 6, 2026, also in IMAX.",
      "cites": [
        "wiki:rev:1384239405:66"
      ]
    },
    {
      "t": "2026-11-06T00:00:15Z",
      "text": "Toho's subsidiary GKIDS was announced on January 9, 2026 as distributor in North American theatres, three days after the Japanese release.",
      "cites": [
        "wiki:rev:1384239405:69"
      ]
    },
    {
      "t": "2026-11-06T00:00:25Z",
      "text": "Ryunosuke Kamiki, Minami Hamabe, Min Tanaka and Hidetaka Yoshioka star, with music by Naoki Satō.",
      "cites": [
        "wiki:box:1384239405:starring",
        "wiki:box:1384239405:music"
      ]
    },
    {
      "t": "2026-11-06T00:00:30Z",
      "text": "The film was released on 26 September 2026 at NYFF and on 3 November 2026 in Japan.",
      "cites": [
        "wiki:box:1384239405:released"
      ]
    },
    {
      "t": "2026-11-06T00:00:35Z",
      "text": "Wikipedia records its box office as USD 15.4 million.",
      "cites": [
        "wiki:box:1384239405:box-office"
      ]
    },
    {
      "t": "2026-11-06T00:00:43Z",
      "text": "Principal photography with extras took place on location in Ibaraki Prefecture from August 30 to September 14, 2025.",
      "cites": [
        "wiki:film:1384239405:0"
      ]
    },
    {
      "t": "2026-11-06T00:00:49Z",
      "text": "The Hollywood Reporter claimed additional shooting took place in New Zealand and Norway.",
      "cites": [
        "wiki:film:1384239405:0"
      ]
    },
    {
      "t": "2026-11-06T00:00:55Z",
      "text": "The article places the filming in Ibaraki Prefecture, Maizuru, Seijōgakuen-mae Station, Inashiki and Tokyo Dome City Hall.",
      "cites": [
        "wiki:film:1384239405:0",
        "wiki:film:1384239405:6",
        "wiki:film:1384239405:7",
        "wiki:film:1384239405:11"
      ]
    },
    {
      "t": "2026-11-06T00:01:04Z",
      "text": "12 of the people credited have a birthplace on record; all were born in Japan.",
      "cites": [
        "wd:Q1041546:P19",
        "wd:Q1050102:P19",
        "wd:Q1052140:P19",
        "wd:Q1052320:P19",
        "wd:Q1060139:P19",
        "wd:Q11284289:P19",
        "wd:Q11422725:P19",
        "wd:Q1189115:P19",
        "wd:Q1351571:P19",
        "wd:Q20041273:P19",
        "wd:Q253900:P19",
        "wd:Q3108327:P19"
      ]
    },
    {
      "t": "2026-11-06T00:01:16Z",
      "text": "English Wikipedia recorded 122,560 readers of the article on 6 November 2026, about 16× the usual daily count.",
      "cites": [
        "views:en:Godzilla_Minus_Zero:2026-11-06",
        "views:en:Godzilla_Minus_Zero:prior"
      ]
    },
    {
      "t": "2026-11-06T00:01:23Z",
      "text": "The article was read in 11 languages, and after English, Japanese Wikipedia had the most readers, with 20,382.",
      "cites": [
        "views:ja:ゴジラ-0.0:2026-11-06",
        "views:en:Godzilla_Minus_Zero:2026-11-06"
      ]
    },
    {
      "t": "2026-11-06T00:01:30Z",
      "text": "On the globe, each language glows where it is mainly spoken, brighter for more readers; a language is not a country.",
      "cites": [
