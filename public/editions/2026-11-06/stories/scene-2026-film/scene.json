  "beats": [
    {
      "t": "2026-11-06T00:00:01Z",
      "text": "Scene is a 2026 Indian Tamil-language action comedy written and directed by Jithu Madhavan, released on 6 November 2026.",
      "cites": [
        "wiki:rev:1384248457:0",
        "wiki:rev:1384248457:8"
      ]
    },
    {
      "t": "2026-11-06T00:00:08Z",
      "text": "The film opened in the week of Diwali, clashing with Mookuthi Amman 2.",
      "cites": [
        "wiki:rev:1384248457:57"
      ]
    },
    {
      "t": "2026-11-06T00:00:15Z",
      "text": "It received mostly positive reviews from critics.",
      "cites": [
        "wiki:rev:1384248457:8"
      ]
    },
    {
      "t": "2026-11-06T00:00:25Z",
      "text": "Suriya, Naslen and Nazriya Nazim star, with music by Sushin Shyam.",
      "cites": [
        "wiki:box:1384248457:starring",
        "wiki:box:1384248457:music"
      ]
    },
    {
      "t": "2026-11-06T00:00:33Z",
      "text": "The film was released on 6 November 2026, and the Wikipedia infobox records its box office at ₹34.25 crore.",
      "cites": [
        "wiki:box:1384248457:released",
        "wiki:box:1384248457:box-office"
      ]
    },
    {
      "t": "2026-11-06T00:00:43Z",
      "text": "According to the article, filming was placed in Kerala, Kochi and Avadi.",
      "cites": [
        "wiki:film:1384248457:1",
        "wiki:film:1384248457:2",
        "wiki:film:1384248457:6"
      ]
    },
    {
      "t": "2026-11-06T00:00:48Z",
      "text": "Most filming was expected in Kochi, and a set was built at VGN Cosmos in Avadi.",
      "cites": [
        "wiki:film:1384248457:2",
        "wiki:film:1384248457:6"
      ]
    },
    {
      "t": "2026-11-06T00:00:55Z",
      "text": "4 of the credited people have a birthplace on record, and all were born in India.",
      "cites": [
        "wd:Q108385315:P19",
        "wd:Q29453931:P19",
        "wd:Q3165960:P19",
        "wd:Q3345518:P19"
      ]
    },
    {
      "t": "2026-11-06T00:01:00Z",
      "text": "Their recorded birthplaces include Kodungallur, Thalassery, Thiruvananthapuram and Chennai.",
      "cites": [
        "wd:Q108385315:P19",
        "wd:Q29453931:P19",
        "wd:Q3165960:P19",
        "wd:Q3345518:P19"
      ]
    },
    {
      "t": "2026-11-06T00:01:07Z",
      "text": "On 6 November 2026, 159,862 people read the English Wikipedia article, about 47 times the usual.",
      "cites": [
        "views:en:Scene_(2026_film):2026-11-06",
        "views:en:Scene_(2026_film):prior"
      ]
    },
    {
      "t": "2026-11-06T00:01:12Z",
      "text": "Normally the article drew a median of 3,403 readers a day in the 8 to 60 days before.",
      "cites": [
        "views:en:Scene_(2026_film):prior"
      ]
    },
    {
      "t": "2026-11-06T00:01:19Z",
      "text": "The sources are Wikipedia articles, Wikimedia pageviews and Wikidata.",
      "cites": [
        "wiki:rev:1384248457:8",
