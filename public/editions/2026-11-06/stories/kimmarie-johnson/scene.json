  "beats": [
    {
      "t": "2026-11-06T00:00:01Z",
      "text": "On October 27, 2026, Johnson had a heart-related emergency at her Los Angeles home, then was hospitalized at Cedars-Sinai Medical Center with a diagnosed heart aneurysm condition.",
      "cites": [
        "wiki:rev:1384236188:34"
      ]
    },
    {
      "t": "2026-11-06T00:00:08Z",
      "text": "She died on the afternoon of November 4, at the age of 50.",
      "cites": [
        "wiki:rev:1384236188:35"
      ]
    },
    {
      "t": "2026-11-06T00:00:15Z",
      "text": "Born Kim Marie Johnson on April 8, 1976, she was an American actress, model, businesswoman and beauty pageant titleholder.",
      "cites": [
        "wiki:rev:1384236188:0"
      ]
    },
    {
      "t": "2026-11-06T00:00:25Z",
      "text": "Johnson was born in Pittsburgh on 8 April 1976.",
      "cites": [
        "wd:Q6410167:P569",
        "wd:Q6410167:P19"
      ]
    },
    {
      "t": "2026-11-06T00:00:33Z",
      "text": "Johnson was educated at PennWest California.",
      "cites": [
        "wd:Q6410167:P69:Q5021159"
      ]
    },
    {
      "t": "2026-11-06T00:00:43Z",
      "text": "Johnson died on 4 November 2026 in Los Angeles, aged 50.",
      "cites": [
        "wd:Q6410167:P570",
        "wd:Q6410167:P20",
        "wd:Q6410167:P569"
      ]
    },
    {
      "t": "2026-11-06T00:01:00Z",
      "text": "English Wikipedia readers reached 82,033 on 6 November 2026, while the article normally drew a median of 9 readers a day in the weeks before.",
      "cites": [
        "views:en:Kimmarie_Johnson:2026-11-06",
        "views:en:Kimmarie_Johnson:prior"
      ]
    },
    {
      "t": "2026-11-06T00:01:07Z",
      "text": "Readers used 3 languages, and after English, Spanish was the most common with 3,997 readers.",
      "cites": [
        "views:en:Kimmarie_Johnson:2026-11-06",
