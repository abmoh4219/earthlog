  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "A Russian Air Force Antonov An-12 crashed near Kemerovo, Russia, killing all 19 people on board.",
      "cites": [
        "wiki:2026-11-17:10"
      ]
    },
    {
      "t": "2026-11-17T00:00:08Z",
      "text": "The aircraft went down near the village of Yagunovo in Kemerovo Oblast while attempting an emergency landing after an in-flight fire broke out.",
      "cites": [
        "wiki:rev:1386574419:0"
      ]
    },
    {
      "t": "2026-11-17T00:00:15Z",
      "text": "As of 19 November 2026, the final cause of the crash had not been publicly established.",
      "cites": [
        "wiki:rev:1386574419:17"
      ]
    },
    {
      "t": "2026-11-17T00:00:30Z",
      "text": "The plane crashed during an emergency landing, possibly due to an in-flight fire, and the crash is under investigation.",
      "cites": [
        "wiki:box:1386574419:summary"
      ]
    },
    {
      "t": "2026-11-17T00:00:39Z",
      "text": "The aircraft was an Antonov An-12BK, operated by the Russian Air Force.",
      "cites": [
        "wiki:box:1386574419:aircraft",
        "wiki:box:1386574419:operator"
      ]
    },
    {
      "t": "2026-11-17T00:00:48Z",
      "text": "There were 19 occupants, and according to the record, all 19 died while there were no survivors.",
      "cites": [
        "wiki:box:1386574419:occupants",
        "wiki:box:1386574419:fatalities",
        "wiki:box:1386574419:survivors"
      ]
    },
    {
      "t": "2026-11-17T00:00:53Z",
      "text": "The Russian Ministry of Defence stated that a technical malfunction was the preliminary suspected cause of the crash.",
      "cites": [
        "wiki:investigation:1386574419:0"
      ]
    },
    {
      "t": "2026-11-17T00:01:00Z",
      "text": "A commission from the Russian Aerospace Forces was sent to the crash site to investigate the circumstances of the accident.",
      "cites": [
        "wiki:investigation:1386574419:1"
      ]
    },
    {
      "t": "2026-11-17T00:01:07Z",
      "text": "The Investigative Committee of Russia opened a criminal investigation into possible violations of flight safety regulations.",
      "cites": [
        "wiki:investigation:1386574419:2"
      ]
    },
    {
      "t": "2026-11-17T00:01:15Z",
      "text": "The crash was reported by AP and The Independent.",
      "cites": [
        "wiki:2026-11-17:10"
      ]
    },
    {
      "t": "2026-11-17T00:01:23Z",
      "text": "BBC News headlined it: “Russian military plane crashes, killing all 19 on board”.",
      "cites": [
        "news:bbc:0936839706b7"
      ]
    },
    {
      "t": "2026-11-17T00:01:30Z",
      "text": "Al Jazeera headlined it: “Moment Russian military plane crashes in Siberia, killing 19”.",
      "cites": [
        "news:aljazeera:c67b59e038c2"
      ]
    },
    {
      "t": "2026-11-17T00:01:39Z",
      "text": "This explainer draws on Wikipedia and its current events pages, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-17:10",
        "wiki:rev:1386574419:17"
      ]
    }
