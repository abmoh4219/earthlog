  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "Trump has arrived in the Philippines to kick off an Asia trip, NPR reports.",
      "cites": [
        "news:npr:0a5288e228d8"
      ]
    },
    {
      "t": "2026-11-17T00:00:09Z",
      "text": "France 24, DW and BBC News also covered the trip, which is set to include talks with Xi and Putin.",
      "cites": [
        "news:france24:eacedd0e2220",
        "news:dw:bda6332dd0f0",
        "news:bbc:26c8ffc003ab"
      ]
    },
    {
      "t": "2026-11-17T00:00:18Z",
      "text": "Inflation in the Philippines fell to 1.7% in 2025, down from 6.0% in 2023.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:PH"
      ]
    },
    {
      "t": "2026-11-17T00:00:26Z",
      "text": "The economy grew 4.4% in 2025, and unemployment stood at 2.2%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:PH",
        "wb:SL.UEM.TOTL.ZS:PH"
      ]
    },
    {
      "t": "2026-11-17T00:00:36Z",
      "text": "Across East Asia and Pacific, the Philippines' 1.7% compares with a median of 2.1%, while the highest is Mongolia at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-17T00:00:50Z",
      "text": "The Philippines, officially the Republic of the Philippines, is an archipelagic country in Southeast Asia.",
      "cites": [
        "wiki:rev:1385713286:0"
      ]
    },
    {
      "t": "2026-11-17T00:01:01Z",
      "text": "France 24 headlined its report: Trump kicks off Asia trip that will see nuclear talks with Xi, Putin.",
      "cites": [
        "news:france24:eacedd0e2220"
      ]
    },
    {
      "t": "2026-11-17T00:01:07Z",
      "text": "DW's headline read: Trump kicks off Asia tour ahead of major talks with Putin, Xi in China.",
      "cites": [
        "news:dw:bda6332dd0f0"
      ]
    },
    {
      "t": "2026-11-17T00:01:13Z",
      "text": "NPR's headline was: Trump arrives in Philippines to kick off Asia trip.",
      "cites": [
        "news:npr:0a5288e228d8"
      ]
    },
    {
      "t": "2026-11-17T00:01:22Z",
      "text": "Sources include France 24, DW, NPR and BBC News, Wikipedia articles, Wikimedia pageviews, Wikidata and World Bank Open Data, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:rev:1385713286:0",
        "views:en:Philippines:30d",
