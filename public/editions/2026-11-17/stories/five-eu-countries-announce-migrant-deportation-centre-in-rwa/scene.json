  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "Five EU states have announced plans for immigration ‘return hubs’ in Rwanda, according to The Guardian.",
      "cites": [
        "news:guardian:8a89a626759e"
      ]
    },
    {
      "t": "2026-11-17T00:00:09Z",
      "text": "Al Jazeera, AllAfrica, DW and France 24 also reported on the plans.",
      "cites": [
        "news:aljazeera:79d73ca14561",
        "news:allafrica:592a5d60f12d",
        "news:dw:9c6685ac3d74",
        "news:france24:70eea9f76cd8"
      ]
    },
    {
      "t": "2026-11-17T00:00:18Z",
      "text": "Inflation in Rwanda fell to 5.9% in 2025, from 19.8% in 2023.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:RW"
      ]
    },
    {
      "t": "2026-11-17T00:00:26Z",
      "text": "The economy grew 9.4% in 2025, and unemployment stood at 11.4%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:RW",
        "wb:SL.UEM.TOTL.ZS:RW"
      ]
    },
    {
      "t": "2026-11-17T00:00:36Z",
      "text": "Across Sub-Saharan Africa, Rwanda's 5.9% compares with a median of 3.5%, while South Sudan is highest at 91.4%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:sub-saharan-africa"
      ]
    },
    {
      "t": "2026-11-17T00:00:50Z",
      "text": "Rwanda, officially the Republic of Rwanda, is a landlocked country in East Africa.",
      "cites": [
        "wiki:rev:1386530081:0"
      ]
    },
    {
      "t": "2026-11-17T00:01:01Z",
      "text": "The Guardian headlined its report “Five EU states announce plans for immigration ‘return hubs’ in Rwanda”.",
      "cites": [
        "news:guardian:8a89a626759e"
      ]
    },
    {
      "t": "2026-11-17T00:01:07Z",
      "text": "Al Jazeera headlined its report “EU countries announce migrant deportation centre in Rwanda”.",
      "cites": [
        "news:aljazeera:79d73ca14561"
      ]
    },
    {
      "t": "2026-11-17T00:01:13Z",
      "text": "AllAfrica headlined its report “Rwanda: What to Know About Migrant Partnership Between Rwanda and Five EU Countries”.",
      "cites": [
        "news:allafrica:592a5d60f12d"
      ]
    },
    {
      "t": "2026-11-17T00:01:22Z",
      "text": "This explainer draws on The Guardian, Al Jazeera, AllAfrica, DW and France 24, Wikipedia, Wikimedia pageviews, Wikidata and World Bank Open Data.",
      "cites": [
        "wiki:rev:1386530081:0",
        "views:en:Rwanda:30d",
        "wd:Q1037:P571",
        "wb:FP.CPI.TOTL.ZG:region:sub-saharan-africa"
      ]
    }
