  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "Police and 42 platoons of the Border Guard Bangladesh have deployed tear gas, stun grenades, batons and surveillance drones against garment workers across Dhaka, Savar, Ashulia, Gazipur and Narayanganj.",
      "cites": [
        "wiki:2026-11-17:8"
      ]
    },
    {
      "t": "2026-11-17T00:00:08Z",
      "text": "On 14 November, protests restarted in Ashulia and Gazipur, where police clashed with demonstrators in the Palli Bidyut area.",
      "cites": [
        "wiki:rev:1386419794:71"
      ]
    },
    {
      "t": "2026-11-17T00:00:15Z",
      "text": "The 2026 Bangladesh garment workers protests are labour demonstrations in the ready-made garment industry, demanding that the sector's minimum monthly wage rise from ৳12,500 to ৳30,000.",
      "cites": [
        "wiki:rev:1386419794:0"
      ]
    },
    {
      "t": "2026-11-17T00:00:25Z",
      "text": "Inflation in Bangladesh was 8.8% in 2025, down from 10.5% in 2024.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:BD"
      ]
    },
    {
      "t": "2026-11-17T00:00:33Z",
      "text": "The economy grew 3.5% in 2025, and unemployment stood at 3.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:BD",
        "wb:SL.UEM.TOTL.ZS:BD"
      ]
    },
    {
      "t": "2026-11-17T00:00:43Z",
      "text": "Among South Asian countries with 2025 figures, Bangladesh's 8.8% inflation is the highest, against a median of 2.7%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:south-asia"
      ]
    },
    {
      "t": "2026-11-17T00:00:57Z",
      "text": "On 11 November, at least 50 garment factories shut down in Savar and Ashulia as police used tear gas and stun grenades to disperse striking workers blocking roads.",
      "cites": [
        "wiki:2026-11-11:6"
      ]
    },
    {
      "t": "2026-11-17T00:01:04Z",
      "text": "On 12 November, over 200 garment factories shut down as workers blocked the Dhaka–Tangail Highway in Gazipur, and police fired stun grenades at the protesting workers.",
      "cites": [
        "wiki:2026-11-12:6"
      ]
    },
    {
      "t": "2026-11-17T00:01:13Z",
      "text": "The reporting is credited to AFP and The Hindu.",
      "cites": [
        "wiki:2026-11-17:8"
      ]
    },
    {
      "t": "2026-11-17T00:01:21Z",
      "text": "Al Jazeera ran the headline “Bangladesh police clash with garment workers amid protests over wages”.",
      "cites": [
        "news:aljazeera:e4dfd40a3424"
      ]
    },
    {
      "t": "2026-11-17T00:01:32Z",
      "text": "The sources are Wikipedia's current events and article pages, Wikimedia pageviews, Wikidata, and Wikipedia's Portal:Current events/2026 November 11.",
      "cites": [
        "wiki:2026-11-17:8",
        "wiki:rev:1386419794:71",
        "views:en:2026_Bangladesh_garment_workers_protests:30d",
        "wd:Q142084937:P31",
        "wiki:2026-11-11:6"
      ]
    },
    {
      "t": "2026-11-17T00:01:33Z",
      "text": "Every caption in this film is linked to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-17:8"
      ]
