  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "Racing NSW has launched an investigation after the body of losing horse So You Are was found in a skip bin in Sydney, Australia.",
      "cites": [
        "wiki:2026-11-17:22"
      ]
    },
    {
      "t": "2026-11-17T00:00:09Z",
      "text": "The 2026 Melbourne Cup, known commercially as the 2026 Lexus Melbourne Cup, was the 166th running of the Melbourne Cup, an Australian thoroughbred horse race.",
      "cites": [
        "wiki:rev:1383838055:0"
      ]
    },
    {
      "t": "2026-11-17T00:00:18Z",
      "text": "The 2026 Melbourne Cup was held at Flemington Racecourse in Melbourne, Australia.",
      "cites": [
        "wiki:box:1383838055:venue"
      ]
    },
    {
      "t": "2026-11-17T00:00:26Z",
      "text": "Point Of Law won the race, ridden by Ethan Brown and trained by Ciaron Maher.",
      "cites": [
        "wiki:box:1383838055:winner",
        "wiki:box:1383838055:jockey",
        "wiki:box:1383838055:trainer"
      ]
    },
    {
      "t": "2026-11-17T00:00:34Z",
      "text": "The attendance was 97,112 people.",
      "cites": [
        "wiki:box:1383838055:attendance"
      ]
    },
    {
      "t": "2026-11-17T00:00:43Z",
      "text": "The story was reported by CNN and The Guardian Australia.",
      "cites": [
        "wiki:2026-11-17:22"
      ]
    },
    {
      "t": "2026-11-17T00:00:51Z",
      "text": "The Guardian headlined its story, “‘Disgusted by it’: body of Melbourne Cup race horse found dumped in Sydney skip bin.”",
      "cites": [
        "news:guardian:35f3abf59700"
      ]
    },
    {
      "t": "2026-11-17T00:00:57Z",
      "text": "BBC News headlined its story, “Body of Melbourne Cup horse found dumped in Sydney skip.”",
      "cites": [
        "news:bbc:897b0115ae99"
      ]
    },
    {
      "t": "2026-11-17T00:01:03Z",
      "text": "Sky News headlined its story, “Three Melbourne Cup trophies worth £500k each stolen.”",
      "cites": [
        "news:sky:8d39205f7be3"
      ]
    },
