  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "Al Jazeera reports that the UK has handed a NATO-assigned US soldier, accused of spying for Russia, over to US military authorities.",
      "cites": [
        "news:aljazeera:63199757c5cf"
      ]
    },
    {
      "t": "2026-11-17T00:00:09Z",
      "text": "BBC News also reports that the American soldier, arrested by UK police on suspicion of spying, has been taken into US military custody.",
      "cites": [
        "news:bbc:519aa89e59eb"
      ]
    },
    {
      "t": "2026-11-17T00:00:18Z",
      "text": "Inflation in Russia was 8.7% in 2025, down from 13.7% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:RU"
      ]
    },
    {
      "t": "2026-11-17T00:00:26Z",
      "text": "In 2025 the economy grew 1.0%, and unemployment stood at 2.1%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:RU",
        "wb:SL.UEM.TOTL.ZS:RU"
      ]
    },
    {
      "t": "2026-11-17T00:00:36Z",
      "text": "Across Europe and Central Asia, Russia's 8.7% compares with a median of 3.8%, while the highest is Turkey at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-17T00:00:50Z",
      "text": "Russia, or the Russian Federation, is a country in Eastern Europe and North Asia.",
      "cites": [
        "wiki:rev:1385581049:0"
      ]
    },
    {
      "t": "2026-11-17T00:01:01Z",
      "text": "Al Jazeera headlined the story: UK hands NATO-assigned US soldier accused of Russia spying to US military.",
      "cites": [
        "news:aljazeera:63199757c5cf"
      ]
    },
    {
      "t": "2026-11-17T00:01:08Z",
      "text": "BBC News headlined its version: American soldier arrested by UK police on suspicion of spying taken into US military custody.",
      "cites": [
