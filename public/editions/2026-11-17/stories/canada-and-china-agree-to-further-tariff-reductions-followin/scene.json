  "beats": [
    {
      "t": "2026-11-17T00:00:01Z",
      "text": "Canada and China have agreed to further tariff reductions, following talks between prime minister Mark Carney and Chinese leader Xi Jinping before the APEC summit in Shenzhen.",
      "cites": [
        "wiki:2026-11-17:9"
      ]
    },
    {
      "t": "2026-11-17T00:00:06Z",
      "text": "China is reducing tariffs on C$400 million (¥1.8 billion) in Canadian exports, while Canada extends relief for Chinese steel and aluminium.",
      "cites": [
        "wiki:2026-11-17:9"
      ]
    },
    {
      "t": "2026-11-17T00:00:11Z",
      "text": "Diplomatic relations between the two countries officially date back to January 9, 1909, when Canada first established a foreign ministry, while Canada was still part of the British Empire.",
      "cites": [
        "wiki:rev:1384934955:0"
      ]
    },
    {
      "t": "2026-11-17T00:00:18Z",
      "text": "Inflation in China fell to 0.1% in 2025, down from 2.4% in 2020.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:CN"
      ]
    },
    {
      "t": "2026-11-17T00:00:26Z",
      "text": "Economic growth was 5.0% in 2025, and unemployment stood at 4.6%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:CN",
        "wb:SL.UEM.TOTL.ZS:CN"
      ]
    },
    {
      "t": "2026-11-17T00:00:36Z",
      "text": "Across East Asia & Pacific, China's 0.1% inflation compares with a median of 2.1%, while Mongolia has the highest rate at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-17T00:00:50Z",
      "text": "This report was filed by AFP.",
      "cites": [
        "wiki:2026-11-17:9"
      ]
    },
    {
      "t": "2026-11-17T00:00:58Z",
      "text": "France 24 headlined the story: “China, Canada agree to further reduce tariffs at APEC summit in Shenzhen.”",
      "cites": [
        "news:france24:0b512dc4301c"
      ]
    },
    {
      "t": "2026-11-17T00:01:04Z",
      "text": "Al Jazeera's headline read: “China, Canada expand tariff relief after Carney-Xi meeting.”",
      "cites": [
        "news:aljazeera:b9e196c3311f"
      ]
    },
    {
      "t": "2026-11-17T00:01:10Z",
      "text": "BBC News separately headlined: “Nvidia dismisses 'Bring Jensen Back' campaign as Trump backs effort to reinstate ex CEO.”",
      "cites": [
        "news:bbc:6b3f9293b8b2"
      ]
    },
    {
      "t": "2026-11-17T00:01:19Z",
      "text": "Sources are Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews, Wikidata and World Bank Open Data (World Development Indicators).",
