  "beats": [
    {
      "t": "2026-11-20T00:00:01Z",
      "text": "Larry Poindexter was hit by a car on November 14, 2026, while crossing a street outside his Studio City apartment.",
      "cites": [
        "wiki:rev:1386808035:19"
      ]
    },
    {
      "t": "2026-11-20T00:00:08Z",
      "text": "He was hospitalized and was due to undergo surgery for his injuries when he died suddenly on November 18.",
      "cites": [
        "wiki:rev:1386808035:20"
      ]
    },
    {
      "t": "2026-11-20T00:00:15Z",
      "text": "Poindexter (December 16, 1959 – November 18, 2026) was an American actor and singer.",
      "cites": [
        "wiki:rev:1386808035:0"
      ]
    },
    {
      "t": "2026-11-20T00:00:25Z",
      "text": "He was born on 16 December 1959 in Dallas.",
      "cites": [
        "wd:Q1806102:P569",
        "wd:Q1806102:P19"
      ]
    },
    {
      "t": "2026-11-20T00:00:33Z",
      "text": "He was educated at Aviation High School.",
      "cites": [
        "wd:Q1806102:P69:Q4828640"
      ]
    },
    {
      "t": "2026-11-20T00:00:43Z",
      "text": "He died on 18 November 2026 in Los Angeles, aged 66.",
      "cites": [
        "wd:Q1806102:P570",
        "wd:Q1806102:P20",
        "wd:Q1806102:P569"
      ]
    },
    {
      "t": "2026-11-20T00:01:00Z",
      "text": "On 20 November 2026, 51,192 people read the English article, about 948 times the usual daily count.",
      "cites": [
        "views:en:Larry_Poindexter:2026-11-20",
        "views:en:Larry_Poindexter:prior"
      ]
    },
    {
      "t": "2026-11-20T00:01:07Z",
      "text": "The article was read in 8 languages, and after English, German was the most read with 17,819 readers.",
      "cites": [
        "views:en:Larry_Poindexter:2026-11-20",
        "views:de:Larry_Poindexter:2026-11-20"
      ]
    },
    {
      "t": "2026-11-20T00:01:14Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:de:Larry_Poindexter:2026-11-20",
