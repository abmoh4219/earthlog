    {
      "t": "2026-11-20T00:00:15Z",
      "text": "Donald John Trump, born June 14, 1946, is an American politician, media personality, and businessman who is the 47th president of the United States.",
      "cites": [
        "wiki:rev:1386836334:0"
      ]
    },
    {
      "t": "2026-11-20T00:00:25Z",
      "text": "Trump was born on 14 June 1946 at Jamaica Hospital Medical Center.",
      "cites": [
        "wd:Q22686:P569",
        "wd:Q22686:P19"
      ]
    },
    {
      "t": "2026-11-20T00:00:33Z",
      "text": "He was educated at The Kew-Forest School, the University of Pennsylvania, New York Military Academy and 2 more.",
      "cites": [
        "wd:Q22686:P69:Q7744153",
        "wd:Q22686:P69:Q49117",
        "wd:Q22686:P69:Q7013764",
        "wd:Q22686:P69:Q130965",
        "wd:Q22686:P69:Q1329269"
      ]
    },
    {
      "t": "2026-11-20T00:00:44Z",
      "text": "He worked for The Trump Organization, in New York City and in Washington, D.C.",
      "cites": [
        "wd:Q22686:P108:Q2462124",
        "wd:Q22686:P937:Q60",
        "wd:Q22686:P937:Q61"
      ]
    },
    {
      "t": "2026-11-20T00:00:56Z",
      "text": "Wikidata lists 29 awards, among them the FIFA Peace Prize (2025) and the Israel Prize (2026).",
      "cites": [
        "wd:Q22686:P166:Q6189894"
      ]
    },
    {
      "t": "2026-11-20T00:01:02Z",
      "text": "He is known for Trump: The Art of the Deal, Crippled America and The Apprentice.",
      "cites": [
        "wd:Q22686:P800:Q7847758",
        "wd:Q22686:P800:Q21427293",
        "wd:Q22686:P800:Q863122"
      ]
    },
    {
