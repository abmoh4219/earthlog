  "beats": [
    {
      "t": "2026-11-20T00:00:01Z",
      "text": "Iraqi prime minister Ali al-Zaidi announces an agreement with Kata'ib Hezbollah to set up a joint operations center and station troops together in Jurf al-Sakhar, south of Baghdad.",
      "cites": [
        "wiki:2026-11-20:9"
      ]
    },
    {
      "t": "2026-11-20T00:00:08Z",
      "text": "After months of fraught negotiations, a new government was agreed on November 11.",
      "cites": [
        "wiki:rev:1380999327:82"
      ]
    },
    {
      "t": "2026-11-20T00:00:15Z",
      "text": "The constitution adopted in 2005 defines the Republic of Iraq as a federal democratic parliamentary republic.",
      "cites": [
        "wiki:rev:1380999327:0"
      ]
    },
    {
      "t": "2026-11-20T00:00:25Z",
      "text": "The reports place Jurf al-Sakhar in Iraq, south of Baghdad.",
      "cites": [
        "wiki:2026-11-20:9"
      ]
    },
    {
      "t": "2026-11-20T00:00:33Z",
      "text": "Baghdad is also named in the reports.",
      "cites": [
        "wiki:2026-11-20:9"
      ]
    },
    {
      "t": "2026-11-20T00:00:42Z",
      "text": "Al Jazeera reported the story.",
      "cites": [
        "wiki:2026-11-20:9"
      ]
    },
    {
      "t": "2026-11-20T00:00:50Z",
      "text": "France 24 headlined it: “Iraqi security forces deploy in Hezbollah stronghold under compromise deal”.",
      "cites": [
        "news:france24:1654847de472"
      ]
    },
    {
      "t": "2026-11-20T00:00:57Z",
      "text": "Al Jazeera headlined it: “Kataib Hezbollah faces deadline to leave Iraqi stronghold”.",
      "cites": [
        "news:aljazeera:4dd2dad723dc"
      ]
    },
