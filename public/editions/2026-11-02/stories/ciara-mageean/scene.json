  "beats": [
    {
      "t": "2026-11-02T00:00:01Z",
      "text": "Ciara Mageean was an Irish middle-distance runner, born on 12 March 1992 and died on 1 November 2026.",
      "cites": [
        "wiki:rev:1383711885:0"
      ]
    },
    {
      "t": "2026-11-02T00:00:08Z",
      "text": "She died at Belfast's Marie Curie Hospice on 1 November 2026, aged 34.",
      "cites": [
        "wiki:rev:1383711885:43"
      ]
    },
    {
      "t": "2026-11-02T00:00:15Z",
      "text": "A funeral was held on 3 November at St Patrick's Church in Portaferry, with burial in the adjoining cemetery.",
      "cites": [
        "wiki:rev:1383711885:44"
      ]
    },
    {
      "t": "2026-11-02T00:00:25Z",
      "text": "Born in Portaferry on 12 March 1992, she came from the town on the Ards Peninsula.",
      "cites": [
        "wd:Q2913482:P569",
        "wd:Q2913482:P19"
      ]
    },
    {
      "t": "2026-11-02T00:00:33Z",
      "text": "She was educated at University College Dublin.",
      "cites": [
        "wd:Q2913482:P69:Q1068258"
      ]
    },
    {
      "t": "2026-11-02T00:00:43Z",
      "text": "She died in Belfast on 1 November 2026, aged 34.",
      "cites": [
