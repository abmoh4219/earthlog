  "beats": [
    {
      "t": "2026-11-02T00:00:01Z",
      "text": "Susan Saint James died from pancreatic cancer at a hospital in Los Angeles on October 26, 2026, at the age of 80.",
      "cites": [
        "wiki:rev:1383321542:47"
      ]
    },
    {
      "t": "2026-11-02T00:00:09Z",
      "text": "She was an American actress, born Susan Jane Miller, with the dates August 14, 1946 to October 26, 2026.",
      "cites": [
        "wiki:rev:1383321542:0"
      ]
    },
    {
      "t": "2026-11-02T00:00:18Z",
      "text": "Susan Saint James was born on 14 August 1946 in Los Angeles.",
      "cites": [
        "wd:Q259559:P569",
        "wd:Q259559:P19"
      ]
    },
    {
      "t": "2026-11-02T00:00:26Z",
      "text": "She was educated at Connecticut College.",
      "cites": [
        "wd:Q259559:P69:Q1797448"
      ]
    },
    {
      "t": "2026-11-02T00:00:36Z",
      "text": "4 awards are on record for her, including the Connecticut Women's Hall of Fame in 1994 and a star on the Hollywood Walk of Fame in 2008.",
      "cites": [
        "wd:Q259559:P166:Q5161648",
        "wd:Q259559:P166:Q17985761",
        "wd:Q259559:P166:Q989450",
        "wd:Q259559:P166:Q1285504"
      ]
    },
    {
      "t": "2026-11-02T00:00:46Z",
      "text": "Susan Saint James died on 26 October 2026 in Los Angeles, aged 80.",
      "cites": [
        "wd:Q259559:P570",
        "wd:Q259559:P20",
        "wd:Q259559:P569"
      ]
    },
    {
      "t": "2026-11-02T00:00:54Z",
      "text": "Readers also turned to the article on Dick Ebersol, which drew 106,158 readers.",
      "cites": [
        "views:en:Dick_Ebersol:2026-11-02"
      ]
    },
    {
      "t": "2026-11-02T00:01:03Z",
      "text": "On 2 November 2026, 252,010 people read the English article, about 350 times the usual median of 720 readers a day.",
      "cites": [
        "views:en:Susan_Saint_James:2026-11-02",
        "views:en:Susan_Saint_James:prior"
      ]
    },
    {
      "t": "2026-11-02T00:01:10Z",
      "text": "The article was read in 11 languages, and after English the most readers were in Spanish, with 1,242.",
      "cites": [
        "views:en:Susan_Saint_James:2026-11-02",
        "views:es:Susan_Saint_James:2026-11-02"
      ]
    },
    {
      "t": "2026-11-02T00:01:17Z",
      "text": "On the globe, each language glows where it is mainly spoken, brighter for more readers; a language is not a country.",
