    {
      "t": "2026-11-08T00:00:00Z",
      "text": "No clear winner in New Zealand election, as leaders prepare for weeks of talks, NPR reports.",
      "cites": [
        "news:npr:ab240c5c1385"
      ]
    },
    {
      "t": "2026-11-08T00:00:09Z",
      "text": "Also reported by France 24.",
      "cites": [
        "news:france24:fa314d7e4925"
      ]
    },
    {
      "t": "2026-11-08T00:00:17Z",
      "text": "Inflation in New Zealand was 2.8% in 2025, down from 7.2% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:NZ"
      ]
    },
    {
      "t": "2026-11-08T00:00:26Z",
      "text": "The economy grew 0.5% in 2025; unemployment stood at 5.1%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:NZ",
        "wb:SL.UEM.TOTL.ZS:NZ"
      ]
    },
    {
      "t": "2026-11-08T00:00:35Z",
      "text": "Across East Asia & Pacific, New Zealand's 2.8% compares with a median of 2.1%; the highest is Mongolia at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-08T00:00:49Z",
      "text": "New Zealand is an island country in the southwestern Pacific Ocean.",
      "cites": [
        "wiki:rev:1384140005:0"
      ]
    },
    {
      "t": "2026-11-08T00:01:00Z",
      "text": "France 24 headlined it: “New Zealand's knife-edge parliamentary election delivers no clear winner”",
      "cites": [
        "news:france24:fa314d7e4925"
      ]
    },
    {
      "t": "2026-11-08T00:01:08Z",
      "text": "NPR headlined it: “No clear winner in New Zealand election, as leaders prepare for weeks of talks”",
      "cites": [
        "news:npr:ab240c5c1385"
      ]
    },
