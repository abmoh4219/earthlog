  "beats": [
    {
      "t": "2026-11-08T00:00:00Z",
      "text": "At least 21 killed after migrant boat sinks off Senegal, DW reports.",
      "cites": [
        "news:dw:85de81bd8398"
      ]
    },
    {
      "t": "2026-11-08T00:00:09Z",
      "text": "Also reported by Al Jazeera and France 24.",
      "cites": [
        "news:aljazeera:b64af1b67821",
        "news:france24:c7e270d5fde4"
      ]
    },
    {
      "t": "2026-11-08T00:00:17Z",
      "text": "Inflation in Senegal was 1.5% in 2025, down from 9.7% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:SN"
      ]
    },
    {
      "t": "2026-11-08T00:00:26Z",
      "text": "The economy grew 6.7% in 2025; unemployment stood at 2.7%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:SN",
        "wb:SL.UEM.TOTL.ZS:SN"
      ]
    },
    {
      "t": "2026-11-08T00:00:35Z",
      "text": "Across Sub-Saharan Africa, Senegal's 1.5% compares with a median of 3.5%; the highest is South Sudan at 91.4%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:sub-saharan-africa"
      ]
    },
    {
      "t": "2026-11-08T00:00:49Z",
      "text": "Senegal, officially the Republic of Senegal, is the westernmost country of mainland West Africa, situated along the Atlantic Ocean coast.",
      "cites": [
        "wiki:rev:1384463039:0"
      ]
    },
    {
      "t": "2026-11-08T00:01:00Z",
      "text": "Al Jazeera headlined it: “At least 34 dead as small boat sinks off Senegal”",
      "cites": [
        "news:aljazeera:b64af1b67821"
      ]
    },
    {
      "t": "2026-11-08T00:01:07Z",
      "text": "DW headlined it: “At least 21 killed after migrant boat sinks off Senegal”",
      "cites": [
        "news:dw:85de81bd8398"
      ]
    },
    {
      "t": "2026-11-08T00:01:14Z",
      "text": "France 24 headlined it: “Migrant boat sinks off Senegal, killing at least 34 people, authorities say”",
      "cites": [
        "news:france24:c7e270d5fde4"
      ]
    },
    {
      "t": "2026-11-08T00:01:21Z",
      "text": "Sources: Al Jazeera, DW and France 24, Wikipedia articles, Wikimedia pageviews, Wikidata and World Bank Open Data (World Development Indicators). Every caption links to the evidence it rests on.",
      "cites": [
