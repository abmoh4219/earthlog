    {
      "t": "2026-11-08T00:00:00Z",
      "text": "In stock car racing, Hendrick Motorsports' driver Kyle Larson wins his third career NASCAR Cup Series championship, becoming the first driver to win two consecutive championships since 2010.",
      "cites": [
        "wiki:2026-11-08:9"
      ]
    },
    {
      "t": "2026-11-08T00:00:08Z",
      "text": "The season ended at Homestead–Miami Speedway on November 8.",
      "cites": [
        "wiki:rev:1384610001:2"
      ]
    },
    {
      "t": "2026-11-08T00:00:16Z",
      "text": "The 2026 NASCAR Cup Series was the 78th season for NASCAR professional stock car racing in the United States and the 55th season for the modern-era Cup Series.",
      "cites": [
        "wiki:rev:1384610001:0"
      ]
    },
    {
