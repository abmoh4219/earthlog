  "beats": [
    {
      "t": "2026-11-08T00:00:00Z",
      "text": "NVIDIA announces it is opening an investigation into CEO Jensen Huang, after American intelligence reported that a close associate of Huang was a spy for China.",
      "cites": [
        "wiki:2026-11-08:6"
      ]
    },
    {
      "t": "2026-11-08T00:00:10Z",
      "text": "The decision came from the Nvidia, in Santa Clara.",
      "cites": [
        "wd:Q182477:P159",
        "wiki:2026-11-08:6"
      ]
    },
    {
      "t": "2026-11-08T00:00:18Z",
      "text": "Inflation in China was 0.1% in 2025, down from 2.4% in 2020.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:CN"
      ]
    },
    {
      "t": "2026-11-08T00:00:27Z",
      "text": "The economy grew 5.0% in 2025; unemployment stood at 4.6%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:CN",
        "wb:SL.UEM.TOTL.ZS:CN"
      ]
    },
    {
      "t": "2026-11-08T00:00:36Z",
      "text": "Across East Asia & Pacific, China's 0.1% compares with a median of 2.1%; the highest is Mongolia at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-08T00:00:50Z",
      "text": "Reported by The New York Times.",
      "cites": [
        "wiki:2026-11-08:6"
      ]
    },
    {
      "t": "2026-11-08T00:00:58Z",
      "text": "Sky News headlined it: “AI giant Nvidia launches investigation into CEO's affair with 'Chinese spy'”",
      "cites": [
        "news:sky:0d208e2c1172"
      ]
    },
    {
      "t": "2026-11-08T00:01:05Z",
      "text": "Al Jazeera headlined it: “US chipmaker Nvidia investigates CEO Jensen Huang over affair”",
      "cites": [
        "news:aljazeera:24c01244f068"
      ]
    },
    {
      "t": "2026-11-08T00:01:12Z",
      "text": "France 24 headlined it: “Nvidia to probe reports that Chinese intelligence targeted CEO Jensen Huang”",
      "cites": [
        "news:france24:cbcae134d3b9"
      ]
    },
    {
      "t": "2026-11-08T00:01:19Z",
