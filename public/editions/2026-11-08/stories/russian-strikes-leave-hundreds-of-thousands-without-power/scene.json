  "beats": [
    {
      "t": "2026-11-08T00:00:00Z",
      "text": "Russian strikes on Ukraine leave hundreds of thousands without electricity, Al Jazeera reports.",
      "cites": [
        "news:aljazeera:0305d66ded68"
      ]
    },
    {
      "t": "2026-11-08T00:00:09Z",
      "text": "Also reported by France 24.",
      "cites": [
        "news:france24:c719f8373e32"
      ]
    },
    {
      "t": "2026-11-08T00:00:17Z",
      "text": "Inflation in Ukraine was 12.7% in 2025, down from 20.2% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:UA"
      ]
    },
    {
      "t": "2026-11-08T00:00:26Z",
      "text": "The economy grew 1.8% in 2025; unemployment stood at 9.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:UA",
        "wb:SL.UEM.TOTL.ZS:UA"
      ]
    },
    {
      "t": "2026-11-08T00:00:35Z",
      "text": "Across Europe & Central Asia, Ukraine's 12.7% compares with a median of 3.8%; the highest is Turkey at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-08T00:00:49Z",
      "text": "Ukraine is the second-largest country in Europe after Russia, which borders it to the east and northeast.",
      "cites": [
        "wiki:rev:1384509897:0"
      ]
    },
    {
      "t": "2026-11-08T00:01:00Z",
      "text": "Al Jazeera headlined it: “Russian strikes on Ukraine leave hundreds of thousands without electricity”",
      "cites": [
        "news:aljazeera:0305d66ded68"
      ]
    },
    {
      "t": "2026-11-08T00:01:08Z",
      "text": "France 24 headlined it: “Ukraine: Russian strikes leave hundreds of thousands without power”",
      "cites": [
        "news:france24:c719f8373e32"
      ]
    },
    {
