  "beats": [
    {
      "t": "2026-11-07T00:00:00Z",
      "text": "Israeli president Isaac Herzog selects Yashar party leader Gadi Eisenkot to attempt to form a coalition government following inconclusive Knesset elections.",
      "cites": [
        "wiki:2026-11-07:7"
      ]
    },
    {
      "t": "2026-11-07T00:00:08Z",
      "text": "On 8 November, Herzog officially presented the mandate to Eisenkot and tasked him to form a new government.",
      "cites": [
        "wiki:rev:1384575050:118"
      ]
    },
    {
      "t": "2026-11-07T00:00:16Z",
      "text": "Legislative elections were held in Israel on 27 October 2026 to elect the 120 members of the 26th Knesset and determine the governing coalition that succeeds the 37th government led by Prime Minister Benjamin Netanyahu.",
      "cites": [
        "wiki:rev:1384575050:0"
      ]
    },
    {
      "t": "2026-11-07T00:00:24Z",
      "text": "Likud, led by Benjamin Netanyahu, won the most seats: 27, short of the 61 needed for a majority.",
      "cites": [
        "elex:2026-israeli-legislative-election:party1",
        "elex:2026-israeli-legislative-election:summary"
      ]
    },
    {
      "t": "2026-11-07T00:00:31Z",
      "text": "Turnout: 77.98%.",
      "cites": [
        "elex:2026-israeli-legislative-election:summary"
      ]
    },
    {
      "t": "2026-11-07T00:00:38Z",
      "text": "Reported by ABC News Australia and AFP via The Korea Herald.",
      "cites": [
        "wiki:2026-11-07:7"
      ]
    },
    {
      "t": "2026-11-07T00:00:46Z",
      "text": "DW headlined it: “Israeli president tasks Gadi Eisenkot with forming government”",
      "cites": [
        "news:dw:1dfc2b75eb80"
      ]
    },
    {
      "t": "2026-11-07T00:00:53Z",
      "text": "BBC News headlined it: “Israel's president tasks opposition leader Eisenkot with forming government”",
      "cites": [
        "news:bbc:0fd700b21f78"
      ]
    },
    {
      "t": "2026-11-07T00:01:00Z",
      "text": "NPR headlined it: “Israel's president taps opposition candidate, not Netanyahu, to form a government”",
      "cites": [
        "news:npr:193d985bb4f1"
      ]
    },
