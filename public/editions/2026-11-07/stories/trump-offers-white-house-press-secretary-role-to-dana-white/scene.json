        "wd:Q660297:P19"
      ]
    },
    {
      "t": "2026-11-07T00:00:32Z",
      "text": "Educated at Hermon High School and University of Massachusetts Boston.",
      "cites": [
        "wd:Q660297:P69:Q5742018",
        "wd:Q660297:P69:Q15144"
      ]
    },
    {
      "t": "2026-11-07T00:00:42Z",
      "text": "DW headlined it: “Trump offers White House press secretary role to Dana White”",
