      ]
    },
    {
      "t": "2026-11-07T00:00:12Z",
      "text": "On 7 November 2026, around 15:00 CET, a black Subaru hatchback with an Ostrowiec Świętokrzyski license plate drove into the Main Square in Kraków.",
      "cites": [
        "wiki:rev:1384611689:5"
      ]
    },
