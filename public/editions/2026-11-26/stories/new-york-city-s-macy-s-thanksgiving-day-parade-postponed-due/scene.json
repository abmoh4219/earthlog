  "beats": [
    {
      "t": "2026-11-26T00:00:01Z",
      "text": "Storms pushed Macy's Thanksgiving Day Parade in New York City to Saturday, according to Al Jazeera.",
      "cites": [
        "news:aljazeera:b414d140eab3"
      ]
    },
    {
      "t": "2026-11-26T00:00:08Z",
      "text": "Macy's postponed the parade for the first time in its history, moving it from Thanksgiving Day, November 26, to the following Saturday morning, November 28, 2026.",
      "cites": [
        "wiki:rev:1388191775:67"
      ]
    },
    {
      "t": "2026-11-26T00:00:15Z",
      "text": "The parade is an annual event in New York City, usually held on Thanksgiving Day.",
      "cites": [
        "wiki:rev:1388191775:0"
      ]
    },
    {
      "t": "2026-11-26T00:00:25Z",
      "text": "Dick Schneider (1972–1993) and Gary Halvorson (1994; 1996–2014) directed the parade, with music by Sammy Fidler (1958–1965) and Milton DeLugg (1966–2013).",
      "cites": [
        "wiki:box:1388191775:directed-by",
        "wiki:box:1388191775:music"
      ]
    },
    {
      "t": "2026-11-26T00:00:33Z",
      "text": "It airs on NBC, hosted by Savannah Guthrie, Hoda Kotb and Al Roker.",
      "cites": [
        "wiki:box:1388191775:network",
        "wiki:box:1388191775:hosts"
      ]
    },
    {
      "t": "2026-11-26T00:00:43Z",
      "text": "Of the people credited, 4 have a birthplace on record, and 3 were born in the United States.",
      "cites": [
        "wd:Q2227969:P19",
        "wd:Q3240869:P19",
        "wd:Q336605:P19",
        "wd:Q5875916:P19"
      ]
    },
    {
      "t": "2026-11-26T00:00:51Z",
      "text": "Savannah Guthrie was born further afield, in Melbourne, Australia.",
      "cites": [
        "wd:Q2227969:P19"
      ]
    },
    {
      "t": "2026-11-26T00:01:10Z",
      "text": "Al Jazeera headlined the story: “Storms push Macy’s Thanksgiving Day Parade in New York City to Saturday”.",
      "cites": [
        "news:aljazeera:b414d140eab3"
      ]
    },
    {
      "t": "2026-11-26T00:01:16Z",
      "text": "France 24 headlined it: “Powerful US storm forces historic postponement of New York's Thanksgiving Day Parade”.",
      "cites": [
        "news:france24:c61a463d7d7e"
      ]
    },
    {
      "t": "2026-11-26T00:01:22Z",
      "text": "BBC News headlined it: “Macy's postpones Thanksgiving parade due to severe weather”.",
      "cites": [
        "news:bbc:baf26c4be0d1"
