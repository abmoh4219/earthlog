  "beats": [
    {
      "t": "2026-11-26T00:00:01Z",
      "text": "Spanish economist Pablo Hernández de Cos has been elected as the new president of the European Central Bank, succeeding French lawyer Christine Lagarde after her resignation.",
      "cites": [
        "wiki:2026-11-26:5"
      ]
    },
    {
      "t": "2026-11-26T00:00:11Z",
      "text": "The decision came from the European Central Bank, a central bank that belongs to the institutions of the European Union.",
      "cites": [
        "wd:Q8901:P159",
        "wiki:2026-11-26:5"
      ]
    },
    {
      "t": "2026-11-26T00:00:19Z",
      "text": "Inflation in Spain was 2.7% in 2025, down from 8.4% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:ES"
      ]
    },
    {
      "t": "2026-11-26T00:00:27Z",
      "text": "The economy grew 2.8% in 2025, and unemployment stood at 10.4%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:ES",
        "wb:SL.UEM.TOTL.ZS:ES"
      ]
    },
    {
      "t": "2026-11-26T00:00:37Z",
      "text": "Across Europe & Central Asia, Spain's 2.7% compares with a median of 3.8%, and the highest figure is Turkey at 34.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:europe-central-asia"
      ]
    },
    {
      "t": "2026-11-26T00:00:51Z",
      "text": "The story is reported by Financial Times.",
      "cites": [
        "wiki:2026-11-26:5"
      ]
    },
    {
      "t": "2026-11-26T00:00:59Z",
      "text": "France 24 ran the headline “Spanish economist de Cos to succeed Lagarde as head of ECB”.",
      "cites": [
        "news:france24:8f2ca94f4b4a"
      ]
    },
    {
      "t": "2026-11-26T00:01:05Z",
      "text": "Al Jazeera's headline read “Spanish economist to become new European Central Bank chief”.",
      "cites": [
        "news:aljazeera:867be56d20a5"
      ]
    },
    {
      "t": "2026-11-26T00:01:11Z",
      "text": "The Guardian headlined it “Spain’s Pablo Hernández de Cos wins race to be next ECB president”.",
      "cites": [
        "news:guardian:005248df97fe"
      ]
    },
    {
      "t": "2026-11-26T00:01:20Z",
