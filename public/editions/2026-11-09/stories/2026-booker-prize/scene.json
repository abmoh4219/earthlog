  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "English author M. John Harrison has won the 2026 Booker Prize for his post-apocalyptic novel The End of Everything.",
      "cites": [
        "wiki:2026-11-09:3"
      ]
    },
    {
      "t": "2026-11-09T00:00:08Z",
      "text": "The winner was announced on 9 November 2026 at Old Billingsgate in the City of London, and at 81 Harrison is the oldest winner, as well as the first science fiction writer to receive the prize.",
      "cites": [
        "wiki:rev:1385064068:3"
      ]
    },
    {
      "t": "2026-11-09T00:00:15Z",
      "text": "The prize is worth £50,000 and is given for the best English-language novel published between 1 October 2025 and 30 September 2026 in the United Kingdom or Ireland.",
      "cites": [
        "wiki:rev:1385064068:0"
      ]
    },
    {
      "t": "2026-11-09T00:00:25Z",
      "text": "The story is reported by The Guardian.",
      "cites": [
        "wiki:2026-11-09:3"
      ]
    },
    {
      "t": "2026-11-09T00:00:33Z",
