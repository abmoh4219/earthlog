  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "Tommy Walsh died on 9 November 2026, aged 69, after a long illness, according to Wikipedia.",
      "cites": [
        "wiki:rev:1385021977:22"
      ]
    },
    {
      "t": "2026-11-09T00:00:08Z",
      "text": "He was educated at Parmiter's School, then a grammar school, in Bethnal Green, and later became a builder.",
      "cites": [
        "wiki:rev:1385021977:2"
      ]
    },
    {
      "t": "2026-11-09T00:00:15Z",
      "text": "Thomas Walsh, born 18 December 1956 and died 9 November 2026, was an English television personality, presenter and builder best known for the gardening and do-it-yourself shows Ground Force (1997–2005)…",
      "cites": [
        "wiki:rev:1385021977:0"
      ]
    },
    {
      "t": "2026-11-09T00:00:25Z",
      "text": "Tommy Walsh was born on 18 December 1956 in South Hackney.",
      "cites": [
        "wd:Q7819982:P569",
        "wd:Q7819982:P19"
      ]
    },
    {
      "t": "2026-11-09T00:00:33Z",
      "text": "Wikidata gives South Hackney as his birthplace.",
      "cites": [
        "wd:Q7819982:P19"
      ]
    },
    {
      "t": "2026-11-09T00:00:34Z",
      "text": "Wikidata also records that he was educated at Parmiter's School.",
      "cites": [
        "wd:Q7819982:P69:Q7139213"
      ]
    },
    {
      "t": "2026-11-09T00:00:35Z",
      "text": "He is also recorded as having lived in South Hackney.",
      "cites": [
        "wd:Q7819982:P551:Q7567400"
      ]
    },
    {
