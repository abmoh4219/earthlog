  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "English actor Russell Brand was sentenced to 10 years and 6 months' imprisonment for one rape and three counts of sexual assault.",
      "cites": [
        "wiki:2026-11-09:11"
      ]
    },
    {
      "t": "2026-11-09T00:00:08Z",
      "text": "The sentence was handed down on 9 November: nine years for rape, with terms of 18 months, nine months and eight months for the three sexual assault offences, according to the article's quoted revision.",
      "cites": [
        "wiki:rev:1385345014:333"
      ]
    },
    {
      "t": "2026-11-09T00:00:15Z",
      "text": "Russell Edward Brand, born 4 June 1975, is an English comedian, actor and media personality.",
      "cites": [
        "wiki:rev:1385345014:0"
      ]
    },
    {
      "t": "2026-11-09T00:00:25Z",
      "text": "Brand was born on 4 June 1975 in Grays.",
      "cites": [
        "wd:Q296609:P569",
        "wd:Q296609:P19"
      ]
    },
    {
      "t": "2026-11-09T00:00:33Z",
      "text": "He was educated at the Italia Conti Academy of Theatre Arts, Drama Centre London, The Hathaway Academy and the Royal Academy of Dramatic Art.",
      "cites": [
        "wd:Q296609:P69:Q348134",
        "wd:Q296609:P69:Q1255631",
        "wd:Q296609:P69:Q5598377",
        "wd:Q296609:P69:Q523926"
      ]
    },
    {
      "t": "2026-11-09T00:00:46Z",
      "text": "One award is on record for Brand: the James Joyce Awards.",
      "cites": [
        "wd:Q296609:P166:Q3806623"
      ]
    },
    {
      "t": "2026-11-09T00:00:56Z",
      "text": "Readers also turned to Katy Perry (97,984), Kirsty Gallacher (81,740) and Jemima Goldsmith (58,883).",
      "cites": [
        "views:en:Katy_Perry:2026-11-09",
        "views:en:Kirsty_Gallacher:2026-11-09",
        "views:en:Jemima_Goldsmith:2026-11-09"
      ]
    },
    {
      "t": "2026-11-09T00:01:05Z",
      "text": "On 9 November 2026, 1,010,049 people read the English Wikipedia article, about 239 times the usual daily level.",
      "cites": [
        "views:en:Russell_Brand:2026-11-09",
        "views:en:Russell_Brand:prior"
      ]
    },
    {
      "t": "2026-11-09T00:01:12Z",
      "text": "The article was read in 11 languages, and after English, the most readers were in German, with 104,556.",
      "cites": [
        "views:en:Russell_Brand:2026-11-09",
        "views:de:Russell_Brand:2026-11-09"
      ]
    },
    {
      "t": "2026-11-09T00:01:19Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:de:Russell_Brand:2026-11-09",
        "views:es:Russell_Brand:2026-11-09",
        "views:fr:Russell_Brand:2026-11-09",
        "views:it:Russell_Brand:2026-11-09",
        "views:ru:Брэнд,_Рассел:2026-11-09",
        "views:pl:Russell_Brand:2026-11-09"
      ]
    },
    {
      "t": "2026-11-09T00:01:29Z",
      "text": "The sentencing was reported by CNN and RTÉ News.",
      "cites": [
        "wiki:2026-11-09:11"
      ]
    },
    {
      "t": "2026-11-09T00:01:37Z",
      "text": "The sources are Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and every caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-09:11",
        "wiki:rev:1385345014:333",
