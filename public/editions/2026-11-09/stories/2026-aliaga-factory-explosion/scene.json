  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "Seventeen people are killed and twelve others are injured in an explosion at a factory in Aliağa, Turkey.",
      "cites": [
        "wiki:2026-11-09:8"
      ]
    },
    {
      "t": "2026-11-09T00:00:08Z",
      "text": "On 9 November 2026, an explosion and fire at the HABAŞ Demir Çelik iron and steel plant in Aliağa, in Turkey's İzmir Province, killed 18 workers and injured at least 12 others.",
      "cites": [
        "wiki:rev:1385224407:0"
      ]
    },
    {
      "t": "2026-11-09T00:00:15Z",
      "text": "Hakan Doğan, 55, a subcontractor, died on 21 October 2026 after a fall of about 8 m from a ladder, and Eyüp Eğinli died on 5 November 2026 when a heavy vehicle tyre exploded during inflation.",
      "cites": [
        "wiki:rev:1385224407:21"
      ]
    },
    {
      "t": "2026-11-09T00:00:25Z",
      "text": "The article gives a preliminary finding that an overhead crane collapsed into an electric arc furnace during casting at the HABAŞ Demir Çelik plant.",
      "cites": [
        "wiki:box:1385224407:summary",
        "wiki:box:1385224407:coordinates"
      ]
    },
    {
      "t": "2026-11-09T00:00:34Z",
      "text": "The article records 18 deaths.",
      "cites": [
        "wiki:box:1385224407:fatalities"
      ]
    },
    {
      "t": "2026-11-09T00:00:45Z",
      "text": "Erdoğan promised that \"how and why it happened, whether there was any negligence and who bears responsibility\" would be established.",
      "cites": [
        "wiki:investigation:1385224407:0"
      ]
    },
    {
      "t": "2026-11-09T00:00:52Z",
      "text": "Five people were initially detained in connection with the blast, with the number rising to six by the evening of 9 November.",
      "cites": [
        "wiki:investigation:1385224407:1"
      ]
    },
    {
      "t": "2026-11-09T00:00:59Z",
      "text": "On 10 November, HABAŞ Chairman Mehmet Rüştü Başaran was arrested in Istanbul, and ten others were still wanted.",
      "cites": [
        "wiki:investigation:1385224407:2"
      ]
    },
    {
      "t": "2026-11-09T00:01:07Z",
      "text": "The report comes from BBC News.",
      "cites": [
        "wiki:2026-11-09:8"
      ]
    },
    {
      "t": "2026-11-09T00:01:15Z",
      "text": "The sources are Wikipedia, Current events, Wikipedia articles and Wikidata, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-09:8",
        "wiki:rev:1385224407:21",
        "wd:Q142108639:P31"
      ]
    }
  ],
