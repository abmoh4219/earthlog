  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "The Pitt Rivers Museum in Oxford, England, is returning the remains of 39 Naga people, collected during the British Raj, to a delegation from Nagaland, India, after six years of discussions over repatriation.",
      "cites": [
        "wiki:2026-11-09:4"
      ]
    },
    {
      "t": "2026-11-09T00:00:11Z",
      "text": "The museum is in Oxford, in the United Kingdom, and the reports place it there.",
      "cites": [
        "wiki:2026-11-09:4"
      ]
    },
    {
      "t": "2026-11-09T00:00:19Z",
      "text": "Nagaland, the Indian state receiving the remains, is also named in the reports.",
      "cites": [
        "wiki:2026-11-09:4"
      ]
    },
    {
      "t": "2026-11-09T00:00:28Z",
      "text": "The story was reported by AFP and carried by France 24.",
      "cites": [
        "wiki:2026-11-09:4"
      ]
    },
    {
      "t": "2026-11-09T00:00:36Z",
      "text": "The sources are Wikipedia's current events page, and each caption links to the evidence it rests on.",
