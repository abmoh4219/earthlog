  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "The South Korean Fair Trade Commission has fined Woowa Brothers ₩331.1 billion (US$247 million) and Coupang ₩300.8 billion ($222 million).",
      "cites": [
        "wiki:2026-11-09:7"
      ]
    },
    {
      "t": "2026-11-09T00:00:05Z",
      "text": "It found that both food-delivery platforms restricted competition by requiring restaurants to match rival platforms' terms.",
      "cites": [
        "wiki:2026-11-09:7"
      ]
    },
    {
      "t": "2026-11-09T00:00:11Z",
      "text": "The regulator behind the decision is the Korea Fair Trade Commission, a competition body headquartered in Sejong.",
      "cites": [
        "wd:Q624479:P159",
        "wiki:2026-11-09:7"
      ]
    },
    {
      "t": "2026-11-09T00:00:19Z",
      "text": "Inflation in South Korea was 2.1% in 2025, down from 5.1% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:KR"
      ]
    },
    {
      "t": "2026-11-09T00:00:27Z",
      "text": "The economy grew 1.0% in 2025, and unemployment stood at 2.7%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:KR",
        "wb:SL.UEM.TOTL.ZS:KR"
      ]
    },
    {
      "t": "2026-11-09T00:00:37Z",
      "text": "Across East Asia & Pacific, South Korea's 2.1% inflation sits at the regional median of 2.1%, while Mongolia has the highest rate at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-09T00:00:51Z",
      "text": "The story was reported by AFP and carried via France 24.",
      "cites": [
        "wiki:2026-11-09:7"
      ]
    },
    {
      "t": "2026-11-09T00:00:59Z",
      "text": "Sources include Wikipedia's Current events, Wikidata and World Bank Open Data (World Development Indicators), and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-09:7",
        "wd:Q624479:P159",
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    }
