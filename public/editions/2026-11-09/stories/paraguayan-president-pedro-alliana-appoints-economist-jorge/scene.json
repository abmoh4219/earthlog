  "beats": [
    {
      "t": "2026-11-09T00:00:01Z",
      "text": "Paraguayan president Pedro Alliana appoints economist Jorge Schreiner to lead the central bank following Ueno Bank's collapse, and the Senate approves the appointment.",
      "cites": [
        "wiki:2026-11-09:5"
      ]
    },
    {
      "t": "2026-11-09T00:00:08Z",
      "text": "On 9 November, Alliana nominated Schreiner to lead the central bank, pending congressional approval.",
      "cites": [
        "wiki:rev:1385331860:72"
      ]
    },
    {
      "t": "2026-11-09T00:00:15Z",
      "text": "The 2026 Paraguay banking crisis is an ongoing financial and political crisis, triggered by regulatory intervention and shutdown of Ueno Bank, the country's largest digital institution.",
      "cites": [
        "wiki:rev:1385331860:0"
      ]
    },
    {
      "t": "2026-11-09T00:00:25Z",
      "text": "The appointment concerns the Central Bank of Paraguay, which is headquartered in Asunción.",
      "cites": [
        "wd:Q4504275:P159",
        "wiki:2026-11-09:5"
      ]
    },
    {
      "t": "2026-11-09T00:00:33Z",
      "text": "Inflation in Paraguay eased to 4.0% in 2025, down from 9.8% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:PY"
      ]
    },
    {
      "t": "2026-11-09T00:00:41Z",
      "text": "Paraguay's economy grew 6.6% in 2025, and unemployment stood at 4.8%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:PY",
        "wb:SL.UEM.TOTL.ZS:PY"
      ]
    },
    {
      "t": "2026-11-09T00:00:51Z",
      "text": "Among Latin America and Caribbean countries, Paraguay's 4.0% inflation compares with a median of 3.8%, while Argentina's 219.9% is the highest.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:latin-america-caribbean"
      ]
    },
    {
      "t": "2026-11-09T00:01:05Z",
      "text": "On 5 November, president Santiago Peña announced his resignation after Ueno Bank collapsed, and the Chamber of Deputies unanimously voted to start impeachment proceedings against him.",
      "cites": [
        "wiki:2026-11-05:11"
      ]
    },
    {
      "t": "2026-11-09T00:01:12Z",
      "text": "On 6 November, the Senate unanimously removed Peña as president over alleged conflicts of interest involving Ueno Bank, whose accounts the central bank had frozen.",
      "cites": [
        "wiki:2026-11-06:13"
      ]
    },
    {
      "t": "2026-11-09T00:01:21Z",
      "text": "The business report on this story is attributed to Reuters.",
      "cites": [
        "wiki:2026-11-09:5"
      ]
    },
    {
      "t": "2026-11-09T00:01:29Z",
      "text": "Sources include Wikipedia's current events pages, such as Portal:Current events/2026 November 5, along with Wikipedia articles, Wikimedia pageviews, and Wikidata.",
      "cites": [
        "wiki:2026-11-09:5",
        "wiki:rev:1385331860:72",
        "views:en:2026_Paraguay_banking_crisis:30d",
        "wd:Q142059724:P31",
        "wiki:2026-11-05:11"
      ]
    },
    {
      "t": "2026-11-09T00:01:30Z",
