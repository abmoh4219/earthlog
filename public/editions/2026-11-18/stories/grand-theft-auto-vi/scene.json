  "beats": [
    {
      "t": "2026-11-18T00:00:01Z",
      "text": "PlayStation reported a major outage ahead of the release of Grand Theft Auto VI.",
      "cites": [
        "wiki:2026-11-18:13"
      ]
    },
    {
      "t": "2026-11-18T00:00:08Z",
      "text": "Rockstar later collaborated with the NBA team Miami Heat for A Night in Vice City, a one night event where the Heat played as \"Vice City\" against the Milwaukee Bucks on 18 November, a day before the game's release.",
      "cites": [
        "wiki:rev:1386583362:144"
      ]
    },
    {
      "t": "2026-11-18T00:00:15Z",
      "text": "Grand Theft Auto VI is an action-adventure game developed and published by Rockstar Games.",
      "cites": [
        "wiki:rev:1386583362:0"
      ]
    },
    {
      "t": "2026-11-18T00:00:25Z",
      "text": "The game was released on 19 November 2026.",
      "cites": [
        "wiki:box:1386583362:released"
      ]
    },
    {
      "t": "2026-11-18T00:00:37Z",
      "text": "Readers also turned to Grand Theft Auto (110,668), Grand Theft Auto V (81,349) and Rockstar Games (79,323).",
      "cites": [
        "views:en:Grand_Theft_Auto:2026-11-18",
        "views:en:Grand_Theft_Auto_V:2026-11-18",
        "views:en:Rockstar_Games:2026-11-18"
      ]
    },
    {
      "t": "2026-11-18T00:00:46Z",
      "text": "English Wikipedia recorded 519,632 readers of the article on 18 November 2026, about 34 times the usual daily figure of 15,460.",
      "cites": [
        "views:en:Grand_Theft_Auto_VI:2026-11-18",
        "views:en:Grand_Theft_Auto_VI:prior"
      ]
    },
    {
      "t": "2026-11-18T00:00:53Z",
      "text": "The article was read in 11 languages, and after English, the most readers were in Russian, with 55,025.",
      "cites": [
        "views:en:Grand_Theft_Auto_VI:2026-11-18",
        "views:ru:Grand_Theft_Auto_VI:2026-11-18"
      ]
    },
    {
      "t": "2026-11-18T00:01:00Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:ru:Grand_Theft_Auto_VI:2026-11-18",
        "views:de:Grand_Theft_Auto_VI:2026-11-18",
        "views:fr:Grand_Theft_Auto_VI:2026-11-18",
        "views:es:Grand_Theft_Auto_VI:2026-11-18",
        "views:it:Grand_Theft_Auto_VI:2026-11-18",
        "views:zh:俠盜獵車手VI:2026-11-18"
      ]
    },
    {
      "t": "2026-11-18T00:01:10Z",
      "text": "The outage report was published by Axios.",
      "cites": [
        "wiki:2026-11-18:13"
      ]
    },
    {
      "t": "2026-11-18T00:01:18Z",
      "text": "DW headlined its coverage with the question, What makes 'Grand Theft Auto VI' more than just a game?",
      "cites": [
        "news:dw:24b2767125c4"
      ]
    },
    {
      "t": "2026-11-18T00:01:25Z",
      "text": "BBC News headlined its coverage, Grand Theft Auto 6 is a masterpiece, say critics.",
      "cites": [
        "news:bbc:cdc6a802f0fa"
      ]
    },
    {
      "t": "2026-11-18T00:01:34Z",
      "text": "Sources include Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and each caption links to the evidence it rests on.",
