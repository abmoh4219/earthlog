    {
      "t": "2026-11-18T00:00:01Z",
      "text": "According to BBC News, Waymo is pulling its driverless taxis from all US freeways.",
      "cites": [
        "news:bbc:2dfd1d8d61a7"
      ]
    },
    {
      "t": "2026-11-18T00:00:08Z",
      "text": "In October 2026, Waymo expanded its service area in San Diego to include La Jolla.",
      "cites": [
        "wiki:rev:1386509662:108"
      ]
    },
    {
      "t": "2026-11-18T00:00:15Z",
      "text": "Waymo LLC is an American autonomous driving technology company headquartered in Mountain View, California.",
      "cites": [
        "wiki:rev:1386509662:0"
      ]
    },
    {
      "t": "2026-11-18T00:00:25Z",
      "text": "Waymo is headquartered in Mountain View, United States.",
      "cites": [
        "wd:Q15330:P159"
      ]
    },
    {
      "t": "2026-11-18T00:00:33Z",
      "text": "Waymo was founded in 2016 by Sebastian Thrun and Anthony Levandowski, and is led by Tekedra Mawakana.",
      "cites": [
        "wd:Q15330:P571",
        "wd:Q15330:P112",
        "wd:Q15330:P169"
      ]
    },
    {
      "t": "2026-11-18T00:00:43Z",
      "text": "Hacker News recorded 10 stories with Waymo in the title in the two weeks to 18 November 2026.",
      "cites": [
        "hn:2026-11-18:Q15330"
      ]
    },
    {
      "t": "2026-11-18T00:01:01Z",
      "text": "BBC News headlined the story: “Waymo pulls driverless taxis from all US freeways”.",
      "cites": [
        "news:bbc:2dfd1d8d61a7"
      ]
    },
    {
      "t": "2026-11-18T00:01:08Z",
      "text": "The Guardian headlined it: “Waymo pulls driverless taxis from freeways across the US after California ban”.",
      "cites": [
        "news:guardian:10e302fb34c3"
      ]
    },
