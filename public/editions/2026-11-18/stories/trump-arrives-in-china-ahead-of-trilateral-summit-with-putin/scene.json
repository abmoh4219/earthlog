  "beats": [
    {
      "t": "2026-11-18T00:00:01Z",
      "text": "Al Jazeera reports on why China's Shenzhen was chosen to host the APEC summit.",
      "cites": [
        "news:aljazeera:412c87609aaa"
      ]
    },
    {
      "t": "2026-11-18T00:00:08Z",
      "text": "APEC China 2026 is a year-long hosting of the Asia-Pacific Economic Cooperation meetings, concluding with the APEC Economic Leaders' Meeting in November 2026.",
      "cites": [
        "wiki:rev:1386579272:0"
      ]
    },
    {
      "t": "2026-11-18T00:00:15Z",
      "text": "On December 12, 2025, Guo Jiakun, spokesperson for China's Ministry of Foreign Affairs, announced at a regular press conference that the leaders' meeting is scheduled to be held in Shenzhen.",
      "cites": [
        "wiki:rev:1386579272:9"
      ]
    },
    {
      "t": "2026-11-18T00:00:25Z",
      "text": "Inflation in China was 0.1% in 2025, down from 2.4% in 2020.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:CN"
      ]
    },
    {
      "t": "2026-11-18T00:00:33Z",
      "text": "The economy grew 5.0% in 2025, and unemployment stood at 4.6%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:CN",
        "wb:SL.UEM.TOTL.ZS:CN"
      ]
    },
    {
      "t": "2026-11-18T00:00:43Z",
      "text": "Across East Asia and the Pacific, China's 0.1% inflation compares with a median of 2.1%, while the highest is Mongolia at 8.6%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:east-asia-pacific"
      ]
    },
    {
      "t": "2026-11-18T00:00:57Z",
      "text": "Al Jazeera headlined its report “Why China’s Shenzhen was chosen for APEC summit.”",
      "cites": [
        "news:aljazeera:412c87609aaa"
      ]
    },
    {
      "t": "2026-11-18T00:01:03Z",
      "text": "DW headlined its story “APEC summit: What Trump, Xi and Putin want.”",
      "cites": [
        "news:dw:5ebb76396afb"
      ]
    },
    {
      "t": "2026-11-18T00:01:09Z",
      "text": "France 24 headlined its coverage “Trump arrives in China ahead of historic three-way summit with Putin, Xi.”",
      "cites": [
        "news:france24:5673e42f38dc"
      ]
    },
    {
      "t": "2026-11-18T00:01:18Z",
      "text": "The sources are Al Jazeera, DW and France 24, Wikipedia articles, Wikimedia pageviews, Wikidata and World Bank Open Data, and each caption links to the evidence it rests on.",
