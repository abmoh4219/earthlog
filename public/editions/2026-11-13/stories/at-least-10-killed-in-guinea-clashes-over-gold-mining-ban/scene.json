  "beats": [
    {
      "t": "2026-11-13T00:00:01Z",
      "text": "At least 10 people were killed in clashes in Guinea over a gold mining ban, according to Al Jazeera.",
      "cites": [
        "news:aljazeera:5bc7d4c5388b"
      ]
    },
    {
      "t": "2026-11-13T00:00:09Z",
      "text": "France 24 also reported on the story.",
      "cites": [
        "news:france24:3d42129ab965"
      ]
    },
    {
      "t": "2026-11-13T00:00:18Z",
      "text": "Inflation in Guinea fell to 3.6% in 2025, down from 12.6% in 2021.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:GN"
      ]
    },
    {
      "t": "2026-11-13T00:00:26Z",
      "text": "The economy grew 7.4% in 2025, and unemployment stood at 5.2%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:GN",
        "wb:SL.UEM.TOTL.ZS:GN"
      ]
    },
    {
      "t": "2026-11-13T00:00:36Z",
      "text": "Across Sub-Saharan Africa, Guinea's 3.6% compares with a median of 3.5%, while the highest is South Sudan at 91.4%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:sub-saharan-africa"
      ]
    },
    {
      "t": "2026-11-13T00:00:50Z",
      "text": "Guinea, officially the Republic of Guinea, is a coastal country located in West Africa.",
      "cites": [
        "wiki:rev:1384981775:0"
      ]
    },
    {
      "t": "2026-11-13T00:01:01Z",
      "text": "France 24 headlined its report, \"Guinea opens illegal gold mining trial, 1,200 people arrested.\"",
      "cites": [
        "news:france24:3d42129ab965"
      ]
    },
    {
      "t": "2026-11-13T00:01:08Z",
      "text": "Al Jazeera headlined its report, \"At least 10 killed in Guinea clashes over gold mining ban.\"",
      "cites": [
        "news:aljazeera:5bc7d4c5388b"
      ]
    },
