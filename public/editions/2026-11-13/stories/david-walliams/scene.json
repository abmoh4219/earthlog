  "beats": [
    {
      "t": "2026-11-13T00:00:01Z",
      "text": "The Metropolitan Police in the United Kingdom have announced a criminal investigation into actor David Walliams over \"alleged serious sexual offences\".",
      "cites": [
        "wiki:2026-11-13:9",
        "wiki:rev:1385873065:193"
      ]
    },
    {
      "t": "2026-11-13T00:00:08Z",
      "text": "The announcement was made on 13 November 2026, and the police say the probe is separate to those investigated by ITN and The Guardian.",
      "cites": [
        "wiki:rev:1385873065:193",
        "wiki:2026-11-13:9"
      ]
    },
    {
      "t": "2026-11-13T00:00:15Z",
      "text": "Walliams, born David Edward Williams on 20 August 1971, is an English actor, comedian, writer and television personality.",
      "cites": [
        "wiki:rev:1385873065:0"
      ]
    },
    {
      "t": "2026-11-13T00:00:25Z",
      "text": "Walliams was born on 20 August 1971 in Wimbledon.",
      "cites": [
        "wd:Q359665:P569",
        "wd:Q359665:P19"
      ]
    },
    {
      "t": "2026-11-13T00:00:33Z",
      "text": "He was educated at the University of Bristol, Reigate Grammar School and Manor Hall, Bristol.",
      "cites": [
        "wd:Q359665:P69:Q459506",
        "wd:Q359665:P69:Q7310077",
        "wd:Q359665:P69:Q6751333"
      ]
    },
    {
      "t": "2026-11-13T00:00:43Z",
      "text": "The one award on record is Officer of the Order of the British Empire, received in 2017.",
      "cites": [
        "wd:Q359665:P166:Q10762848"
      ]
    },
    {
      "t": "2026-11-13T00:00:53Z",
      "text": "Wimbledon is also named in the reports.",
      "cites": [
        "wiki:2026-11-13:9"
      ]
    },
    {
      "t": "2026-11-13T00:01:02Z",
      "text": "The English Wikipedia article was read by 97,674 people on 13 November 2026, about 37 times the usual level.",
      "cites": [
        "views:en:David_Walliams:2026-11-13",
        "views:en:David_Walliams:prior"
      ]
    },
    {
      "t": "2026-11-13T00:01:09Z",
      "text": "The article is available in 11 languages, and after English, German has the most readers with 6,515.",
      "cites": [
        "views:en:David_Walliams:2026-11-13",
        "views:de:David_Walliams:2026-11-13"
      ]
    },
    {
      "t": "2026-11-13T00:01:16Z",
      "text": "Each language glows where it is mainly spoken, brighter for more readers, and a language is not a country.",
      "cites": [
        "views:de:David_Walliams:2026-11-13",
        "views:fr:David_Walliams:2026-11-13",
        "views:es:David_Walliams:2026-11-13",
        "views:ja:デヴィッド・ウォリアムス:2026-11-13",
        "views:pl:David_Walliams:2026-11-13",
        "views:it:David_Walliams:2026-11-13"
      ]
    },
    {
      "t": "2026-11-13T00:01:26Z",
      "text": "The story was reported by AP and BBC News.",
      "cites": [
        "wiki:2026-11-13:9"
      ]
    },
    {
      "t": "2026-11-13T00:01:34Z",
      "text": "The Guardian headlined it: \"Met police launch investigation into David Walliams allegations\".",
      "cites": [
        "news:guardian:72dc6a881824"
      ]
    },
    {
      "t": "2026-11-13T00:01:40Z",
      "text": "DW headlined it: \"David Walliams: UK police launch sex offense probe into comedian\".",
      "cites": [
        "news:dw:cffd271a388c"
      ]
    },
    {
      "t": "2026-11-13T00:01:46Z",
      "text": "France 24 headlined it: \"UK rocked by comedians' sex scandals\".",
      "cites": [
        "news:france24:23c096cd618a"
      ]
    },
    {
      "t": "2026-11-13T00:01:55Z",
      "text": "Sources include Wikipedia, Current events, Wikipedia articles, Wikimedia pageviews and Wikidata, and every caption links to the evidence it rests on.",
      "cites": [
        "wiki:2026-11-13:9",
        "wiki:rev:1385873065:193",
        "views:en:David_Walliams:2026-11-13",
        "wd:Q359665:P31"
      ]
    }
