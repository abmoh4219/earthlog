  "beats": [
    {
      "t": "2026-11-13T00:00:01Z",
      "text": "Peruvians are turning out to see Pope Leo XIV in the city where he once served as bishop, according to France 24.",
      "cites": [
        "news:france24:3753f8041ccf"
      ]
    },
    {
      "t": "2026-11-13T00:00:09Z",
      "text": "BBC News and Al Jazeera also covered the visit, describing a city that has embraced the pope and a warm return.",
      "cites": [
        "news:bbc:841377b7806a",
        "news:aljazeera:0cc82106b9ee"
      ]
    },
    {
      "t": "2026-11-13T00:00:18Z",
      "text": "Inflation in Peru fell to 1.5% in 2025, from 8.3% in 2022.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:PE"
      ]
    },
    {
      "t": "2026-11-13T00:00:26Z",
      "text": "The economy grew 3.4% in 2025, and unemployment stood at 5.1%.",
      "cites": [
        "wb:NY.GDP.MKTP.KD.ZG:PE",
        "wb:SL.UEM.TOTL.ZS:PE"
      ]
    },
    {
      "t": "2026-11-13T00:00:36Z",
      "text": "Across Latin America and the Caribbean, Peru's 1.5% compares with a median of 3.8%, while the highest is Argentina at 219.9%.",
      "cites": [
        "wb:FP.CPI.TOTL.ZG:region:latin-america-caribbean"
      ]
    },
    {
      "t": "2026-11-13T00:00:50Z",
      "text": "Peru, officially the Republic of Peru, is a country in western South America.",
      "cites": [
        "wiki:rev:1385814421:0"
      ]
    },
    {
      "t": "2026-11-13T00:01:01Z",
      "text": "France 24 headlined the story, \"Peruvians flock to see Pope Leo XIV in city he served as bishop.\"",
      "cites": [
        "news:france24:3753f8041ccf"
      ]
    },
    {
      "t": "2026-11-13T00:01:07Z",
      "text": "BBC News chose the headline, \"The Peruvian city that has embraced Pope Leo as one of its own.\"",
      "cites": [
        "news:bbc:841377b7806a"
      ]
    },
    {
      "t": "2026-11-13T00:01:13Z",
      "text": "Al Jazeera headlined its report, \"Pope Leo cheered on return to Peru city where he served as bishop.\"",
      "cites": [
        "news:aljazeera:0cc82106b9ee"
      ]
    },
    {
      "t": "2026-11-13T00:01:22Z",
      "text": "The sources are France 24, BBC News and Al Jazeera, Wikipedia articles, Wikimedia pageviews, Wikidata and World Bank Open Data, and each caption links to the evidence it rests on.",
      "cites": [
        "wiki:rev:1385814421:0",
